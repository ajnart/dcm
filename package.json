{
  "name": "dcm",
  "version": "1.0.0",
  "description": "A tool to create docker-compose.yaml files",
  "author": "ajnart",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "serve out -p 7576",
    "lint": "biome lint",
    "format": "biome format",
    "sync:selfhost": "bun scripts/sync-selfhost.ts",
    "ci": "bun test && bun lint && bun format && bun run build",
    "deploy": "next build && wrangler pages functions build --outdir=out/_worker.js && wrangler pages deploy out",
    "test:compose": "bun test tests/validate-compose.test.ts",
    "test:containers": "bun test tests/validate-all-containers.test.ts",
    "test:templates": "bun test tests/templates.test.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/server": "2.0.0-alpha.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-hover-card": "^1.1.24",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@tanstack/react-form": "^1.33.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "simple-icons": "^14.15.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "latest",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.29",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-motion": "^1.1.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.148.0"
  },
  "trustedDependencies": ["@biomejs/biome", "@parcel/watcher"],
  "packageManager": "bun@1.2.5"
}

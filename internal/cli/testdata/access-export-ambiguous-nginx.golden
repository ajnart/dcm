# self-host access export --format nginx
# Replace each example.com hostname with your own.
# Upstreams are Compose services: the proxy must join the Docker network selfhost_default.
# A proxy outside Docker uses the host address in each comment instead.
# Skipped Unmanaged app: unsupported
# No unambiguous supported HTTP upstream; configure the proxy manually.
# Add your own listen 443 ssl block and certificates.

# Chat
# host: 192.168.1.20:8080
server {
	listen 80;
	server_name chat.example.com;

	location / {
		proxy_pass http://chat:8080;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
	}
}

# Media Server
# host: 192.168.1.20:8096
server {
	listen 80;
	server_name media.example.com;

	location / {
		proxy_pass http://media:8096;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		client_max_body_size 0;
		proxy_read_timeout 3600s;
		proxy_send_timeout 3600s;
	}
}

# Notes
# host: 192.168.1.20:3000
server {
	listen 80;
	server_name notes.example.com;

	location / {
		proxy_pass http://notes:3000;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}
}

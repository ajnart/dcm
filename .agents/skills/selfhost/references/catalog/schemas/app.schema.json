{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajnart.dev/selfhost-skills/app.schema.json",
  "title": "Selfhost application record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "aliases", "categories", "roles", "upstream", "image", "lifecycle", "support", "homarr", "dependencies", "alternatives", "security", "pitfalls", "sources"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 2},
    "aliases": {"type": "array", "items": {"type": "string", "minLength": 2}, "uniqueItems": true},
    "categories": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "roles": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "repository", "docs"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "repository": {"type": ["string", "null"]},
        "docs": {"type": ["string", "null"]}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "source", "status"],
      "properties": {
        "reference": {"type": ["string", "null"]},
        "source": {"enum": ["upstream", "vendor", "community", "unknown", "not-applicable"]},
        "status": {"enum": ["known", "verify", "unknown", "not-applicable"]}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checkedAt", "note"],
      "properties": {
        "status": {"enum": ["active", "transitioning", "verify", "retired"]},
        "checkedAt": {"type": "string", "format": "date"},
        "note": {"type": "string", "minLength": 3}
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automation", "tier", "adapterSkill"],
      "properties": {
        "automation": {"enum": ["managed", "guided", "discovery", "retired"]},
        "tier": {"enum": ["T0", "T1", "T2"]},
        "adapterSkill": {"type": ["string", "null"]}
      }
    },
    "homarr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support", "integration"],
      "properties": {
        "support": {"enum": ["supported", "partial", "gap", "not-applicable"]},
        "integration": {"type": ["string", "null"]}
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "alternatives": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "security": {"type": "array", "items": {"type": "string", "minLength": 3}, "minItems": 1},
    "pitfalls": {"type": "array", "items": {"type": "string", "minLength": 3}, "minItems": 1},
    "sources": {"type": "array", "items": {"type": "string", "format": "uri"}, "minItems": 1, "uniqueItems": true}
  }
}

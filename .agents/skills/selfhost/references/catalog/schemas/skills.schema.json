{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajnart.dev/selfhost-skills/skills.schema.json",
  "title": "Selfhost skill-pack registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "skills"],
  "properties": {
    "schemaVersion": {"const": 1},
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "adapter"],
        "properties": {
          "id": {"type": "string", "pattern": "^selfhost(?:-[a-z0-9]+)*$"},
          "adapter": {"type": "boolean"}
        }
      }
    }
  }
}

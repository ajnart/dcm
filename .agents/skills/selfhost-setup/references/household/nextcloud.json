{
  "schemaVersion": 1,
  "id": "nextcloud",
  "checkedAt": "2026-09-21",
  "recipe": "nextcloud.md",
  "officialSources": [
    "https://github.com/nextcloud/docker/blob/master/README.md",
    "https://docs.nextcloud.com/server/latest/admin_manual/occ_system.html",
    "https://docs.nextcloud.com/server/latest/admin_manual/configuration_server/caching_configuration.html",
    "https://docs.nextcloud.com/server/stable/admin_manual/configuration_server/reverse_proxy_configuration.html",
    "https://docs.nextcloud.com/server/stable/admin_manual/configuration_user/authentication.html#app-passwords"
  ],
  "services": ["app", "cron", "redis", "database"],
  "initialAccount": {
    "method": "non-secret-username-and-password-secret-file",
    "fields": ["username", "password"],
    "email": "optional-no-inference"
  },
  "supportedSecretFileVariables": ["NEXTCLOUD_ADMIN_PASSWORD_FILE", "POSTGRES_PASSWORD_FILE"],
  "homarr": {
    "integration": "nextcloud",
    "credential": "username-and-app-password",
    "acceptance": ["integration-test", "authenticated-dav-query"]
  },
  "genericComposeStatus": "planned-supported-unverified",
  "genericComposeBlockers": []
}

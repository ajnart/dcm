{
  "schemaVersion": 1,
  "checkedAt": "2026-09-21",
  "id": "audiobookshelf",
  "document": "audiobookshelf.md",
  "support": "guided",
  "composeOwner": "selfhost-compose",
  "imageRepository": "ghcr.io/advplyr/audiobookshelf",
  "imagePolicy": "resolve-and-record-immutable-digest-before-apply",
  "containerPort": 80,
  "storage": [
    {
      "containerPath": "/config",
      "access": "read-write",
      "purpose": "sqlite-and-configuration",
      "localFilesystemRequired": true
    },
    {
      "containerPath": "/metadata",
      "access": "read-write",
      "purpose": "metadata-images-logs-and-backups"
    },
    {
      "containerPath": "/audiobooks",
      "access": "read-only-preferred",
      "purpose": "owned-audiobooks"
    },
    {
      "containerPath": "/podcasts",
      "access": "selection-dependent",
      "purpose": "managed-podcasts"
    }
  ],
  "firstAdmin": {
    "mode": "browser",
    "path": "/",
    "credential": "username-password",
    "role": "root"
  },
  "homarr": {
    "internalUrl": "http://audiobookshelf:80",
    "credential": "api-key-from-one-time-creation-dialog",
    "widget": "audio-stats"
  },
  "acceptance": [
    "persistent-config-and-metadata",
    "root-login",
    "books-library-scan",
    "homarr-integration-test",
    "linked-tile-and-audio-stats"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajnart.dev/selfhost-skills/stack.schema.json",
  "title": "Selfhost resumable stack metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "createdAt", "updatedAt", "profiles", "skills", "runtime", "serviceBindings", "services", "connections", "checkpoint"],
  "properties": {
    "schemaVersion": {"const": 1},
    "revision": {"type": "integer", "minimum": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}},
    "skills": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^selfhost(?:-[a-z0-9]+)*$"}},
    "runtime": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "runId", "statePath"],
          "properties": {
            "adapter": {"const": "selfhost-media"},
            "runId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"},
            "statePath": {"type": "string", "pattern": "^\\.selfhost/media-harness/\\.sessions/[a-z0-9][a-z0-9_-]{0,39}$"}
          }
        }
      ]
    },
    "serviceBindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profileId", "serviceIds"],
        "properties": {
          "profileId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
          "serviceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"}
          }
        }
      }
    },
    "services": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ownerSkill"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"},
          "ownerSkill": {"type": "string", "pattern": "^selfhost(?:-[a-z0-9]+)*$"}
        }
      }
    },
    "connections": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "contains", "initialPasswordStored"],
          "properties": {
            "path": {"type": "string", "pattern": "^\\.selfhost/[a-zA-Z0-9._/-]+/connections\\.env$"},
            "contains": {"const": ["api-keys", "urls", "usernames"]},
            "initialPasswordStored": {"const": false}
          }
        }
      ]
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "recordedAt", "evidenceIds"],
      "properties": {
        "stage": {"enum": ["selected", "planned", "applied", "verified"]},
        "recordedAt": {"type": "string", "format": "date-time"},
        "evidenceIds": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^(inspection|plan|approval|apply|manifest|verify):[a-z0-9][a-z0-9._-]{0,47}$"}}
      }
    }
  }
}

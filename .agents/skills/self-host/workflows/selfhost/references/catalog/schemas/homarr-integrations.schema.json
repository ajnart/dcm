{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajnart.dev/selfhost-skills/homarr-integrations.schema.json",
  "title": "Homarr integration coverage registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "checkedAt", "externalOnly", "officialSources", "standard", "special"],
  "properties": {
    "schemaVersion": {"const": 1},
    "checkedAt": {"type": "string", "format": "date"},
    "externalOnly": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"},
      "uniqueItems": true
    },
    "officialSources": {
      "type": "array",
      "items": {"type": "string", "format": "uri", "pattern": "^https://"},
      "minItems": 2,
      "uniqueItems": true
    },
    "standard": {
      "type": "array",
      "items": {"$ref": "#/$defs/surface"}
    },
    "special": {
      "type": "array",
      "items": {"$ref": "#/$defs/surface"},
      "maxItems": 2
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "displayName"],
      "properties": {
        "identifier": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"},
        "displayName": {"type": "string", "minLength": 1}
      }
    }
  }
}

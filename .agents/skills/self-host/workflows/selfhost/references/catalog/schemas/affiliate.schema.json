{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajnart.dev/selfhost-skills/affiliate.schema.json",
  "title": "Disclosed affiliate registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "disclosure", "regions", "checkedAt", "enabled"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "url": {"type": "string", "format": "uri"},
          "disclosure": {"type": "string", "minLength": 8},
          "regions": {"type": "array", "items": {"type": "string", "minLength": 2}, "uniqueItems": true},
          "checkedAt": {"type": "string", "format": "date"},
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}

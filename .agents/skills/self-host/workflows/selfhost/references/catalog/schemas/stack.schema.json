{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajnart.dev/selfhost-skills/stack.schema.json",
  "title": "Selfhost goal stack record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "aliases", "summary", "categories", "automation", "roles", "requiredSkills", "gates", "acceptance"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 2},
    "aliases": {"type": "array", "items": {"type": "string", "minLength": 2}, "minItems": 1, "uniqueItems": true},
    "summary": {"type": "string", "minLength": 10},
    "categories": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "automation": {"enum": ["managed", "guided", "discovery"]},
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "required", "default", "choices", "reason", "purpose", "gates"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string"},
          "required": {"type": "boolean"},
          "default": {"type": ["string", "null"]},
          "choices": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "reason": {"type": "string", "minLength": 8},
          "purpose": {"type": "string", "minLength": 8},
          "gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "requiredSkills": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "gates": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "acceptance": {"type": "array", "items": {"type": "string", "minLength": 8}, "minItems": 1}
  }
}

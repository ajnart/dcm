{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "transmission",
  "source": "https://docs.linuxserver.io/images/docker-transmission/",
  "services": [
    {
      "id": "transmission",
      "purpose": "Provides an authenticated private torrent RPC and WebUI with owner-selected download storage.",
      "imageTag": "linuxserver/transmission:version-4.1.3-r0",
      "imageSource": "https://hub.docker.com/r/linuxserver/transmission/tags",
      "user": "image-default",
      "imageUserEvidence": {
        "officialUrl": "https://docs.linuxserver.io/images/docker-transmission/",
        "reason": "official-image-runtime-contract"
      },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [{ "name": "USER", "value": "admin" }],
      "hostEnvironment": [
        { "name": "PUID", "source": "uid" },
        { "name": "PGID", "source": "gid" },
        { "name": "TZ", "source": "timezone" }
      ],
      "fileEnvironment": [{ "name": "FILE__PASS", "fileId": "admin-password" }],
      "mounts": [
        { "name": "config", "target": "/config", "kind": "volume" },
        { "name": "media-data", "target": "/downloads", "kind": "bind", "hostPath": true, "readOnly": false, "shareGroup": "media-data" }
      ],
      "dependsOn": [],
      "publishTargetPort": 9091
    }
  ],
  "privateFiles": [{ "id": "admin-password", "bytes": 48, "format": "alphanumeric" }],
  "onboarding": {
    "kind": "manual-first-admin",
    "officialUrl": "https://docs.linuxserver.io/images/docker-transmission/",
    "username": "admin",
    "fileId": "admin-password"
  },
  "defaults": {
    "hostIp": "127.0.0.1",
    "publishedPort": 9091,
    "dataDirectoryName": "transmission"
  },
  "storage": {
    "filesystem": "local-posix-locks",
    "minimumFreeBytes": 10737418240
  },
  "acceptance": [
    { "id": "admin-rpc", "method": "api", "description": "Verify unauthenticated RPC is denied, then authenticate with the saved admin password and read the pinned session version through the CSRF-protected RPC endpoint." },
    { "id": "download-storage", "method": "api", "description": "Verify the selected /downloads bind and configured download directory before any authorized transfer." },
    { "id": "peer-port-and-vpn", "method": "persisted", "description": "Peer TCP/UDP port publication and downloader VPN routing remain separate approvals; VPN acceptance needs a tunnel-break fail-closed test." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart only this owned service and repeat authenticated RPC and storage checks." }
  ]
}

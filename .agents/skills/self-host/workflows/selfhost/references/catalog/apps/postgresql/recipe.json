{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "postgresql",
  "source": "https://hub.docker.com/_/postgres",
  "services": [
    {
      "id": "postgresql",
      "purpose": "Stores relational data in a persistent, project-owned PostgreSQL 18 cluster.",
      "imageTag": "docker.io/library/postgres:18.6",
      "imageSource": "https://hub.docker.com/_/postgres/tags?name=18.6",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://hub.docker.com/_/postgres", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [
        { "name": "POSTGRES_USER", "value": "postgres" },
        { "name": "POSTGRES_DB", "value": "postgres" }
      ],
      "hostEnvironment": [],
      "fileEnvironment": [{ "name": "POSTGRES_PASSWORD_FILE", "fileId": "admin-password" }],
      "mounts": [{ "name": "database", "target": "/var/lib/postgresql", "kind": "volume" }],
      "healthcheck": { "test": ["CMD", "pg_isready", "-U", "postgres", "-d", "postgres"], "intervalSeconds": 10, "timeoutSeconds": 5, "startPeriodSeconds": 30, "retries": 5 },
      "dependsOn": [],
      "publishTargetPort": 5432
    }
  ],
  "privateFiles": [{ "id": "admin-password", "bytes": 48, "format": "alphanumeric" }],
  "onboarding": {
    "kind": "initial-admin-from-file",
    "officialUrl": "https://hub.docker.com/_/postgres",
    "username": "postgres",
    "usernameEnvironment": "POSTGRES_USER",
    "fileEnvironment": "POSTGRES_PASSWORD_FILE",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 5432, "dataDirectoryName": "postgresql" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "authenticated-query", "method": "api", "description": "From a separate client over the exact private TCP origin, authenticate with the generated password and run a read-only query; pg_isready alone is insufficient." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart this exact project and verify the authenticated account and a deliberately created probe row persist." },
    { "id": "isolated-restore", "method": "persisted", "description": "Restore a consistent PostgreSQL backup into an isolated cluster and verify the intended data." }
  ]
}

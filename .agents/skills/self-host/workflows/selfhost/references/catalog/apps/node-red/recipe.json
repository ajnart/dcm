{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "node-red",
  "source": "https://nodered.org/docs/getting-started/docker",
  "services": [{
    "id": "node-red",
    "purpose": "Runs the private flow editor and Admin API with authentication configured before startup.",
    "imageTag": "nodered/node-red:5.0.7",
    "imageSource": "https://github.com/node-red/node-red-docker/releases/tag/v5.0.7",
    "user": "host-selected",
    "imageUserEvidence": { "officialUrl": "https://nodered.org/docs/getting-started/docker", "reason": "official-image-runtime-contract" },
    "restart": "unless-stopped",
    "readOnly": false,
    "environment": [],
    "hostEnvironment": [{ "name": "TZ", "source": "timezone" }],
    "fileEnvironment": [],
    "secretEnvironment": [{ "name": "NODE_RED_ADMIN_AUTH_HASH", "fileId": "admin-password", "format": "bcrypt-hash" }],
    "mounts": [
      { "name": "data", "target": "/data", "kind": "bind" },
      { "name": "settings", "target": "/data/settings.js", "kind": "generated-file", "fileId": "settings" }
    ],
    "dependsOn": [],
    "publishTargetPort": 1880
  }],
  "privateFiles": [{ "id": "admin-password", "bytes": 48, "format": "alphanumeric" }],
  "configFiles": [{ "id": "settings", "content": "module.exports = {\n  adminAuth: {\n    type: 'credentials',\n    users: [{ username: 'admin', password: process.env.NODE_RED_ADMIN_AUTH_HASH, permissions: '*' }]\n  }\n};\n" }],
  "onboarding": {
    "kind": "initial-admin-from-secret-env",
    "officialUrl": "https://nodered.org/docs/user-guide/runtime/securing-node-red",
    "username": "admin",
    "fixedUsername": true,
    "secretEnvironment": "NODE_RED_ADMIN_AUTH_HASH",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 1880, "dataDirectoryName": "node-red" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "private-admin", "method": "api", "description": "Confirm anonymous flow access is denied, obtain a positive-lifetime expiring token with the saved password, and read flows with it." },
    { "id": "editor", "method": "browser", "description": "Open the editor through an approved private route and confirm login and flow editing behavior." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart the exact owned project and verify saved administrator authentication and flows persist." }
  ]
}

{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "actual-budget",
  "source": "https://actualbudget.org/docs/install/docker/",
  "services": [{
    "id": "actual-budget",
    "purpose": "Stores and syncs a private personal budget.",
    "imageTag": "ghcr.io/actualbudget/actual:26.9.0",
    "imageSource": "https://github.com/actualbudget/actual/pkgs/container/actual",
    "user": "image-default",
    "imageUserEvidence": { "officialUrl": "https://actualbudget.org/docs/install/docker/", "reason": "official-image-runtime-contract" },
    "restart": "unless-stopped",
    "readOnly": false,
    "environment": [],
    "hostEnvironment": [],
    "fileEnvironment": [],
    "mounts": [{ "name": "data", "target": "/data", "kind": "volume" }],
    "dependsOn": [],
    "publishTargetPort": 5006
  }],
  "privateFiles": [{ "id": "admin-password", "bytes": 48, "format": "alphanumeric" }],
  "onboarding": {
    "kind": "manual-first-password",
    "officialUrl": "https://github.com/actualbudget/actual/blob/v26.9.0/packages/sync-server/src/app-account.js",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 5006, "dataDirectoryName": "actual-budget" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "password-login", "method": "api", "description": "Bootstrap only an empty server, then independently log in with the saved password and validate its admin session." },
    { "id": "budget-round-trip", "method": "api", "description": "Create and retrieve an authorized sample budget separately; password login alone does not prove budgeting." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart only the owned Compose project and verify the saved password still authenticates and budget data persists." }
  ]
}

{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "unbound",
  "source": "https://github.com/madnuttah/unbound-docker/blob/main/doc/README.md",
  "services": [{
    "id": "unbound",
    "purpose": "Runs a private recursive DNS resolver; host DNS publication is limited to loopback until separately approved.",
    "imageTag": "madnuttah/unbound:1.26.0-0",
    "imageSource": "https://github.com/madnuttah/unbound-docker/releases/tag/1.26.0-0",
    "user": "image-default",
    "imageUserEvidence": { "officialUrl": "https://github.com/madnuttah/unbound-docker/blob/main/doc/README.md", "reason": "official-image-runtime-contract" },
    "restart": "unless-stopped",
    "readOnly": false,
    "healthcheck": {
      "test": ["CMD", "/usr/local/unbound/sbin/healthcheck.sh"],
      "intervalSeconds": 60,
      "timeoutSeconds": 15,
      "startPeriodSeconds": 5,
      "retries": 3
    },
    "environment": [],
    "hostEnvironment": [{ "name": "TZ", "source": "timezone" }],
    "fileEnvironment": [],
    "mounts": [],
    "dependsOn": [],
    "publishTargetPort": 5335,
    "additionalPorts": [{ "id": "dns-udp", "targetPort": 5335, "protocol": "udp", "purpose": "application", "required": true }]
  }],
  "privateFiles": [],
  "onboarding": { "kind": "no-account", "officialUrl": "https://github.com/madnuttah/unbound-docker/blob/main/doc/README.md" },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 5335, "dataDirectoryName": "unbound" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "dns-query", "method": "api", "description": "From the selected private client, query an external name through both UDP and TCP port 5335 and verify the answer; the image healthcheck alone observes an open port." },
    { "id": "dns-publication", "method": "api", "description": "Only after a separate DNS-owner approval, review exact bind address, client ACL, TCP/UDP ports, fallback DNS, and prove no public recursion." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart only the owned Compose project and repeat private TCP and UDP DNS queries." }
  ]
}

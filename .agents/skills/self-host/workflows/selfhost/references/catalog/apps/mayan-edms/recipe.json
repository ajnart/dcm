{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "mayan-edms",
  "source": "https://gitlab.com/mayan-edms/mayan-edms/-/raw/834ffec1b539171390358e60a0406870108514f5/docker/docker-compose.yml",
  "services": [
    {
      "id": "mayan-edms",
      "purpose": "Runs the official all-in-one document frontend, scheduler, and background workers.",
      "imageTag": "docker.io/mayanedms/mayanedms:v4.12.2",
      "imageSource": "https://hub.docker.com/r/mayanedms/mayanedms/tags?name=v4.12.2",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://docs.mayan-edms.com/chapters/docker/install_docker_compose.html", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "command": ["run_all"],
      "environment": [
        { "name": "MAYAN_AUTOADMIN_USERNAME", "value": "admin" },
        { "name": "MAYAN_AUTOADMIN_LOG_CREDENTIALS", "value": "false" },
        { "name": "MAYAN_LOCK_MANAGER_BACKEND", "value": "mayan.apps.lock_manager.backends.redis_lock.RedisLock" },
        { "name": "MAYAN_SERVER_SIDE_EVENTS_BACKEND", "value": "mayan.apps.server_side_events.sse_backends.redis.RedisServerEventStreamBackend" }
      ],
      "hostEnvironment": [],
      "fileEnvironment": [],
      "secretEnvironment": [
        { "name": "MAYAN_AUTOADMIN_PASSWORD", "fileId": "admin-password" },
        { "name": "MAYAN_DATABASES", "fileId": "database-config", "format": "private-config", "officialUrl": "https://gitlab.com/mayan-edms/mayan-edms/-/raw/834ffec1b539171390358e60a0406870108514f5/docker/docker-compose.yml" },
        { "name": "MAYAN_CELERY_BROKER_URL", "fileId": "broker-config", "format": "private-config", "officialUrl": "https://gitlab.com/mayan-edms/mayan-edms/-/raw/834ffec1b539171390358e60a0406870108514f5/docker/docker-compose.yml" },
        { "name": "MAYAN_CELERY_RESULT_BACKEND", "fileId": "result-config", "format": "private-config", "officialUrl": "https://gitlab.com/mayan-edms/mayan-edms/-/raw/834ffec1b539171390358e60a0406870108514f5/docker/docker-compose.yml" },
        { "name": "MAYAN_LOCK_MANAGER_BACKEND_ARGUMENTS", "fileId": "lock-config", "format": "private-config", "officialUrl": "https://gitlab.com/mayan-edms/mayan-edms/-/raw/834ffec1b539171390358e60a0406870108514f5/docker/docker-compose.yml" },
        { "name": "MAYAN_SERVER_SIDE_EVENTS_BACKEND_ARGUMENTS", "fileId": "event-config", "format": "private-config", "officialUrl": "https://gitlab.com/mayan-edms/mayan-edms/-/raw/834ffec1b539171390358e60a0406870108514f5/docker/docker-compose.yml" }
      ],
      "mounts": [{ "name": "data", "target": "/var/lib/mayan", "kind": "volume" }],
      "dependsOn": [
        { "service": "postgresql", "condition": "service_healthy" },
        { "service": "rabbitmq", "condition": "service_healthy" },
        { "service": "redis", "condition": "service_healthy" }
      ],
      "publishTargetPort": 8000
    },
    {
      "id": "postgresql",
      "purpose": "Stores document metadata, administrator identity, and durable API tokens.",
      "imageTag": "docker.io/library/postgres:15.17",
      "imageSource": "https://gitlab.com/mayan-edms/mayan-edms/-/raw/834ffec1b539171390358e60a0406870108514f5/docker/docker-compose.yml",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://hub.docker.com/_/postgres", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [{ "name": "POSTGRES_DB", "value": "mayan" }, { "name": "POSTGRES_USER", "value": "mayan" }],
      "hostEnvironment": [],
      "fileEnvironment": [{ "name": "POSTGRES_PASSWORD_FILE", "fileId": "database-password" }],
      "healthcheck": { "test": ["CMD", "pg_isready", "--dbname", "mayan", "--username", "mayan"], "intervalSeconds": 10, "timeoutSeconds": 5, "startPeriodSeconds": 30, "retries": 5 },
      "mounts": [{ "name": "database", "target": "/var/lib/postgresql/data", "kind": "volume" }],
      "dependsOn": [],
      "publishTargetPort": null
    },
    {
      "id": "rabbitmq",
      "purpose": "Queues authenticated background document processing jobs.",
      "imageTag": "docker.io/library/rabbitmq:4.1.8-management",
      "imageSource": "https://gitlab.com/mayan-edms/mayan-edms/-/raw/834ffec1b539171390358e60a0406870108514f5/docker/docker-compose.yml",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://hub.docker.com/_/rabbitmq", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [{ "name": "RABBITMQ_DEFAULT_USER", "value": "mayan" }, { "name": "RABBITMQ_DEFAULT_VHOST", "value": "mayan" }],
      "hostEnvironment": [],
      "fileEnvironment": [],
      "secretEnvironment": [{ "name": "RABBITMQ_DEFAULT_PASS", "fileId": "broker-password" }],
      "healthcheck": { "test": ["CMD", "rabbitmq-diagnostics", "ping"], "intervalSeconds": 30, "timeoutSeconds": 30, "startPeriodSeconds": 20, "retries": 5 },
      "mounts": [{ "name": "broker", "target": "/var/lib/rabbitmq", "kind": "volume" }],
      "dependsOn": [],
      "publishTargetPort": null
    },
    {
      "id": "redis",
      "purpose": "Stores authenticated task results, distributed locks, and server-side event state without key eviction.",
      "imageTag": "docker.io/library/redis:7.4.8",
      "imageSource": "https://gitlab.com/mayan-edms/mayan-edms/-/raw/834ffec1b539171390358e60a0406870108514f5/docker/docker-compose.yml",
      "user": "host-selected",
      "imageUserEvidence": { "officialUrl": "https://github.com/redis/docker-library-redis/blob/0ae559ebb19b1cafc36720e8de97839d5d402883/7.4/debian/docker-entrypoint.sh", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "command": ["redis-server", "/run/secrets/redis-config"],
      "environment": [],
      "hostEnvironment": [],
      "fileEnvironment": [],
      "secretEnvironment": [{ "name": "REDISCLI_AUTH", "fileId": "redis-password" }],
      "privateConfigFiles": ["redis-config"],
      "healthcheck": { "test": ["CMD", "redis-cli", "-e", "ping"], "intervalSeconds": 5, "timeoutSeconds": 5, "startPeriodSeconds": 10, "retries": 5 },
      "mounts": [{ "name": "redis", "target": "/data" }],
      "dependsOn": [],
      "publishTargetPort": null
    }
  ],
  "privateFiles": [
    { "id": "admin-password", "bytes": 48 },
    { "id": "database-password", "bytes": 48 },
    { "id": "broker-password", "bytes": 48 },
    { "id": "redis-password", "bytes": 48 }
  ],
  "privateConfigs": [
    { "id": "database-config", "officialUrl": "https://gitlab.com/mayan-edms/mayan-edms/-/raw/834ffec1b539171390358e60a0406870108514f5/docker/docker-compose.yml", "parts": [{ "literal": "{\"default\":{\"ENGINE\":\"django.db.backends.postgresql\",\"NAME\":\"mayan\",\"PASSWORD\":\"" }, { "fileId": "database-password" }, { "literal": "\",\"USER\":\"mayan\",\"HOST\":\"postgresql\",\"PORT\":5432,\"CONN_MAX_AGE\":0}}" }] },
    { "id": "broker-config", "officialUrl": "https://gitlab.com/mayan-edms/mayan-edms/-/raw/834ffec1b539171390358e60a0406870108514f5/docker/docker-compose.yml", "parts": [{ "literal": "amqp://mayan:" }, { "fileId": "broker-password" }, { "literal": "@rabbitmq:5672/mayan" }] },
    { "id": "result-config", "officialUrl": "https://gitlab.com/mayan-edms/mayan-edms/-/raw/834ffec1b539171390358e60a0406870108514f5/docker/docker-compose.yml", "parts": [{ "literal": "redis://:" }, { "fileId": "redis-password" }, { "literal": "@redis:6379/1" }] },
    { "id": "lock-config", "officialUrl": "https://gitlab.com/mayan-edms/mayan-edms/-/raw/834ffec1b539171390358e60a0406870108514f5/docker/docker-compose.yml", "parts": [{ "literal": "{\"redis_url\":\"redis://:" }, { "fileId": "redis-password" }, { "literal": "@redis:6379/2\"}" }] },
    { "id": "event-config", "officialUrl": "https://gitlab.com/mayan-edms/mayan-edms/-/raw/834ffec1b539171390358e60a0406870108514f5/docker/docker-compose.yml", "parts": [{ "literal": "{\"url\":\"redis://:" }, { "fileId": "redis-password" }, { "literal": "@redis:6379/3\"}" }] },
    { "id": "redis-config", "officialUrl": "https://gitlab.com/mayan-edms/mayan-edms/-/raw/834ffec1b539171390358e60a0406870108514f5/docker/docker-compose.yml", "parts": [{ "literal": "appendonly no\ndatabases 4\nmaxmemory 100mb\nmaxclients 500\nmaxmemory-policy noeviction\nsave \"\"\ntcp-backlog 256\nrequirepass " }, { "fileId": "redis-password" }, { "literal": "\n" }] }
  ],
  "onboarding": { "kind": "initial-admin-from-secret-env", "officialUrl": "https://docs.mayan-edms.com/chapters/getting_started.html", "username": "admin", "usernameEnvironment": "MAYAN_AUTOADMIN_USERNAME", "secretEnvironment": "MAYAN_AUTOADMIN_PASSWORD", "fileId": "admin-password" },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 8080, "dataDirectoryName": "mayan-edms" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 5368709120 },
  "acceptance": [
    { "id": "first-account", "method": "api", "description": "Authenticate the saved owner, clear initial credential disclosure, and verify durable token identity and user-view access; prove actual administrator authority separately." },
    { "id": "document-roundtrip", "method": "api", "description": "Upload one harmless document and verify its original bytes, document identity, and completed background processing." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart the exact shared project and verify saved administrator, token, and document remain available without initial credential disclosure." },
    { "id": "isolated-restore", "method": "persisted", "description": "Restore database and document storage into an isolated project and verify account, token, and original document bytes." }
  ]
}

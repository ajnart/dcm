{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "prowlarr",
  "source": "https://docs.linuxserver.io/images/docker-prowlarr/",
  "services": [
    {
      "id": "prowlarr",
      "purpose": "Manages approved indexer configurations; no indexer is selected automatically.",
      "imageTag": "lscr.io/linuxserver/prowlarr:version-2.6.5.5623",
      "imageSource": "https://github.com/linuxserver/docker-prowlarr/pkgs/container/prowlarr/versions",
      "user": "image-default",
      "imageUserEvidence": {
        "officialUrl": "https://docs.linuxserver.io/images/docker-prowlarr/",
        "reason": "official-image-runtime-contract"
      },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [],
      "hostEnvironment": [
        { "name": "PUID", "source": "uid" },
        { "name": "PGID", "source": "gid" }
      ],
      "fileEnvironment": [],
      "mounts": [
        { "name": "config", "target": "/config", "kind": "volume" }
      ],
      "dependsOn": [],
      "publishTargetPort": 9696
    }
  ],
  "privateFiles": [
    { "id": "admin-password", "bytes": 48 }
  ],
  "onboarding": {
    "kind": "manual-first-admin",
    "officialUrl": "https://raw.githubusercontent.com/Prowlarr/Prowlarr/develop/src/Prowlarr.Api.V1/openapi.json",
    "username": "admin",
    "fileId": "admin-password"
  },
  "defaults": {
    "hostIp": "127.0.0.1",
    "publishedPort": 9696,
    "dataDirectoryName": "prowlarr"
  },
  "storage": {
    "filesystem": "local-posix-locks",
    "minimumFreeBytes": 1073741824
  },
  "acceptance": [
    { "id": "forms-login", "method": "api", "description": "Enable required Forms authentication and verify the managed administrator login." },
    { "id": "indexer-choice", "method": "browser", "description": "Add an authorized indexer separately and confirm its own connectivity; initial setup does not configure one." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart this exact project and verify its administrator login and any configured indexer remain available." }
  ]
}

    "status": "known"
  },
  "lifecycle": {
    "status": "active",
    "checkedAt": "2026-09-29",
    "note": "Private ping plus Basic-authenticated exact GET-only management paths support the native Homarr source contract. The fixed middleware username is control access, not a created account. No Docker provider/socket, dashboard, application ingress, or TLS is enabled. Existing ping-only owners need a separately supported recipe transition. Source fixtures are not live acceptance."
  },
  "support": {
    "automation": "guided",
    "tier": "T0",
    "adapterSkill": null
  },
  "homarr": {
    "support": "supported",
    "integration": "Traefik"
  },
  "dependencies": [
    "capability:dns",
    "capability:docker-api-boundary"
  ],
  "alternatives": [
    "caddy",
    "nginx-proxy-manager"
  ],
  "security": [
    "Protect the Docker API and authenticate the dashboard."
  ],
  "pitfalls": [
    "The recipe never enables insecure API/dashboard access. Control-interface credentials do not create Traefik user records; existing owners are not silently migrated or given replacement credentials."
  ],

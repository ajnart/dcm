{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "kopia",
  "source": "https://kopia.io/docs/installation/",
  "services": [{
    "id": "kopia",
    "purpose": "Hosts the private Kopia UI; repository connection and backup sources remain unconfigured.",
    "imageTag": "docker.io/kopia/kopia:0.23.1",
    "imageSource": "https://github.com/kopia/kopia/releases/tag/v0.23.1",
    "user": "image-default",
    "imageUserEvidence": { "officialUrl": "https://github.com/kopia/kopia/blob/v0.23.1/tools/docker/Dockerfile", "reason": "official-image-runtime-contract" },
    "restart": "unless-stopped",
    "readOnly": false,
    "command": ["server", "start", "--address=0.0.0.0:51515", "--insecure", "--async-repo-connect"],
    "environment": [{ "name": "KOPIA_SERVER_USERNAME", "value": "admin" }],
    "hostEnvironment": [],
    "fileEnvironment": [],
    "secretEnvironment": [
      { "name": "KOPIA_SERVER_PASSWORD", "fileId": "admin-password" },
      { "name": "KOPIA_PASSWORD", "fileId": "repository-password" }
    ],
    "mounts": [
      { "name": "config", "target": "/app/config", "kind": "volume" },
      { "name": "cache", "target": "/app/cache", "kind": "volume" },
      { "name": "logs", "target": "/app/logs", "kind": "volume" }
    ],
    "dependsOn": [],
    "publishTargetPort": 51515
  }],
  "privateFiles": [
    { "id": "admin-password", "bytes": 48, "format": "alphanumeric" },
    { "id": "repository-password", "bytes": 48, "format": "alphanumeric" }
  ],
  "onboarding": {
    "kind": "initial-admin-from-secret-env",
    "officialUrl": "https://github.com/kopia/kopia/blob/v0.23.1/cli/command_server.go",
    "username": "admin",
    "usernameEnvironment": "KOPIA_SERVER_USERNAME",
    "secretEnvironment": "KOPIA_SERVER_PASSWORD",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 51515, "dataDirectoryName": "kopia" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "admin-auth", "method": "api", "description": "Verify the saved generated administrator password via private HTTP Basic authentication and reject unauthenticated access; this alone does not prove a connected repository." },
    { "id": "repository-choice", "method": "persisted", "description": "Pending owner choice: select durable repository storage, add the approved mount or provider configuration, create or connect it with its saved password, and verify independent access. This recipe has no repository mount and does not create a repository." },
    { "id": "backup-restore", "method": "persisted", "description": "Pending explicit source paths: snapshot them and prove an isolated restore before claiming backup acceptance." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart the exact Compose project and verify credentials, repository connection, and snapshots remain available." }
  ]
}

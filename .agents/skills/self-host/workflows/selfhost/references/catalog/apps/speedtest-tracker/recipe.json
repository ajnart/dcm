{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "speedtest-tracker",
  "source": "https://docs.speedtest-tracker.dev/getting-started/installation/using-docker-compose",
  "services": [{
    "id": "speedtest-tracker",
    "purpose": "Records private internet speed measurements and displays their history.",
    "imageTag": "lscr.io/linuxserver/speedtest-tracker:v1.14.7-ls165",
    "imageSource": "https://github.com/linuxserver/docker-speedtest-tracker/releases/tag/v1.14.7-ls165",
    "user": "image-default",
    "imageUserEvidence": { "officialUrl": "https://docs.linuxserver.io/images/docker-speedtest-tracker/", "reason": "official-image-runtime-contract" },
    "restart": "unless-stopped",
    "readOnly": false,
    "environment": [
      { "name": "DB_CONNECTION", "value": "sqlite" },
      { "name": "ADMIN_EMAIL", "value": "admin@example.test" },
      { "name": "PUBLIC_DASHBOARD", "value": "false" }
    ],
    "hostEnvironment": [
      { "name": "PUID", "source": "uid" },
      { "name": "PGID", "source": "gid" }
    ],
    "derivedEnvironment": [{ "name": "APP_URL", "source": "local-origin" }],
    "hostIdentityEvidence": "https://docs.linuxserver.io/images/docker-speedtest-tracker/",
    "fileEnvironment": [{ "name": "FILE__APP_KEY", "fileId": "app-key" }],
    "secretEnvironment": [{ "name": "ADMIN_PASSWORD", "fileId": "admin-password" }],
    "mounts": [{ "name": "config", "target": "/config", "kind": "volume" }],
    "dependsOn": [],
    "publishTargetPort": 80
  }],
  "privateFiles": [
    { "id": "app-key", "bytes": 32, "format": "base64-prefixed" },
    { "id": "admin-password", "bytes": 48, "format": "alphanumeric" }
  ],
  "onboarding": {
    "kind": "initial-admin-email-from-secret-env",
    "officialUrl": "https://docs.speedtest-tracker.dev/getting-started/environment-variables",
    "email": "admin@example.test",
    "emailEnvironment": "ADMIN_EMAIL",
    "secretEnvironment": "ADMIN_PASSWORD",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 8080, "dataDirectoryName": "speedtest-tracker" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "admin-login", "method": "api", "description": "Verify the saved admin@example.test password and administrator role inside the exact pinned Laravel container. Browser login UX remains separate." },
    { "id": "api-token", "method": "api", "description": "Create one results:read token through the pinned Laravel model, save its one-time plaintext privately, verify its administrator owner and GET /api/v1/stats. An interrupted creation without a saved token requires recovery, not blind retry." },
    { "id": "measurement", "method": "browser", "description": "Run one approved speedtest, then confirm the measured result and metadata appear in history." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart the exact owned Compose project and confirm admin login and measurement history persist." }
  ]
}

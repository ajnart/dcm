{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "seafile",
  "source": "https://manual.seafile.com/13.0/repo/docker/ce/seafile-server.yml",
  "services": [
    {
      "id": "seafile",
      "purpose": "Serves private file libraries and web access while storing configuration and file blocks.",
      "imageTag": "docker.io/seafileltd/seafile-mc:13.0.28",
      "imageSource": "https://hub.docker.com/r/seafileltd/seafile-mc/tags?name=13.0.28",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://manual.seafile.com/13.0/repo/docker/ce/seafile-server.yml", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [
        { "name": "SEAFILE_MYSQL_DB_HOST", "value": "db" },
        { "name": "SEAFILE_MYSQL_DB_PORT", "value": "3306" },
        { "name": "SEAFILE_MYSQL_DB_USER", "value": "seafile" },
        { "name": "INIT_SEAFILE_ADMIN_EMAIL", "value": "admin@example.test" },
        { "name": "SEAFILE_SERVER_PROTOCOL", "value": "http" },
        { "name": "CACHE_PROVIDER", "value": "redis" },
        { "name": "REDIS_HOST", "value": "redis" },
        { "name": "REDIS_PORT", "value": "6379" },
        { "name": "ENABLE_SEADOC", "value": "false" },
        { "name": "ENABLE_NOTIFICATION_SERVER", "value": "false" },
        { "name": "ENABLE_SEAFILE_AI", "value": "false" },
        { "name": "ENABLE_FACE_RECOGNITION", "value": "false" }
      ],
      "hostEnvironment": [],
      "derivedEnvironment": [{ "name": "SEAFILE_SERVER_HOSTNAME", "source": "local-host-authority" }],
      "fileEnvironment": [],
      "secretEnvironment": [
        { "name": "SEAFILE_MYSQL_DB_PASSWORD", "fileId": "database-password" },
        { "name": "INIT_SEAFILE_MYSQL_ROOT_PASSWORD", "fileId": "database-root-password" },
        { "name": "INIT_SEAFILE_ADMIN_PASSWORD", "fileId": "admin-password" },
        { "name": "JWT_PRIVATE_KEY", "fileId": "jwt-private-key" }
      ],
      "mounts": [{ "name": "data", "target": "/shared", "kind": "volume" }],
      "dependsOn": [{ "service": "db", "condition": "service_healthy" }, "redis"],
      "publishTargetPort": 80
    },
    {
      "id": "db",
      "purpose": "Stores Seafile accounts, library metadata, and file indexes on the private project network.",
      "imageTag": "docker.io/library/mariadb:10.11.19",
      "imageSource": "https://hub.docker.com/_/mariadb",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://manual.seafile.com/13.0/repo/docker/ce/seafile-server.yml", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [
        { "name": "MYSQL_LOG_CONSOLE", "value": "true" },
        { "name": "MARIADB_AUTO_UPGRADE", "value": "1" }
      ],
      "hostEnvironment": [],
      "fileEnvironment": [{ "name": "MYSQL_ROOT_PASSWORD_FILE", "fileId": "database-root-password" }],
      "mounts": [{ "name": "database", "target": "/var/lib/mysql", "kind": "volume" }],
      "healthcheck": {
        "test": ["CMD", "/usr/local/bin/healthcheck.sh", "--connect", "--mariadbupgrade", "--innodb_initialized"],
        "intervalSeconds": 20,
        "timeoutSeconds": 5,
        "startPeriodSeconds": 30,
        "retries": 10
      },
      "dependsOn": [],
      "publishTargetPort": null
    },
    {
      "id": "redis",
      "purpose": "Keeps Seafile cache and session state inside the private project network.",
      "imageTag": "docker.io/library/redis:8.2.9-alpine3.22",
      "imageSource": "https://hub.docker.com/_/redis",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://manual.seafile.com/13.0/repo/docker/ce/seafile-server.yml", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [],
      "hostEnvironment": [],
      "fileEnvironment": [],
      "mounts": [],
      "dependsOn": [],
      "publishTargetPort": null
    }
  ],
  "privateFiles": [
    { "id": "admin-password", "bytes": 48, "format": "alphanumeric" },
    { "id": "database-password", "bytes": 48, "format": "alphanumeric" },
    { "id": "database-root-password", "bytes": 48, "format": "alphanumeric" },
    { "id": "jwt-private-key", "bytes": 48, "format": "alphanumeric" }
  ],
  "onboarding": {
    "kind": "initial-admin-email-from-secret-env",
    "officialUrl": "https://manual.seafile.com/13.0/setup/setup_ce_by_docker/",
    "email": "admin@example.test",
    "emailEnvironment": "INIT_SEAFILE_ADMIN_EMAIL",
    "secretEnvironment": "INIT_SEAFILE_ADMIN_PASSWORD",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 8080, "dataDirectoryName": "seafile" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 5368709120 },
  "acceptance": [
    { "id": "admin-login", "method": "api", "description": "Verify the saved first administrator through account-token login and an admin-only API read on the private origin." },
    { "id": "library-roundtrip", "method": "api", "description": "Create, upload, download, compare, and recoverably remove a synthetic file in a test library." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart the exact owned project and verify the administrator and same library file persist." },
    { "id": "isolated-restore", "method": "persisted", "description": "Restore both MariaDB and Seafile data volumes in isolation before claiming backup verification." }
  ]
}

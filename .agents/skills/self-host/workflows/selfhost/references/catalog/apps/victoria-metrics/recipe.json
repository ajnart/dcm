{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "victoria-metrics",
  "source": "https://docs.victoriametrics.com/victoriametrics/quick-start/",
  "services": [
    {
      "id": "victoria-metrics",
      "purpose": "Stores and queries metrics in a private single-node database.",
      "imageTag": "victoriametrics/victoria-metrics:v1.153.0",
      "imageSource": "https://hub.docker.com/r/victoriametrics/victoria-metrics",
      "user": "image-default",
      "imageUserEvidence": {
        "officialUrl": "https://docs.victoriametrics.com/victoriametrics/quick-start/",
        "reason": "official-image-runtime-contract"
      },
      "restart": "unless-stopped",
      "readOnly": false,
      "command": ["-storageDataPath=/victoria-metrics-data", "-selfScrapeInterval=5s"],
      "environment": [],
      "hostEnvironment": [],
      "fileEnvironment": [],
      "mounts": [{ "name": "data", "target": "/victoria-metrics-data", "kind": "volume" }],
      "dependsOn": [],
      "publishTargetPort": 8428
    }
  ],
  "privateFiles": [],
  "onboarding": {
    "kind": "no-account",
    "officialUrl": "https://docs.victoriametrics.com/victoriametrics/quick-start/"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 8428, "dataDirectoryName": "victoria-metrics" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "health-and-version", "method": "api", "description": "Read the single-node health and build-info endpoints and verify the pinned version." },
    { "id": "self-scrape", "method": "api", "description": "Query the explicitly enabled self-scrape metrics to verify ingestion and querying." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart the exact owned project and verify self-scraped metrics remain queryable." }
  ]
}

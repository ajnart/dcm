{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "grafana",
  "source": "https://grafana.com/docs/grafana/latest/setup-grafana/installation/docker/",
  "services": [
    {
      "id": "grafana",
      "purpose": "Serves private dashboards and alerting backed by persistent Grafana storage.",
      "imageTag": "grafana/grafana:13.2.2",
      "imageSource": "https://hub.docker.com/r/grafana/grafana",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://github.com/grafana/grafana/blob/v13.2.2/Dockerfile", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [{ "name": "GF_SECURITY_ADMIN_USER", "value": "admin" }],
      "hostEnvironment": [],
      "fileEnvironment": [],
      "secretEnvironment": [{ "name": "GF_SECURITY_ADMIN_PASSWORD", "fileId": "admin-password" }],
      "mounts": [{ "name": "data", "target": "/var/lib/grafana", "kind": "volume" }],
      "dependsOn": [],
      "publishTargetPort": 3000
    }
  ],
  "privateFiles": [{ "id": "admin-password", "bytes": 48 }],
  "onboarding": {
    "kind": "initial-admin-from-secret-env",
    "officialUrl": "https://grafana.com/docs/grafana/latest/setup-grafana/configure-docker/",
    "username": "admin",
    "usernameEnvironment": "GF_SECURITY_ADMIN_USER",
    "secretEnvironment": "GF_SECURITY_ADMIN_PASSWORD",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 3000, "dataDirectoryName": "grafana" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "admin-login", "method": "api", "description": "Authenticate the generated administrator and verify its server-admin identity." },
    { "id": "datasource", "method": "api", "description": "Configure and query a separately approved data source before claiming useful monitoring." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart the exact owned project and verify the administrator and dashboards persist." }
  ]
}

{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "homebridge",
  "source": "https://github.com/homebridge/docker-homebridge/blob/2026-09-25/README.md",
  "services": [{
    "id": "homebridge",
    "purpose": "Private Homebridge administration only; HomeKit LAN discovery and pairing require separately approved networking.",
    "imageTag": "docker.io/homebridge/homebridge:2026-09-25",
    "imageSource": "https://github.com/homebridge/docker-homebridge/releases/tag/2026-09-25",
    "user": "image-default",
    "imageUserEvidence": { "officialUrl": "https://github.com/homebridge/docker-homebridge/blob/2026-09-25/Dockerfile", "reason": "official-image-runtime-contract" },
    "restart": "unless-stopped",
    "readOnly": false,
    "environment": [{ "name": "ENABLE_AVAHI", "value": "0" }],
    "hostEnvironment": [{ "name": "TZ", "source": "timezone" }],
    "fileEnvironment": [],
    "mounts": [{ "name": "data", "target": "/homebridge", "kind": "volume" }],
    "dependsOn": [],
    "publishTargetPort": 8581
  }],
  "privateFiles": [{ "id": "admin-password", "bytes": 48, "format": "alphanumeric" }],
  "onboarding": {
    "kind": "manual-first-admin",
    "officialUrl": "https://raw.githubusercontent.com/homebridge/homebridge-config-ui-x/v5.29.0/src/modules/setup-wizard/setup-wizard.controller.ts",
    "username": "admin",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 8581, "dataDirectoryName": "homebridge" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "first-admin", "method": "api", "description": "Create the first administrator through the pinned wizard and verify saved-password login plus administrator user readback." },
    { "id": "lan-pairing", "method": "api", "description": "After separate LAN networking approval, prove pairing and accessory control from the selected HomeKit controller; private UI setup does not satisfy this gate." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart only the owned project and verify saved administrator and configuration persistence." }
  ]
}

{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "peanut",
  "source": "https://github.com/Brandawg93/PeaNUT",
  "services": [{
    "id": "peanut",
    "purpose": "Serves an authenticated private UPS dashboard; NUT monitoring remains unconfigured.",
    "imageTag": "brandawg93/peanut:v6.0.0",
    "imageSource": "https://github.com/Brandawg93/PeaNUT/releases/tag/v6.0.0",
    "user": "image-default",
    "imageUserEvidence": { "officialUrl": "https://github.com/Brandawg93/PeaNUT/blob/v6.0.0/Dockerfile", "reason": "official-image-runtime-contract" },
    "restart": "unless-stopped",
    "readOnly": false,
    "environment": [
      { "name": "WEB_HOST", "value": "0.0.0.0" },
      { "name": "WEB_PORT", "value": "8080" },
      { "name": "WEB_USERNAME", "value": "admin" }
    ],
    "hostEnvironment": [],
    "fileEnvironment": [],
    "secretEnvironment": [{ "name": "WEB_PASSWORD", "fileId": "admin-password" }],
    "mounts": [{ "name": "config", "target": "/config", "kind": "volume" }],
    "dependsOn": [],
    "publishTargetPort": 8080
  }],
  "privateFiles": [{ "id": "admin-password", "bytes": 48, "format": "alphanumeric" }],
  "onboarding": {
    "kind": "initial-admin-from-secret-env",
    "officialUrl": "https://github.com/Brandawg93/PeaNUT/blob/v6.0.0/README.md",
    "username": "admin",
    "usernameEnvironment": "WEB_USERNAME",
    "secretEnvironment": "WEB_PASSWORD",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 8080, "dataDirectoryName": "peanut" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "admin-auth", "method": "api", "description": "Verify generated Basic credentials against the private PeaNUT API and reject anonymous and wrong-password requests." },
    { "id": "ups-monitoring", "method": "api", "description": "Pending: configure an owner-selected UPS/NUT server and verify actual device readings and appropriate command permissions." },
    { "id": "restart-persistence", "method": "persisted", "description": "Pending: v6.0.0 has a reported auth.yaml path defect; verify persistence on the exact image before claiming it." }
  ]
}

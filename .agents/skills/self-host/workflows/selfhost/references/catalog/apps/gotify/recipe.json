{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "gotify",
  "source": "https://github.com/gotify/server",
  "services": [
    {
      "id": "gotify",
      "purpose": "Receives private push notifications and stores them for connected Gotify clients.",
      "imageTag": "gotify/server:3.1.1",
      "imageSource": "https://hub.docker.com/r/gotify/server/tags",
      "user": "image-default",
      "imageUserEvidence": {
        "officialUrl": "https://gotify.net/docs/install",
        "reason": "official-image-runtime-contract"
      },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [
        { "name": "GOTIFY_DEFAULTUSER_NAME", "value": "admin" },
        { "name": "GOTIFY_REGISTRATION", "value": "false" },
        { "name": "GOTIFY_LOCALAUTH_ENABLED", "value": "true" }
      ],
      "hostEnvironment": [
        { "name": "TZ", "source": "timezone" }
      ],
      "fileEnvironment": [
        { "name": "GOTIFY_DEFAULTUSER_PASS_FILE", "fileId": "admin-password" }
      ],
      "mounts": [
        { "name": "appdata", "target": "/app/data", "kind": "volume" }
      ],
      "dependsOn": [],
      "publishTargetPort": 80
    }
  ],
  "privateFiles": [
    { "id": "admin-password", "bytes": 48 }
  ],
  "onboarding": {
    "kind": "initial-admin-from-file",
    "officialUrl": "https://gotify.net/docs/config",
    "username": "admin",
    "usernameEnvironment": "GOTIFY_DEFAULTUSER_NAME",
    "fileEnvironment": "GOTIFY_DEFAULTUSER_PASS_FILE",
    "fileId": "admin-password"
  },
  "defaults": {
    "hostIp": "127.0.0.1",
    "publishedPort": 8080,
    "dataDirectoryName": "gotify"
  },
  "storage": {
    "filesystem": "local-posix-locks",
    "minimumFreeBytes": 1073741824
  },
  "acceptance": [
    {
      "id": "admin-login",
      "method": "api",
      "description": "Verify the exact saved admin password against Gotify 3.1.1 GET /current/user and confirm the returned user is admin."
    },
    {
      "id": "application-token",
      "method": "api",
      "description": "Create one project-specific application and persist its one-time token privately; an ambiguous create outcome requires inspection, never a blind retry."
    },
    {
      "id": "notification-round-trip",
      "method": "browser",
      "description": "After separate approval, send one synthetic push with the saved application token and confirm a selected Gotify client receives it."
    },
    {
      "id": "restart-persistence",
      "method": "persisted",
      "description": "Restart this exact Compose project and confirm the admin login, application, saved token, and notification data remain available."
    }
  ]
}

{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "keycloak",
  "source": "https://www.keycloak.org/server/containers",
  "services": [
    {
      "id": "keycloak",
      "purpose": "Runs a loopback-only Keycloak identity service for private onboarding; public SSO requires separate TLS and hostname review.",
      "imageTag": "quay.io/keycloak/keycloak:26.7.4",
      "imageSource": "https://www.keycloak.org/getting-started/getting-started-docker",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://www.keycloak.org/server/containers", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "command": ["start", "--http-enabled=true", "--hostname=localhost", "--db=postgres", "--db-url-host=db", "--db-username=keycloak"],
      "environment": [{ "name": "KC_BOOTSTRAP_ADMIN_USERNAME", "value": "admin" }],
      "hostEnvironment": [],
      "fileEnvironment": [],
      "secretEnvironment": [
        { "name": "KC_BOOTSTRAP_ADMIN_PASSWORD", "fileId": "admin-password" },
        { "name": "KC_DB_PASSWORD", "fileId": "database-password" }
      ],
      "mounts": [],
      "dependsOn": [{ "service": "db", "condition": "service_healthy" }],
      "publishTargetPort": 8080
    },
    {
      "id": "db",
      "purpose": "Stores Keycloak realms and accounts in a private project-owned PostgreSQL volume.",
      "imageTag": "docker.io/library/postgres:17-alpine",
      "imageSource": "https://hub.docker.com/_/postgres",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://hub.docker.com/_/postgres", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [{ "name": "POSTGRES_DB", "value": "keycloak" }, { "name": "POSTGRES_USER", "value": "keycloak" }],
      "hostEnvironment": [],
      "fileEnvironment": [{ "name": "POSTGRES_PASSWORD_FILE", "fileId": "database-password" }],
      "mounts": [{ "name": "database", "target": "/var/lib/postgresql/data", "kind": "volume" }],
      "healthcheck": { "test": ["CMD", "pg_isready", "-U", "keycloak", "-d", "keycloak"], "intervalSeconds": 5, "timeoutSeconds": 5, "startPeriodSeconds": 0, "retries": 10 },
      "dependsOn": [],
      "publishTargetPort": null
    }
  ],
  "privateFiles": [
    { "id": "admin-password", "bytes": 48, "format": "alphanumeric" },
    { "id": "database-password", "bytes": 48, "format": "alphanumeric" }
  ],
  "onboarding": {
    "kind": "initial-admin-from-secret-env",
    "officialUrl": "https://www.keycloak.org/server/containers",
    "username": "admin",
    "usernameEnvironment": "KC_BOOTSTRAP_ADMIN_USERNAME",
    "secretEnvironment": "KC_BOOTSTRAP_ADMIN_PASSWORD",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 8080, "dataDirectoryName": "keycloak" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "admin-auth", "method": "api", "description": "Use the saved administrator password for Keycloak's documented admin-cli token flow, then read the master realm through the protected Admin REST API." },
    { "id": "production-edge", "method": "browser", "description": "Separately approve and verify a production hostname, TLS, trusted reverse-proxy configuration, and restricted administrator exposure before using this as an identity provider." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart the exact owned project and verify saved administrator access and realm data persist." },
    { "id": "isolated-restore", "method": "persisted", "description": "Restore PostgreSQL in isolation before claiming backup verification." }
  ]
}

{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "renovate",
  "source": "https://docs.renovatebot.com/getting-started/running/",
  "execution": { "kind": "manual-job", "officialUrl": "https://docs.renovatebot.com/getting-started/running/", "probe": { "argv": ["renovate", "--version"], "officialUrl": "https://github.com/renovatebot/renovate/releases/tag/44.132.2" } },
  "services": [{
    "id": "renovate",
    "purpose": "Prepares an inert dependency-update CLI; only a version probe is bundled, with no repository discovery or PR execution.",
    "imageTag": "ghcr.io/renovatebot/renovate:44.132.2",
    "imageSource": "https://docs.renovatebot.com/getting-started/running/",
    "user": "image-default",
    "imageUserEvidence": { "officialUrl": "https://docs.renovatebot.com/getting-started/running/", "reason": "official-image-runtime-contract" },
    "restart": "no",
    "readOnly": false,
    "command": ["renovate", "--version"],
    "environment": [{ "name": "RENOVATE_AUTODISCOVER", "value": "false" }],
    "hostEnvironment": [],
    "fileEnvironment": [],
    "secretEnvironment": [{ "name": "RENOVATE_TOKEN", "fileId": "forge-token", "format": "owner-token", "officialUrl": "https://docs.renovatebot.com/modules/platform/forgejo/" }],
    "mounts": [],
    "dependsOn": [],
    "publishTargetPort": null
  }],
  "privateFiles": [{ "id": "forge-token", "source": "owner", "maxBytes": 4096 }],
  "onboarding": { "kind": "job-credentials", "officialUrl": "https://docs.renovatebot.com/modules/platform/forgejo/" },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": null, "dataDirectoryName": "renovate" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "manual-version", "method": "job", "description": "After separate exact job approval, renovate --version exits zero with the pinned version. This does not verify the owner-issued token, repositories, or remote scopes." },
    { "id": "repository-scope", "method": "persisted", "description": "Before any update run, separately review the exact forge endpoint and repository allowlist, verify minimum-scope owner-issued credentials, and approve remote writes. No update or scheduler is bundled." }
  ]
}

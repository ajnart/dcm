{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "slskd",
  "source": "https://github.com/slskd/slskd/blob/master/docs/docker.md",
  "services": [{
    "id": "slskd",
    "purpose": "Runs the owner's Soulseek client with a private Web UI and selected download storage.",
    "imageTag": "ghcr.io/slskd/slskd:0.26.0.65534-e3d377d4",
    "imageSource": "https://github.com/slskd/slskd/pkgs/container/slskd",
    "user": "host-selected",
    "imageUserEvidence": { "officialUrl": "https://github.com/slskd/slskd/blob/master/docs/docker.md", "reason": "official-image-runtime-contract" },
    "restart": "unless-stopped",
    "readOnly": false,
    "environment": [
      { "name": "SLSKD_USERNAME", "value": "admin" },
      { "name": "SLSKD_DOWNLOADS_DIR", "value": "/downloads" }
    ],
    "hostEnvironment": [],
    "fileEnvironment": [],
    "secretEnvironment": [
      { "name": "SLSKD_PASSWORD", "fileId": "admin-password" },
      { "name": "SLSKD_API_KEY", "fileId": "slskd-api-key" }
    ],
    "mounts": [
      { "name": "app", "target": "/app", "kind": "bind", "readOnly": false },
      { "name": "media-data", "target": "/downloads", "kind": "bind", "hostPath": true, "readOnly": false, "shareGroup": "media-data" }
    ],
    "dependsOn": [],
    "publishTargetPort": 5030,
    "additionalPorts": [{ "id": "soulseek-peer", "targetPort": 50300, "protocol": "tcp", "purpose": "application", "required": false }]
  }],
  "privateFiles": [
    { "id": "admin-password", "bytes": 48, "format": "alphanumeric" },
    { "id": "slskd-api-key", "bytes": 48, "format": "alphanumeric" }
  ],
  "onboarding": {
    "kind": "initial-admin-from-secret-env",
    "officialUrl": "https://github.com/slskd/slskd/blob/0.26.0/docs/config.md",
    "username": "admin",
    "usernameEnvironment": "SLSKD_USERNAME",
    "secretEnvironment": "SLSKD_PASSWORD",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 5030, "dataDirectoryName": "slskd" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 10737418240 },
  "acceptance": [
    { "id": "web-auth", "method": "api", "description": "Authenticate to the exact private origin with the generated administrator credential and verify an authenticated session read." },
    { "id": "api-key", "method": "api", "description": "Verify the generated primary API key against an authenticated session read and hand it off privately." },
    { "id": "soulseek-account", "method": "browser", "description": "With owner-supplied Soulseek credentials, verify protocol login and explicitly approved peer ingress before any authorized transfer." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart only this owned project and verify administrator login, API key, configuration and selected download path persist." }
  ]
}

{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "sabnzbd",
  "source": "https://docs.linuxserver.io/images/docker-sabnzbd/",
  "services": [
    {
      "id": "sabnzbd",
      "purpose": "Downloads authorized Usenet files from an owner-provided provider into the selected shared data path.",
      "imageTag": "linuxserver/sabnzbd:version-5.1.3",
      "imageSource": "https://hub.docker.com/r/linuxserver/sabnzbd/tags",
      "user": "image-default",
      "imageUserEvidence": {
        "officialUrl": "https://docs.linuxserver.io/images/docker-sabnzbd/",
        "reason": "official-image-runtime-contract"
      },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [],
      "hostEnvironment": [
        { "name": "PUID", "source": "uid" },
        { "name": "PGID", "source": "gid" },
        { "name": "TZ", "source": "timezone" }
      ],
      "fileEnvironment": [],
      "mounts": [
        { "name": "config", "target": "/config", "kind": "volume" },
        { "name": "media-data", "target": "/data", "kind": "bind", "hostPath": true, "readOnly": false, "shareGroup": "media-data" }
      ],
      "dependsOn": [],
      "publishTargetPort": 8080
    }
  ],
  "privateFiles": [
    { "id": "admin-password", "bytes": 48, "format": "alphanumeric" }
  ],
  "onboarding": {
    "kind": "manual-first-admin",
    "officialUrl": "https://sabnzbd.org/wiki/configuration/5.1/general",
    "username": "admin",
    "fileId": "admin-password"
  },
  "defaults": {
    "hostIp": "127.0.0.1",
    "publishedPort": 8080,
    "dataDirectoryName": "sabnzbd"
  },
  "storage": {
    "filesystem": "local-posix-locks",
    "minimumFreeBytes": 10737418240
  },
  "acceptance": [
    { "id": "private-api-key", "method": "api", "description": "Read the freshly generated API key from the owned config file, save it privately, and verify a scoped authenticated API read." },
    { "id": "admin-login", "method": "api", "description": "Set the generated WebUI administrator credential through the private form API and verify login without exposing the API key in a URL." },
    { "id": "download-paths", "method": "api", "description": "Set and read back owner-approved incomplete and complete directories under the one shared /data mount." },
    { "id": "provider-choice", "method": "api", "description": "Configure and test only the Usenet provider supplied by the owner; no server account or content is selected automatically." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart only this owned unit and verify its saved login, API key, provider settings, and path configuration." }
  ]
}

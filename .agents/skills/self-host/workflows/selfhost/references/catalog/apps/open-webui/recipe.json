{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "open-webui",
  "source": "https://docs.openwebui.com/getting-started/quick-start/",
  "services": [{
    "id": "open-webui",
    "purpose": "Hosts private AI conversations and connects to an explicitly selected model provider.",
    "imageTag": "ghcr.io/open-webui/open-webui:v0.11.4",
    "imageSource": "https://github.com/open-webui/open-webui/releases/tag/v0.11.4",
    "user": "image-default",
    "imageUserEvidence": { "officialUrl": "https://docs.openwebui.com/getting-started/quick-start/", "reason": "official-image-runtime-contract" },
    "restart": "always",
    "readOnly": false,
    "environment": [{ "name": "WEBUI_ADMIN_EMAIL", "value": "admin@example.test" }],
    "hostEnvironment": [],
    "fileEnvironment": [],
    "secretEnvironment": [
      { "name": "WEBUI_ADMIN_PASSWORD", "fileId": "admin-password" },
      { "name": "WEBUI_SECRET_KEY", "fileId": "webui-secret-key" }
    ],
    "mounts": [{ "name": "appdata", "target": "/app/backend/data", "kind": "volume" }],
    "dependsOn": [],
    "publishTargetPort": 8080
  }],
  "privateFiles": [
    { "id": "admin-password", "bytes": 48, "format": "alphanumeric" },
    { "id": "webui-secret-key", "bytes": 32, "format": "hex" }
  ],
  "onboarding": {
    "kind": "initial-admin-email-from-secret-env",
    "officialUrl": "https://docs.openwebui.com/features/authentication-access/rbac/roles/",
    "email": "admin@example.test",
    "emailEnvironment": "WEBUI_ADMIN_EMAIL",
    "secretEnvironment": "WEBUI_ADMIN_PASSWORD",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 8080, "dataDirectoryName": "open-webui" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "admin-login", "method": "api", "description": "Verify the saved first administrator signs in with email admin@example.test and role admin on the exact private origin." },
    { "id": "api-key", "method": "api", "description": "When integration-access=enabled, approve global API-key access, preserve unrelated policy, then retain or create one owner key. Save and verify it against the same admin. Serialize policy/key writes; key POST replaces an existing key." },
    { "id": "model-provider", "method": "browser", "description": "Configure and check only the explicitly selected model provider; a running chat UI does not prove model access." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart the exact owned project and verify administrator login, chats, and selected provider remain available." }
  ]
}

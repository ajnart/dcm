{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "bazarr",
  "source": "https://docs.linuxserver.io/images/docker-bazarr/",
  "services": [
    {
      "id": "bazarr",
      "purpose": "Manages subtitles for owner-approved Sonarr and Radarr media; providers and Arr connections remain unconfigured.",
      "imageTag": "lscr.io/linuxserver/bazarr:version-v1.6.0",
      "imageSource": "https://github.com/linuxserver/docker-bazarr/pkgs/container/bazarr/versions",
      "user": "image-default",
      "imageUserEvidence": {
        "officialUrl": "https://docs.linuxserver.io/images/docker-bazarr/",
        "reason": "official-image-runtime-contract"
      },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [],
      "hostEnvironment": [
        { "name": "PUID", "source": "uid" },
        { "name": "PGID", "source": "gid" },
        { "name": "TZ", "source": "timezone" }
      ],
      "fileEnvironment": [],
      "mounts": [
        { "name": "config", "target": "/config", "kind": "volume" },
        { "name": "media-data", "target": "/data", "kind": "bind", "hostPath": true, "readOnly": false, "shareGroup": "media-data" }
      ],
      "dependsOn": [],
      "publishTargetPort": 6767
    }
  ],
  "privateFiles": [
    { "id": "admin-password", "bytes": 48, "format": "alphanumeric" }
  ],
  "onboarding": {
    "kind": "manual-first-admin",
    "officialUrl": "https://docs.linuxserver.io/images/docker-bazarr/",
    "username": "admin",
    "fileId": "admin-password"
  },
  "defaults": {
    "hostIp": "127.0.0.1",
    "publishedPort": 6767,
    "dataDirectoryName": "bazarr"
  },
  "storage": {
    "filesystem": "local-posix-locks",
    "minimumFreeBytes": 1073741824
  },
  "acceptance": [
    { "id": "first-run-login", "method": "api", "description": "Save the generated API key, configure Basic authentication with the saved administrator password, then verify API-key settings readback, successful Basic GET /, and anonymous GET / denied." },
    { "id": "arr-connections", "method": "browser", "description": "Add authorized Sonarr and Radarr connections and verify exact /data path mappings before subtitle writes." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart this exact project and verify login, Arr connections, and subtitle access persist." }
  ]
}

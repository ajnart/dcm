{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "homarr",
  "source": "https://github.com/homarr-labs/homarr",
  "services": [
    {
      "id": "homarr",
      "purpose": "Shows the dashboard, app links, integrations, and API-backed control surface.",
      "imageTag": "ghcr.io/homarr-labs/homarr:dev",
      "imageSource": "https://github.com/homarr-labs/homarr/pkgs/container/homarr",
      "user": "image-default",
      "imageUserEvidence": {
        "officialUrl": "https://v2.preview.homarr.dev/docs/getting-started/installation/docker/",
        "reason": "official-image-runtime-contract"
      },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [],
      "hostEnvironment": [],
      "fileEnvironment": [
        { "name": "SECRET_ENCRYPTION_KEY_FILE", "fileId": "encryption-key" }
      ],
      "mounts": [
        { "name": "appdata", "target": "/appdata" }
      ],
      "dependsOn": [],
      "publishTargetPort": 7575
    }
  ],
  "privateFiles": [
    { "id": "encryption-key", "bytes": 32, "format": "hex" },
    { "id": "admin-password", "bytes": 48 }
  ],
  "onboarding": {
    "kind": "manual-first-admin",
    "officialUrl": "https://v2.preview.homarr.dev/docs/getting-started/after-the-installation/",
    "username": "admin",
    "fileId": "admin-password"
  },
  "defaults": {
    "hostIp": "127.0.0.1",
    "publishedPort": 7575,
    "dataDirectoryName": "homarr"
  },
  "storage": {
    "filesystem": "local-posix-locks",
    "minimumFreeBytes": 1073741824
  },
  "acceptance": [
    { "id": "first-account", "method": "api", "description": "Sign in with the saved administrator password and verify the account through the private API." },
    { "id": "board-readback", "method": "api", "description": "Read back the finished board, Notebook summary, and selected app links without assuming setup success proves them." },
    { "id": "integration-readback", "method": "api", "description": "Check each selected integration connection and its widget data separately from onboarding." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart this exact project and confirm the administrator, board, and integrations remain available." }
  ]
}

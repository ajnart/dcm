{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "lidarr",
  "source": "https://docs.linuxserver.io/images/docker-lidarr/",
  "services": [
    {
      "id": "lidarr",
      "purpose": "Manages music releases and imports using owner-selected paths; it does not provide an indexer or downloader.",
      "imageTag": "lscr.io/linuxserver/lidarr:version-3.1.0.4875",
      "imageSource": "https://github.com/linuxserver/docker-lidarr/pkgs/container/lidarr/versions",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://docs.linuxserver.io/images/docker-lidarr/", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [],
      "hostEnvironment": [ { "name": "PUID", "source": "uid" }, { "name": "PGID", "source": "gid" }, { "name": "TZ", "source": "timezone" } ],
      "fileEnvironment": [],
      "mounts": [
        { "name": "config", "target": "/config", "kind": "volume" },
        { "name": "media-data", "target": "/data", "kind": "bind", "hostPath": true, "readOnly": false, "shareGroup": "media-data" }
      ],
      "dependsOn": [],
      "publishTargetPort": 8686
    }
  ],
  "privateFiles": [ { "id": "admin-password", "bytes": 48, "format": "alphanumeric" } ],
  "onboarding": { "kind": "manual-first-admin", "officialUrl": "https://wiki.servarr.com/lidarr/settings", "username": "admin", "fileId": "admin-password" },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 8686, "dataDirectoryName": "lidarr" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "administrator", "method": "api", "description": "Use the candidate shared adapter to set required Forms authentication, save the private API key, and verify the generated administrator login; fresh-image behavior remains unverified." },
    { "id": "music-import-path", "method": "browser", "description": "Configure and verify the selected music root and downloader paths under the same /data mount." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart this exact project and verify login, music root and downloader connection." }
  ]
}

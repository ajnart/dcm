{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "navidrome",
  "source": "https://www.navidrome.org/docs/installation/docker/",
  "services": [
    {
      "id": "navidrome",
      "purpose": "Streams the owner's selected, read-only music library from a private web interface.",
      "imageTag": "deluan/navidrome:0.64.0",
      "imageSource": "https://hub.docker.com/r/deluan/navidrome/tags",
      "user": "host-selected",
      "imageUserEvidence": { "officialUrl": "https://www.navidrome.org/docs/installation/docker/", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [],
      "hostEnvironment": [],
      "fileEnvironment": [],
      "mounts": [
        { "name": "data", "target": "/data", "kind": "bind", "readOnly": false },
        { "name": "music", "target": "/music", "kind": "bind", "hostPath": true, "readOnly": true, "shareGroup": "media-data" }
      ],
      "dependsOn": [],
      "publishTargetPort": 4533
    }
  ],
  "privateFiles": [ { "id": "admin-password", "bytes": 48, "format": "alphanumeric" } ],
  "onboarding": { "kind": "manual-first-admin", "officialUrl": "https://navidrome.org/docs/usage/admin/cli/user/", "username": "admin", "fileId": "admin-password" },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 4533, "dataDirectoryName": "navidrome" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "administrator", "method": "api", "description": "Create the first administrator once through the pinned v0.64.0 UI route, then verify the saved credential with a fresh admin login; ambiguous creation is never retried." },
    { "id": "music-library", "method": "browser", "description": "Confirm the selected read-only /music path is visible and a tagged test track scans and plays." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart only this owned project and verify administrator login and library playback again." }
  ]
}

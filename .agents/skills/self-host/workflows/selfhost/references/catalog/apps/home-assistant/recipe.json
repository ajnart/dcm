{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "home-assistant",
  "source": "https://www.home-assistant.io/installation/linux/",
  "services": [{
    "id": "home-assistant",
    "purpose": "Serves the private Home Assistant web UI; LAN discovery and device access are not enabled.",
    "imageTag": "ghcr.io/home-assistant/home-assistant:2026.9.3",
    "imageSource": "https://www.home-assistant.io/common-tasks/container/",
    "user": "image-default",
    "imageUserEvidence": { "officialUrl": "https://www.home-assistant.io/installation/linux/", "reason": "official-image-runtime-contract" },
    "restart": "unless-stopped",
    "readOnly": false,
    "environment": [],
    "hostEnvironment": [{ "name": "TZ", "source": "timezone" }],
    "fileEnvironment": [],
    "mounts": [{ "name": "config", "target": "/config", "kind": "volume" }],
    "dependsOn": [],
    "publishTargetPort": 8123
  }],
  "privateFiles": [{ "id": "admin-password", "bytes": 48, "format": "alphanumeric" }],
  "onboarding": {
    "kind": "manual-first-admin",
    "officialUrl": "https://raw.githubusercontent.com/home-assistant/core/2026.9.3/homeassistant/components/onboarding/views.py",
    "username": "admin",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 8123, "dataDirectoryName": "home-assistant" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "first-admin", "method": "api", "description": "Create the first owner through the pinned onboarding API, independently verify its password and current owner role, then checkpoint, privately save and verify one long-lived integration token." },
    { "id": "frontend", "method": "browser", "description": "Open the UI through an approved private route; loopback access alone does not establish LAN discovery or device access." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart the exact owned Compose project and verify the saved administrator credential and configuration persist." }
  ]
}

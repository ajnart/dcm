{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "photoprism",
  "source": "https://docs.photoprism.app/getting-started/docker-compose/",
  "services": [{
    "id": "photoprism",
    "purpose": "Indexes and serves a private photo library using a local SQLite database.",
    "imageTag": "docker.io/photoprism/photoprism:260728",
    "imageSource": "https://hub.docker.com/r/photoprism/photoprism/tags?name=260728",
    "user": "image-default",
    "imageUserEvidence": { "officialUrl": "https://dl.photoprism.app/docker/compose.yaml", "reason": "official-image-runtime-contract" },
    "restart": "unless-stopped",
    "readOnly": false,
    "environment": [{ "name": "PHOTOPRISM_ADMIN_USER", "value": "admin" }, { "name": "PHOTOPRISM_DATABASE_DRIVER", "value": "sqlite" }],
    "hostEnvironment": [],
    "fileEnvironment": [],
    "secretEnvironment": [{ "name": "PHOTOPRISM_ADMIN_PASSWORD", "fileId": "admin-password" }],
    "mounts": [
      { "name": "originals", "target": "/photoprism/originals", "kind": "bind", "readOnly": false },
      { "name": "storage", "target": "/photoprism/storage", "kind": "bind", "readOnly": false }
    ],
    "dependsOn": [],
    "publishTargetPort": 2342
  }],
  "privateFiles": [{ "id": "admin-password", "bytes": 48, "format": "alphanumeric" }],
  "onboarding": {
    "kind": "initial-admin-from-secret-env",
    "officialUrl": "https://docs.photoprism.app/getting-started/config-options/",
    "username": "admin",
    "usernameEnvironment": "PHOTOPRISM_ADMIN_USER",
    "secretEnvironment": "PHOTOPRISM_ADMIN_PASSWORD",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 2342, "dataDirectoryName": "photoprism" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 10737418240 },
  "acceptance": [
    { "id": "admin-login", "method": "api", "description": "Verify the generated administrator password by creating a session on the exact private origin." },
    { "id": "photo-roundtrip", "method": "api", "description": "Upload, index, retrieve, and compare an authorized harmless photo." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart this exact owned project and confirm the administrator and indexed photo remain available." }
  ]
}

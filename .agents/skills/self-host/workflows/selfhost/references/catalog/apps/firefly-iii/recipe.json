{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "firefly-iii",
  "source": "https://github.com/firefly-iii/docker/blob/main/docker-compose.yml",
  "services": [
    {
      "id": "firefly-iii",
      "purpose": "Keeps a private personal-finance ledger and serves the Firefly III interface.",
      "imageTag": "fireflyiii/core:version-6.7.2",
      "imageSource": "https://github.com/firefly-iii/firefly-iii/releases/tag/v6.7.2",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://github.com/firefly-iii/docker/blob/main/docker-compose.yml", "reason": "official-image-runtime-contract" },
      "restart": "always",
      "readOnly": false,
      "environment": [
        { "name": "APP_ENV", "value": "production" },
        { "name": "APP_DEBUG", "value": "false" },
        { "name": "DB_CONNECTION", "value": "pgsql" },
        { "name": "DB_HOST", "value": "db" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_DATABASE", "value": "firefly" },
        { "name": "DB_USERNAME", "value": "firefly" }
      ],
      "hostEnvironment": [{ "name": "TZ", "source": "timezone" }],
      "derivedEnvironment": [{ "name": "APP_URL", "source": "local-origin" }],
      "fileEnvironment": [
        { "name": "APP_KEY_FILE", "fileId": "application-key" },
        { "name": "DB_PASSWORD_FILE", "fileId": "database-password" },
        { "name": "STATIC_CRON_TOKEN_FILE", "fileId": "cron-token" }
      ],
      "mounts": [{ "name": "uploads", "target": "/var/www/html/storage/upload", "kind": "volume" }],
      "dependsOn": ["db"],
      "publishTargetPort": 8080
    },
    {
      "id": "db",
      "purpose": "Stores private financial records and the Firefly III owner account.",
      "imageTag": "docker.io/library/postgres:18",
      "imageSource": "https://hub.docker.com/_/postgres",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://hub.docker.com/_/postgres", "reason": "official-image-runtime-contract" },
      "restart": "always",
      "readOnly": false,
      "environment": [
        { "name": "POSTGRES_DB", "value": "firefly" },
        { "name": "POSTGRES_USER", "value": "firefly" }
      ],
      "hostEnvironment": [],
      "fileEnvironment": [{ "name": "POSTGRES_PASSWORD_FILE", "fileId": "database-password" }],
      "mounts": [{ "name": "database", "target": "/var/lib/postgresql", "kind": "volume" }],
      "dependsOn": [],
      "publishTargetPort": null
    }
  ],
  "privateFiles": [
    { "id": "application-key", "bytes": 32, "format": "alphanumeric" },
    { "id": "database-password", "bytes": 48, "format": "alphanumeric" },
    { "id": "cron-token", "bytes": 32, "format": "alphanumeric" },
    { "id": "admin-password", "bytes": 48, "format": "alphanumeric" }
  ],
  "onboarding": {
    "kind": "manual-first-email",
    "officialUrl": "https://github.com/firefly-iii/docs/blob/main/docs/docs/how-to/firefly-iii/features/multi-user.md",
    "email": "admin@example.test",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 8080, "dataDirectoryName": "firefly-iii" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 5368709120 },
  "acceptance": [
    { "id": "first-owner", "method": "api", "description": "Register the fixed admin@example.test first owner through the pinned private HTTP form, then verify saved-password login and owner identity. Replace the example address with a real recovery email through a separate reviewed account change." },
    { "id": "api-token", "method": "api", "description": "Create one checkpointed personal token through the pinned authenticated route, save its one-time value privately, and verify its owner identity through the API. A lost creation response needs inspection, not retry." },
    { "id": "ledger-roundtrip", "method": "browser", "description": "Create and read back one harmless finance record on the private origin." },
    { "id": "scheduled-jobs", "method": "api", "description": "Configure and verify a private cron caller using the generated 32-character token; this recipe does not deploy the upstream cron service." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart the exact Compose project and confirm owner login, records, and uploads persist." }
  ]
}

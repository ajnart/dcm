{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "prometheus",
  "source": "https://prometheus.io/docs/prometheus/latest/installation/",
  "services": [
    {
      "id": "prometheus",
      "purpose": "Serves a private metrics query endpoint with persistent time-series storage and the image's sample scrape configuration.",
      "imageTag": "prom/prometheus:v3.15.0",
      "imageSource": "https://prometheus.io/docs/prometheus/latest/installation/",
      "user": "image-default",
      "imageUserEvidence": {
        "officialUrl": "https://prometheus.io/docs/prometheus/latest/installation/",
        "reason": "official-image-runtime-contract"
      },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [],
      "hostEnvironment": [],
      "fileEnvironment": [],
      "mounts": [{ "name": "data", "target": "/prometheus", "kind": "volume" }],
      "dependsOn": [],
      "publishTargetPort": 9090
    }
  ],
  "privateFiles": [],
  "onboarding": {
    "kind": "no-account",
    "officialUrl": "https://prometheus.io/docs/prometheus/latest/management_api/"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 9090, "dataDirectoryName": "prometheus" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "ready", "method": "api", "description": "Confirm /-/ready responds 200 and build information matches pinned Prometheus 3.15.0." },
    { "id": "scrape-targets", "method": "api", "description": "After separate configuration approval, verify the intended scrape targets and collected series." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart the exact owned project and verify retained time series remain queryable." }
  ]
}

{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "patchmon",
  "source": "https://github.com/PatchMon/PatchMon/blob/v2.1.3/docker/docker-compose.yml",
  "services": [
    {
      "id": "patchmon",
      "purpose": "Serves the private PatchMon dashboard; host enrollment and patch execution require separate approval.",
      "imageTag": "ghcr.io/patchmon/patchmon-server:2.1.3",
      "imageSource": "https://github.com/PatchMon/PatchMon/releases/tag/v2.1.3",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://github.com/PatchMon/PatchMon/blob/v2.1.3/docker/docker-compose.yml", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [
        { "name": "APP_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        { "name": "POD_ID", "value": "patchmon-server" },
        { "name": "REDIS_HOST", "value": "redis" },
        { "name": "REDIS_PORT", "value": "6379" },
        { "name": "REDIS_DB", "value": "0" },
        { "name": "GUACD_ADDRESS", "value": "guacd:4822" }
      ],
      "hostEnvironment": [],
      "derivedEnvironment": [{ "name": "CORS_ORIGIN", "source": "local-origin" }],
      "fileEnvironment": [],
      "secretEnvironment": [
        { "name": "DATABASE_URL", "fileId": "database-password", "format": "postgres-url", "username": "patchmon_user", "host": "database", "port": 5432, "database": "patchmon_db" },
        { "name": "REDIS_PASSWORD", "fileId": "redis-password" },
        { "name": "JWT_SECRET", "fileId": "jwt-secret" },
        { "name": "SESSION_SECRET", "fileId": "session-secret" },
        { "name": "AI_ENCRYPTION_KEY", "fileId": "ai-encryption-key" }
      ],
      "mounts": [],
      "dependsOn": [{ "service": "database", "condition": "service_healthy" }, "redis", { "service": "guacd", "condition": "service_healthy" }],
      "publishTargetPort": 3000
    },
    {
      "id": "database",
      "purpose": "Stores dashboard accounts and inventory on the private PatchMon network.",
      "imageTag": "docker.io/library/postgres:17-alpine",
      "imageSource": "https://github.com/PatchMon/PatchMon/blob/v2.1.3/docker/docker-compose.yml",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://hub.docker.com/_/postgres", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [{ "name": "POSTGRES_USER", "value": "patchmon_user" }, { "name": "POSTGRES_DB", "value": "patchmon_db" }],
      "hostEnvironment": [],
      "fileEnvironment": [{ "name": "POSTGRES_PASSWORD_FILE", "fileId": "database-password" }],
      "mounts": [{ "name": "database", "target": "/var/lib/postgresql/data", "kind": "volume" }],
      "healthcheck": { "test": ["CMD", "pg_isready", "-U", "patchmon_user", "-d", "patchmon_db"], "intervalSeconds": 3, "timeoutSeconds": 5, "startPeriodSeconds": 0, "retries": 7 },
      "dependsOn": [],
      "publishTargetPort": null
    },
    {
      "id": "redis",
      "purpose": "Stores private authenticated PatchMon queues and agent presence, without exposing Redis to the host.",
      "imageTag": "docker.io/library/redis:7.4-alpine",
      "imageSource": "https://github.com/redis/docker-library-redis/blob/master/7.4/alpine/Dockerfile",
      "user": "host-selected",
      "imageUserEvidence": { "officialUrl": "https://github.com/redis/docker-library-redis/blob/master/7.4/alpine/docker-entrypoint.sh", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "command": ["redis-server", "/run/secrets/redis-config"],
      "environment": [],
      "hostEnvironment": [],
      "fileEnvironment": [],
      "privateConfigFiles": ["redis-config"],
      "mounts": [{ "name": "redis", "target": "/data", "kind": "bind" }],
      "dependsOn": [],
      "publishTargetPort": null
    },
    {
      "id": "guacd",
      "purpose": "Provides an unpublished Guacamole daemon for separately approved remote desktop sessions.",
      "imageTag": "guacamole/guacd:1.6.0",
      "imageSource": "https://github.com/PatchMon/PatchMon/blob/v2.1.3/docker/docker-compose.yml",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://github.com/PatchMon/PatchMon/blob/v2.1.3/docker/docker-compose.yml", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": true,
      "capDrop": ["ALL"],
      "memoryLimitBytes": 536870912,
      "cpuLimit": 1,
      "tmpfs": [{ "target": "/tmp", "sizeBytes": 67108864, "mode": 1023 }],
      "environment": [],
      "hostEnvironment": [],
      "fileEnvironment": [],
      "mounts": [],
      "healthcheck": { "test": ["CMD", "nc", "-z", "localhost", "4822"], "intervalSeconds": 10, "timeoutSeconds": 5, "startPeriodSeconds": 10, "retries": 3 },
      "dependsOn": [],
      "publishTargetPort": null
    }
  ],
  "privateFiles": [
    { "id": "database-password", "bytes": 32, "format": "hex" },
    { "id": "redis-password", "bytes": 32, "format": "hex" },
    { "id": "jwt-secret", "bytes": 64, "format": "hex" },
    { "id": "session-secret", "bytes": 64, "format": "hex" },
    { "id": "ai-encryption-key", "bytes": 64, "format": "hex" },
    { "id": "admin-password", "bytes": 32, "format": "base64-prefixed" }
  ],
  "privateConfigs": [{ "id": "redis-config", "officialUrl": "https://redis.io/docs/latest/operate/oss_and_stack/management/config/", "parts": [{ "literal": "bind 0.0.0.0\nprotected-mode yes\ndir /data\nrequirepass " }, { "fileId": "redis-password" }, { "literal": "\n" }] }],
  "onboarding": { "kind": "manual-first-admin", "officialUrl": "https://github.com/PatchMon/PatchMon/blob/v2.1.3/server-source-code/internal/handler/auth.go", "username": "admin", "fileId": "admin-password" },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 3000, "dataDirectoryName": "patchmon" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "administrator", "method": "api", "description": "Inspect first-admin state, create the saved owner once, then authenticate and read back the exact active superadmin identity." },
    { "id": "private-dashboard", "method": "browser", "description": "Verify the dashboard on the exact reviewed loopback origin; another browser-facing URL needs separate CORS and access review." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart only this exact project and prove the saved administrator and PostgreSQL inventory persist." },
    { "id": "host-enrollment", "method": "api", "description": "Enroll one explicitly approved host and verify current inventory before claiming monitoring; dashboard setup grants no agent or patch authority." }
  ]
}

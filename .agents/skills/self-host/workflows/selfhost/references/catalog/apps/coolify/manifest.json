  "lifecycle": {
    "status": "active",
    "checkedAt": "2026-10-03",
    "note": "Pinned four-service administration-only candidate with actual first-root HTTP registration and read-only API token handling. Horizon/scheduler workers remain disabled in both the environment and their literal .env policy; no host SSH key, Docker socket or gateway is granted. Live first-run, replay and restart acceptance remain unverified; useful host management requires separate authority."
  },
  "support": {
    "automation": "guided",
    "tier": "T1",
    "adapterSkill": null
  },

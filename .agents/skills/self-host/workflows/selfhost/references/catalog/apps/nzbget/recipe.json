{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "nzbget",
  "source": "https://github.com/nzbgetcom/nzbget/blob/develop/docker/README.md",
  "services": [{
    "id": "nzbget",
    "purpose": "Downloads authorized Usenet content from an owner-supplied provider into the shared data path.",
    "imageTag": "ghcr.io/nzbgetcom/nzbget:v26.3",
    "imageSource": "https://github.com/nzbgetcom/nzbget/pkgs/container/nzbget/versions",
    "user": "image-default",
    "imageUserEvidence": { "officialUrl": "https://github.com/nzbgetcom/nzbget/blob/develop/docker/README.md", "reason": "official-image-runtime-contract" },
    "hostIdentityEvidence": "https://github.com/nzbgetcom/nzbget/blob/develop/docker/README.md",
    "restart": "unless-stopped",
    "readOnly": false,
    "environment": [{ "name": "NZBGET_USER", "value": "admin" }],
    "hostEnvironment": [{ "name": "PUID", "source": "uid" }, { "name": "PGID", "source": "gid" }, { "name": "TZ", "source": "timezone" }],
    "fileEnvironment": [],
    "secretEnvironment": [{ "name": "NZBGET_PASS", "fileId": "admin-password" }],
    "mounts": [
      { "name": "config", "target": "/config", "kind": "volume" },
      { "name": "media-data", "target": "/downloads", "kind": "bind", "hostPath": true, "readOnly": false, "shareGroup": "media-data" }
    ],
    "dependsOn": [],
    "publishTargetPort": 6789
  }],
  "privateFiles": [{ "id": "admin-password", "bytes": 48, "format": "alphanumeric" }],
  "onboarding": {
    "kind": "initial-admin-from-secret-env",
    "officialUrl": "https://github.com/nzbgetcom/nzbget/blob/develop/docker/README.md",
    "username": "admin",
    "usernameEnvironment": "NZBGET_USER",
    "secretEnvironment": "NZBGET_PASS",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 6789, "dataDirectoryName": "nzbget" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 10737418240 },
  "acceptance": [
    { "id": "admin-rpc", "method": "api", "description": "Authenticate with the generated administrator credential over the exact private origin and read back the pinned NZBGet version." },
    { "id": "provider-and-downloads", "method": "api", "description": "Configure and test only the owner-approved Usenet provider and download paths under /downloads; no transfer is selected automatically." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart this exact owned unit and verify administrator login, provider settings, and download paths remain available." }
  ]
}

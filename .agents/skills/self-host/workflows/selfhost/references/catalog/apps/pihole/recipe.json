{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "pihole",
  "source": "https://github.com/pi-hole/docker-pi-hole/releases/tag/2026.09.0",
  "services": [{
    "id": "pihole",
    "purpose": "Provides a private Pi-hole administration interface; DNS is not published to the host or LAN.",
    "imageTag": "pihole/pihole:2026.09.0",
    "imageSource": "https://github.com/pi-hole/docker-pi-hole/releases/tag/2026.09.0",
    "user": "image-default",
    "imageUserEvidence": {
      "officialUrl": "https://docs.pi-hole.net/docker/",
      "reason": "official-image-runtime-contract"
    },
    "restart": "unless-stopped",
    "readOnly": false,
    "environment": [],
    "hostEnvironment": [{ "name": "TZ", "source": "timezone" }],
    "fileEnvironment": [{ "name": "WEBPASSWORD_FILE", "fileId": "admin-password" }],
    "mounts": [{ "name": "config", "target": "/etc/pihole", "kind": "volume" }],
    "dependsOn": [],
    "publishTargetPort": 80
  }],
  "privateFiles": [{ "id": "admin-password", "bytes": 48, "format": "alphanumeric" }],
  "onboarding": {
    "kind": "initial-password-from-file",
    "officialUrl": "https://docs.pi-hole.net/docker/configuration/",
    "fileEnvironment": "WEBPASSWORD_FILE",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 8080, "dataDirectoryName": "pihole" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "admin-session", "method": "api", "description": "Authenticate the generated password through POST /api/auth and read the version endpoint with the returned session on the exact private origin." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart only the owned Compose project and repeat the administrator API login; DNS acceptance remains separate." }
  ]
}

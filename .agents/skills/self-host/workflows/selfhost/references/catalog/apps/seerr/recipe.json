{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "seerr",
  "source": "https://docs.seerr.dev/getting-started/docker/",
  "services": [
    {
      "id": "seerr",
      "purpose": "Accepts requests for the owner's media library and coordinates approved movie and TV managers.",
      "imageTag": "ghcr.io/seerr-team/seerr:v3.5.0",
      "imageSource": "https://github.com/seerr-team/seerr/pkgs/container/seerr/versions",
      "user": "image-default",
      "imageUserEvidence": {
        "officialUrl": "https://docs.seerr.dev/getting-started/docker/",
        "reason": "official-image-runtime-contract"
      },
      "restart": "unless-stopped",
      "readOnly": false,
      "init": true,
      "environment": [],
      "hostEnvironment": [
        { "name": "TZ", "source": "timezone" }
      ],
      "fileEnvironment": [],
      "mounts": [
        { "name": "config", "target": "/app/config", "kind": "volume" }
      ],
      "dependsOn": [],
      "publishTargetPort": 5055
    }
  ],
  "privateFiles": [],
  "onboarding": {
    "kind": "external-first-admin",
    "officialUrl": "https://github.com/seerr-team/seerr/blob/v3.5.0/seerr-api.yml",
    "provider": "media-server",
    "providerAppId": "jellyfin"
  },
  "defaults": {
    "hostIp": "127.0.0.1",
    "publishedPort": 5055,
    "dataDirectoryName": "seerr"
  },
  "storage": {
    "filesystem": "local-posix-locks",
    "minimumFreeBytes": 1073741824
  },
  "acceptance": [
    { "id": "media-server-admin", "method": "api", "description": "Use an owner-selected, supported media-server administrator to create Seerr's first admin, then verify the saved session and account." },
    { "id": "media-libraries", "method": "api", "description": "Sync only owner-selected media libraries and read back their enabled state." },
    { "id": "arr-links", "method": "api", "description": "Test selected Sonarr and Radarr endpoints with their saved keys, save the chosen roots and profiles, then read back both links." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart the exact owned Seerr unit and verify its administrator session, libraries, and selected Arr links persist." }
  ]
}

{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "docmost",
  "source": "https://github.com/docmost/docmost/blob/v0.96.0/docker-compose.yml",
  "services": [
    {
      "id": "docmost",
      "purpose": "Serves the private collaborative workspace and local attachments.",
      "imageTag": "docker.io/docmost/docmost:0.96.0",
      "imageSource": "https://github.com/docmost/docmost/releases/tag/v0.96.0",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://github.com/docmost/docmost/blob/v0.96.0/docker-compose.yml", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [{ "name": "REDIS_URL", "value": "redis://redis:6379" }],
      "derivedEnvironment": [{ "name": "APP_URL", "source": "local-origin" }],
      "hostEnvironment": [],
      "fileEnvironment": [],
      "secretEnvironment": [
        { "name": "APP_SECRET", "fileId": "app-secret" },
        { "name": "DATABASE_URL", "fileId": "database-password", "format": "postgres-url", "username": "docmost", "host": "db", "port": 5432, "database": "docmost" }
      ],
      "mounts": [{ "name": "storage", "target": "/app/data/storage", "kind": "volume" }],
      "dependsOn": ["db", "redis"],
      "publishTargetPort": 3000
    },
    {
      "id": "db",
      "purpose": "Stores Docmost accounts, pages, and workspace metadata privately.",
      "imageTag": "docker.io/library/postgres:18",
      "imageSource": "https://github.com/docmost/docmost/blob/v0.96.0/docker-compose.yml",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://github.com/docmost/docmost/blob/v0.96.0/docker-compose.yml", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [{ "name": "POSTGRES_DB", "value": "docmost" }, { "name": "POSTGRES_USER", "value": "docmost" }],
      "hostEnvironment": [],
      "fileEnvironment": [{ "name": "POSTGRES_PASSWORD_FILE", "fileId": "database-password" }],
      "mounts": [{ "name": "database", "target": "/var/lib/postgresql", "kind": "volume" }],
      "dependsOn": [],
      "publishTargetPort": null
    },
    {
      "id": "redis",
      "purpose": "Keeps Docmost jobs and collaboration state on the private project network.",
      "imageTag": "docker.io/library/redis:8",
      "imageSource": "https://github.com/docmost/docmost/blob/v0.96.0/docker-compose.yml",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://github.com/docmost/docmost/blob/v0.96.0/docker-compose.yml", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "command": ["redis-server", "--appendonly", "yes", "--maxmemory-policy", "noeviction"],
      "environment": [],
      "hostEnvironment": [],
      "fileEnvironment": [],
      "mounts": [{ "name": "redis", "target": "/data", "kind": "volume" }],
      "dependsOn": [],
      "publishTargetPort": null
    }
  ],
  "privateFiles": [
    { "id": "app-secret", "bytes": 48, "format": "alphanumeric" },
    { "id": "database-password", "bytes": 48, "format": "alphanumeric" },
    { "id": "admin-password", "bytes": 48, "format": "alphanumeric" }
  ],
  "onboarding": { "kind": "manual-first-email", "officialUrl": "https://docmost.com/docs/installation", "email": "admin@example.test", "fileId": "admin-password" },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 3000, "dataDirectoryName": "docmost" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 5368709120 },
  "acceptance": [
    { "id": "health", "method": "api", "description": "Check /api/health on the selected private origin; this does not prove workspace setup." },
    { "id": "first-workspace", "method": "api", "description": "Create the first owner and workspace with the fixed admin@example.test email, then prove fresh password login through the source-pinned Community implementation." },
    { "id": "content-roundtrip", "method": "browser", "description": "Create and re-read a page and attachment under that owner." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart the exact owned project and verify owner, page, and attachment persist." },
    { "id": "isolated-restore", "method": "persisted", "description": "Restore PostgreSQL and attachment storage in isolation before claiming backup verification." }
  ]
}

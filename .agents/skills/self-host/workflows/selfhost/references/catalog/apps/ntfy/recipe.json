{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "ntfy",
  "source": "https://docs.ntfy.sh/config/",
  "services": [{
    "id": "ntfy",
    "purpose": "Runs a private notification broker with a generated administrator and deny-all default access.",
    "imageTag": "binwiederhier/ntfy:v2.28.0",
    "imageSource": "https://github.com/binwiederhier/ntfy/releases/tag/v2.28.0",
    "user": "image-default",
    "imageUserEvidence": { "officialUrl": "https://docs.ntfy.sh/install/#docker", "reason": "official-image-runtime-contract" },
    "restart": "unless-stopped",
    "readOnly": false,
    "command": ["serve"],
    "environment": [
      { "name": "NTFY_AUTH_FILE", "value": "/var/lib/ntfy/user.db" },
      { "name": "NTFY_CACHE_FILE", "value": "/var/lib/ntfy/cache.db" },
      { "name": "NTFY_AUTH_DEFAULT_ACCESS", "value": "deny-all" }
    ],
    "hostEnvironment": [],
    "fileEnvironment": [],
    "secretEnvironment": [{ "name": "NTFY_AUTH_USERS", "fileId": "admin-password", "format": "ntfy-auth-users" }],
    "mounts": [{ "name": "data", "target": "/var/lib/ntfy", "kind": "volume" }],
    "dependsOn": [],
    "publishTargetPort": 80
  }],
  "privateFiles": [{ "id": "admin-password", "bytes": 48, "format": "alphanumeric" }],
  "onboarding": {
    "kind": "initial-admin-from-auth-users",
    "officialUrl": "https://docs.ntfy.sh/config/#users-via-the-config",
    "username": "admin",
    "secretEnvironment": "NTFY_AUTH_USERS",
    "fileId": "admin-password"
  },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 8080, "dataDirectoryName": "ntfy" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "private-auth", "method": "api", "description": "Authenticate the generated administrator on the exact private origin and confirm anonymous topic subscription is denied." },
    { "id": "notification-delivery", "method": "api", "description": "After a separately approved topic and least-privilege publisher are configured, publish and subscribe one notification and confirm its content and metadata." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart the exact owned project and verify administrator authentication, deny-all access, and notification history remain intact." }
  ]
}

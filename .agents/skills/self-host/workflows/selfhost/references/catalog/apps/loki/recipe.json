{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "loki",
  "source": "https://grafana.com/docs/loki/latest/setup/install/docker/",
  "services": [
    {
      "id": "loki",
      "purpose": "Stores and queries logs from an explicitly configured collector on this private single-node instance.",
      "imageTag": "grafana/loki:3.7.0",
      "imageSource": "https://hub.docker.com/r/grafana/loki/tags",
      "user": "image-default",
      "imageUserEvidence": { "officialUrl": "https://grafana.com/docs/loki/latest/setup/install/docker/", "reason": "official-image-runtime-contract" },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [],
      "hostEnvironment": [],
      "fileEnvironment": [],
      "mounts": [ { "name": "data", "target": "/loki", "kind": "volume" } ],
      "dependsOn": [],
      "publishTargetPort": 3100
    }
  ],
  "privateFiles": [],
  "onboarding": { "kind": "no-account", "officialUrl": "https://grafana.com/docs/loki/latest/setup/install/docker/" },
  "defaults": { "hostIp": "127.0.0.1", "publishedPort": 3100, "dataDirectoryName": "loki" },
  "storage": { "filesystem": "local-posix-locks", "minimumFreeBytes": 1073741824 },
  "acceptance": [
    { "id": "readiness", "method": "api", "description": "GET /ready on the exact private loopback origin and require HTTP 200; this only proves Loki is ready to accept traffic." },
    { "id": "log-round-trip", "method": "api", "description": "Configure an approved collector, push a redacted probe, and query it back before claiming ingestion." },
    { "id": "retention-and-restart", "method": "persisted", "description": "Review retention and storage policy, restart this exact project, and verify the probe is still queryable." }
  ]
}

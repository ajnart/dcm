{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "nextcloud",
  "source": "https://github.com/nextcloud/docker",
  "services": [
    {
      "id": "nextcloud",
      "purpose": "Stores and serves your private files, calendars, and collaboration data.",
      "imageTag": "docker.io/library/nextcloud:35.0.1-apache",
      "imageSource": "https://github.com/docker-library/official-images/blob/master/library/nextcloud",
      "user": "image-default",
      "imageUserEvidence": {
        "officialUrl": "https://github.com/nextcloud/docker/blob/master/README.md",
        "reason": "official-image-runtime-contract"
      },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [
        { "name": "MYSQL_HOST", "value": "db" },
        { "name": "MYSQL_DATABASE", "value": "nextcloud" },
        { "name": "MYSQL_USER", "value": "nextcloud" },
        { "name": "NEXTCLOUD_ADMIN_USER", "value": "admin" },
        { "name": "NEXTCLOUD_TRUSTED_DOMAINS", "value": "127.0.0.1" },
        { "name": "REDIS_HOST", "value": "redis" }
      ],
      "hostEnvironment": [],
      "fileEnvironment": [
        { "name": "MYSQL_PASSWORD_FILE", "fileId": "database-password" },
        { "name": "NEXTCLOUD_ADMIN_PASSWORD_FILE", "fileId": "admin-password" }
      ],
      "mounts": [{ "name": "html", "target": "/var/www/html", "kind": "volume" }],
      "dependsOn": ["db", "redis"],
      "publishTargetPort": 80
    },
    {
      "id": "db",
      "purpose": "Stores Nextcloud accounts, settings, and file metadata privately.",
      "imageTag": "docker.io/library/mariadb:12.3.3",
      "imageSource": "https://github.com/docker-library/official-images/blob/master/library/mariadb",
      "user": "image-default",
      "imageUserEvidence": {
        "officialUrl": "https://hub.docker.com/_/mariadb",
        "reason": "official-image-runtime-contract"
      },
      "restart": "unless-stopped",
      "readOnly": false,
      "command": ["--transaction-isolation=READ-COMMITTED"],
      "environment": [
        { "name": "MARIADB_DATABASE", "value": "nextcloud" },
        { "name": "MARIADB_USER", "value": "nextcloud" }
      ],
      "hostEnvironment": [],
      "fileEnvironment": [
        { "name": "MARIADB_PASSWORD_FILE", "fileId": "database-password" },
        { "name": "MARIADB_ROOT_PASSWORD_FILE", "fileId": "database-root-password" }
      ],
      "mounts": [{ "name": "db", "target": "/var/lib/mysql", "kind": "volume" }],
      "dependsOn": [],
      "publishTargetPort": null
    },
    {
      "id": "redis",
      "purpose": "Keeps Nextcloud file locks and cache on the private network.",
      "imageTag": "docker.io/library/redis:8.10.2-alpine3.23",
      "imageSource": "https://github.com/docker-library/official-images/blob/master/library/redis",
      "user": "image-default",
      "imageUserEvidence": {
        "officialUrl": "https://github.com/nextcloud/docker/blob/master/.examples/docker-compose/insecure/mariadb/apache/compose.yaml",
        "reason": "official-image-runtime-contract"
      },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [],
      "hostEnvironment": [],
      "fileEnvironment": [],
      "mounts": [],
      "dependsOn": [],
      "publishTargetPort": null
    },
    {
      "id": "cron",
      "purpose": "Runs Nextcloud's scheduled background jobs using the same private files.",
      "imageTag": "docker.io/library/nextcloud:35.0.1-apache",
      "imageSource": "https://github.com/docker-library/official-images/blob/master/library/nextcloud",
      "user": "image-default",
      "imageUserEvidence": {
        "officialUrl": "https://github.com/nextcloud/docker/blob/master/.examples/docker-compose/insecure/mariadb/apache/compose.yaml",
        "reason": "official-image-runtime-contract"
      },
      "restart": "unless-stopped",
      "readOnly": false,
      "entrypoint": ["/cron.sh"],
      "environment": [{ "name": "REDIS_HOST", "value": "redis" }],
      "hostEnvironment": [],
      "fileEnvironment": [],
      "mounts": [{ "name": "html", "target": "/var/www/html", "kind": "volume" }],
      "dependsOn": ["nextcloud"],
      "publishTargetPort": null
    }
  ],
  "privateFiles": [
    { "id": "admin-password", "bytes": 48, "format": "alphanumeric" },
    { "id": "database-password", "bytes": 48, "format": "alphanumeric" },
    { "id": "database-root-password", "bytes": 48, "format": "alphanumeric" }
  ],
  "onboarding": {
    "kind": "initial-admin-from-file",
    "officialUrl": "https://github.com/nextcloud/docker/blob/master/README.md",
    "username": "admin",
    "usernameEnvironment": "NEXTCLOUD_ADMIN_USER",
    "fileEnvironment": "NEXTCLOUD_ADMIN_PASSWORD_FILE",
    "fileId": "admin-password"
  },
  "defaults": {
    "hostIp": "127.0.0.1",
    "publishedPort": 8080,
    "dataDirectoryName": "nextcloud"
  },
  "storage": {
    "filesystem": "local-posix-locks",
    "minimumFreeBytes": 10737418240
  },
  "acceptance": [
    { "id": "first-account", "method": "api", "description": "Verify installed status and authenticate the generated administrator through OCS." },
    { "id": "webdav-roundtrip", "method": "api", "description": "Upload, read, compare, and remove a harmless uniquely named WebDAV probe file." },
    { "id": "background-jobs", "method": "api", "description": "Confirm cron background-job mode and one successful scheduled run." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart this exact project and confirm the administrator and saved file remain available." }
  ]
}

{
  "name": "selfhost-reel",
  "private": true,
  "type": "module",
  "scripts": {
    "stills": "node render.mjs stills",
    "lint": "node render.mjs lint",
    "cues": "node render.mjs cues",
    "audio": "node render.mjs cues && node audio/mix.mjs",
    "video": "node render.mjs video",
    "lint:saas": "node render.mjs lint --cut saas",
    "audio:saas": "node render.mjs cues --cut saas && node audio/mix.mjs --cut saas",
    "video:saas": "node render.mjs video --cut saas",
    "thumbs": "node thumbs/build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "gsap": "^3.15.0",
    "playwright": "1.64.0"
  }
}

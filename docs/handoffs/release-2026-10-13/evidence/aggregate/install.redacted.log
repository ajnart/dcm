{"event":"command","command":"docker compose --project-directory /private/var/folders/kx/hccbvbyd6sb6[redacted]s6lrr[redacted]jyt[redacted]m0000gn/T/opencode/homarr-aggregate-run-5iy[redacted]oywq/project -p aggregate-5iy[redacted]oywq --env-file /private/var/folders/kx/hccbvbyd6sb6[redacted]s6lrr[redacted]jyt[redacted]m0000gn/T/opencode/homarr-aggregate-run-5iy[redacted]oywq/project/.env --env-file /private/var/folders/kx/hccbvbyd6sb6[redacted]s6lrr[redacted]jyt[redacted]m0000gn/T/opencode/homarr-aggregate-run-5iy[redacted]oywq/project/secrets.env exec -T -e HOMARR_PASSWORD -e HOMARR_USERNAME nzbget sh -c set -eu\nfile=/config/nzbget.conf\ntest -f \"$file\"\ntest ! -L \"$file\"\ntemp=$(mktemp /config/.[redacted].XXXXXX)\ntrap 'rm -f \"$temp\"' EXIT\nawk '\nBEGIN { username = ENVIRON[\"HOMARR_USERNAME\"]; password = ENVIRON[\"HOMARR_PASSWORD\"] }\n/^[[:space:]]*RestrictedUsername[[:space:]]*=/ {\n  value = $0; sub(/^[^=]*=/, \"\", value); sub(/\\r$/, \"\", value)\n  if (++users != [redacted] || (value != \"\" && value != username)) exit [redacted]\n  print \"RestrictedUsername=\" username; next\n}\n/^[[:space:]]*RestrictedPassword[[:space:]]*=/ {\n  value = $0; sub(/^[^=]*=/, \"\", value); sub(/\\r$/, \"\", value)\n  if (++passwords != [redacted] || (value != \"\" && value != password)) exit [redacted]\n  print \"RestrictedPassword=\" password; next\n}\n{ print }\nEND { if (users != [redacted] || passwords != [redacted]) exit [redacted] }\n' \"$file\" > \"$temp\"\npython3 - \"$file\" \"$temp\" <<'PY'\nimport os\nimport stat\nimport sys\n\noriginal = os.stat(sys.argv[[redacted]], follow_symlinks=False)\nif not stat.S_ISREG(original.st_mode):\n    raise RuntimeError(\"NZBGet configuration must be a regular file\")\nos.chown(sys.argv[[redacted]], original.st_uid, original.st_gid)\nPY\nchmod 600 \"$temp\"\nmv \"$temp\" \"$file\""}

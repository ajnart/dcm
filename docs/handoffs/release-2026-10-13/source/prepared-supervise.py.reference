import hashlib
import json
import math
import os
import pathlib
import re
import secrets
import select
import signal
import socket
import stat
import subprocess
import sys
import time

A = pathlib.Path(__file__).parent
PLAN = json.loads((A / "run-plan.json").read_text())
BROWSER_PLAN = json.loads((A / "browser-plan.short.json").read_text())
ROOT = pathlib.Path(PLAN["root"])
HOME = pathlib.Path(PLAN["home"])
DOCKER = "/usr/local/bin/docker"
BASE = [DOCKER, "--host", PLAN["endpoint"], "--config", str(ROOT / "docker-config")]
SERVICES = PLAN["services"]
ENV = None
PASSWORD = ""
ACTIVE = None
BROWSER_ENV = None
BROWSER_STARTED = False
WRAPPER_DISPOSITION = None


def require(condition, reason):
    if not condition:
        raise RuntimeError(reason)


def digest(path):
    return hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest()


def record(name, value):
    path = ROOT / (name + ".json")
    path.write_text(json.dumps(value, indent=2) + "\n")
    path.chmod(0o600)


def remaining(reserve=0):
    receipt = json.loads((ROOT / "admission.json").read_text())
    return max(0.1, receipt["deadline_monotonic"] - time.monotonic() - reserve)


def check_socket():
    receipt = json.loads((ROOT / "admission.json").read_text())
    current = pathlib.Path(PLAN["socket"]).stat()
    require(stat.S_ISSOCK(current.st_mode), "intended endpoint is not a UNIX socket")
    require(
        [current.st_dev, current.st_ino] == receipt["socket_identity"],
        "intended socket identity changed",
    )


def docker(args, timeout=30):
    check_socket()
    result = subprocess.run(
        BASE + args,
        env=ENV or os.environ,
        capture_output=True,
        timeout=min(timeout, remaining()),
    )
    require(
        result.returncode == 0, "explicit-endpoint Docker operation failed: " + args[0]
    )
    return result.stdout


def redacted(data):
    if PASSWORD:
        data = data.replace(PASSWORD.encode(), b"[redacted]")
    result = subprocess.run(
        [str(A / "helper"), "redact"],
        input=data,
        env=ENV or os.environ,
        capture_output=True,
        timeout=15,
    )
    require(
        result.returncode == 0, "secret-safe output masking failed; raw output withheld"
    )
    return result.stdout


def expected_mounts(name):
    service = SERVICES[name]
    mounts = {}
    for raw in service["original"].get("volumes", []):
        parts = raw.split(":")
        source, target = parts[:2]
        source = source.replace("${MEDIA_ROOT}", str(ROOT / "media")).replace(
            "${DOWNLOADS_ROOT}", str(ROOT / "downloads")
        )
        if source.startswith("./"):
            source = str(HOME / "apps" / service["app"] / source[2:])
        require(
            pathlib.Path(source).is_absolute(), "unbounded source mount in inventory"
        )
        mounts[target] = (
            str(pathlib.Path(source).resolve()),
            len(parts) == 3 and parts[2] == "ro",
        )
    if name == "traefik":
        mounts["/etc/traefik/dynamic.yml"] = (
            str(HOME / "apps/traefik/management-api"),
            True,
        )
    return mounts


def matches_memory_cap(value, expected):
    if type(value) is int:
        return value > 0 and value == expected
    if type(value) is str:
        return (
            value == str(expected) and re.fullmatch(r"[1-9][0-9]*", value) is not None
        )
    return False


def validate_effective(doc):
    require(doc.get("name") == PLAN["project"], "effective Compose namespace mismatch")
    require(
        set(doc.get("services", {})) == set(SERVICES),
        "effective Compose service inventory mismatch",
    )
    require(
        not doc.get("volumes") and not doc.get("configs"),
        "unexpected top-level resource",
    )
    require(
        doc.get("secrets")
        == {
            "admin-password": {
                "name": PLAN["project"] + "_admin-password",
                "environment": "ADMIN_PASSWORD",
            }
        },
        "source-declared Gotify secret resource mismatch",
    )
    networks = doc.get("networks", {})
    require(set(networks) == {"default"}, "unexpected Compose network")
    network = networks["default"]
    require(
        network.get("name") == PLAN["project"] + "_default"
        and network.get("driver", "bridge") == "bridge",
        "non-standard owned bridge",
    )
    require(
        not network.get("external")
        and not network.get("internal")
        and not network.get("driver_opts"),
        "unexpected bridge options",
    )
    projection = {}
    for name, service in doc["services"].items():
        planned = SERVICES[name]
        expected_secrets = []
        if name == "gotify":
            expected_secrets = [
                {"source": "admin-password", "target": "/run/secrets/admin-password"}
            ]
        require(
            service.get("secrets", []) == expected_secrets,
            "source secret binding mismatch: " + name,
        )
        require(
            service.get("image") == planned["image"],
            "effective image mismatch: " + name,
        )
        require(
            not any(
                service.get(key)
                for key in [
                    "build",
                    "privileged",
                    "cap_add",
                    "devices",
                    "device_cgroup_rules",
                    "network_mode",
                    "pid",
                    "ipc",
                    "uts",
                    "volumes_from",
                    "external_links",
                    "extra_hosts",
                    "container_name",
                    "profiles",
                ]
            ),
            "unsafe service options: " + name,
        )
        require(
            set(service.get("networks", {})) == {"default"},
            "unexpected service network: " + name,
        )
        require(
            matches_memory_cap(service.get("mem_limit"), planned["memory"])
            and matches_memory_cap(service.get("memswap_limit"), planned["memory"]),
            "memory bound mismatch: " + name,
        )
        require(
            float(service.get("cpus", 0)) == planned["cpus"]
            and service.get("pids_limit") == 512,
            "CPU/PID bound mismatch: " + name,
        )
        limits = service.get("deploy", {}).get("resources", {}).get("limits", {})
        require(
            matches_memory_cap(limits.get("memory"), planned["memory"])
            and float(limits.get("cpus", 0)) == planned["cpus"]
            and limits.get("pids") == 512,
            "deploy limit mismatch: " + name,
        )
        require(
            service.get("deploy", {}).get("replicas", 1) == 1
            and service.get("restart") == "no",
            "replication or restart mismatch: " + name,
        )
        ports = [
            {
                key: port.get(key)
                for key in ["target", "published", "host_ip", "protocol"]
            }
            for port in service.get("ports", [])
        ]
        require(ports == planned["ports"], "loopback port mismatch: " + name)
        actual_mounts = {}
        for mount in service.get("volumes", []):
            require(mount.get("type") == "bind", "unexpected volume type: " + name)
            source = pathlib.Path(mount["source"]).resolve()
            require(
                source.is_relative_to(ROOT)
                and not any(
                    part in [".sessions", ".docker", ".orbstack"]
                    for part in source.parts
                ),
                "mount escaped disposable data: " + name,
            )
            actual_mounts[mount["target"]] = (
                str(source),
                mount.get("read_only", False),
            )
        require(
            actual_mounts == expected_mounts(name),
            "source mount inventory mismatch: " + name,
        )
        projection[name] = {
            key: planned[key] for key in ["image", "memory", "cpus", "ports"]
        }
        projection[name]["mounts"] = actual_mounts
    require(
        sum(item["memory"] for item in projection.values()) == PLAN["memory"],
        "whole-Project memory bound mismatch",
    )
    require(
        sum(item["cpus"] for item in projection.values()) == PLAN["cpu"],
        "whole-Project CPU bound mismatch",
    )
    record(
        "effective-compose",
        {
            "validated_at": time.time(),
            "service_count": len(projection),
            "services": projection,
            "memory": PLAN["memory"],
            "cpu": PLAN["cpu"],
            "network": network,
        },
    )


def capture():
    ids = (
        docker(
            [
                "ps",
                "-aq",
                "--filter",
                "label=com.docker.compose.project=" + PLAN["project"],
            ]
        )
        .decode()
        .split()
    )
    require(len(ids) <= 51, "owned container count exceeds authorization")
    rows = []
    if ids:
        objects = json.loads(docker(["inspect", *ids]))
        for item in objects:
            labels = item["Config"].get("Labels", {})
            name = labels.get("com.docker.compose.service")
            require(
                labels.get("com.docker.compose.project") == PLAN["project"]
                and name in SERVICES,
                "captured container identity mismatch",
            )
            cap = item["HostConfig"]
            planned = SERVICES[name]
            require(
                cap["Memory"] == planned["memory"]
                and cap["MemorySwap"] == planned["memory"]
                and cap["NanoCpus"] == int(planned["cpus"] * 1e9)
                and cap["PidsLimit"] == 512,
                "actual resource cap mismatch: " + name,
            )
            require(
                not cap["Privileged"]
                and not cap.get("CapAdd")
                and not cap.get("Devices")
                and cap.get("NetworkMode") == PLAN["project"] + "_default"
                and not cap.get("PidMode"),
                "actual namespace/privilege mismatch: " + name,
            )
            require(
                set(item["NetworkSettings"]["Networks"])
                == {PLAN["project"] + "_default"},
                "actual network attachment mismatch: " + name,
            )
            mounts = {
                mount["Destination"]: (
                    str(pathlib.Path(mount["Source"]).resolve()),
                    not mount["RW"],
                )
                for mount in item.get("Mounts", [])
                if mount["Type"] == "bind"
            }
            require(
                mounts == expected_mounts(name), "actual source mount mismatch: " + name
            )
            expected_ports = {
                str(port["target"]) + "/" + port["protocol"]: [
                    {"HostIp": port["host_ip"], "HostPort": port["published"]}
                ]
                for port in planned["ports"]
            }
            require(
                (cap.get("PortBindings") or {}) == expected_ports,
                "actual loopback binding mismatch: " + name,
            )
            rows.append(
                {
                    "id": item["Id"],
                    "service": name,
                    "image_id": item["Image"],
                    "source_image": planned["image"],
                    "state": item["State"]["Status"],
                    "exit_code": item["State"]["ExitCode"],
                    "oom_killed": item["State"]["OOMKilled"],
                    "started_at": item["State"].get("StartedAt"),
                    "finished_at": item["State"].get("FinishedAt"),
                    "restarting": item["State"].get("Restarting"),
                    "restart_count": item.get("RestartCount"),
                    "memory": cap["Memory"],
                    "memory_swap": cap["MemorySwap"],
                    "nano_cpus": cap["NanoCpus"],
                    "pids_limit": cap["PidsLimit"],
                    "ports": expected_ports,
                }
            )
    networks = (
        docker(
            [
                "network",
                "ls",
                "-q",
                "--filter",
                "label=com.docker.compose.project=" + PLAN["project"],
            ]
        )
        .decode()
        .split()
    )
    require(len(networks) <= 1, "unexpected owned network count")
    result = {"containers": rows, "networks": networks, "observed_at": time.time()}
    record("captured-resources", result)
    return result


def wrapper():
    global WRAPPER_DISPOSITION
    WRAPPER_DISPOSITION = {
        "stage": "runner-preflight",
        "category": "runner-guard",
        "docker_started": False,
        "pid": os.getpid(),
        "at": time.time(),
    }
    args = sys.argv[2:]
    check_socket()
    require(
        time.monotonic()
        < json.loads((ROOT / "admission.json").read_text())["work_deadline_monotonic"],
        "aggregate work deadline reached",
    )
    require(
        digest(PLAN["override"]) == PLAN["override_sha256"], "global override changed"
    )
    allowed = ["up", "pull", "ps", "exec", "logs", "config"]
    if (
        args == ["compose", "version", "--short"]
        or args == ["version", "--format", "{{.Server.Version}}"]
        or args == ["info", "--format", "{{json .SecurityOptions}}"]
    ):
        os.execv(DOCKER, BASE + args)
    require(args and args[0] == "compose", "unexpected Docker command from CLI")
    prefix = [
        "compose",
        "--project-directory",
        str(HOME),
        "-p",
        PLAN["project"],
        "--env-file",
        str(HOME / ".env"),
        "--env-file",
        str(HOME / "secrets.env"),
    ]
    require(
        args[: len(prefix)] == prefix and pathlib.Path.cwd() == HOME,
        "CLI Compose identity escaped owned Project",
    )
    tail = args[len(prefix) :]
    if tail[:1] == ["--progress"]:
        require(tail[1] in ["json", "plain"], "unexpected Compose progress mode")
        tail = tail[2:]
    require(
        tail
        and tail[0] in allowed
        and not any(
            value
            in [
                "--privileged",
                "--build",
                "--scale",
                "--force-recreate",
                "--renew-anon-volumes",
            ]
            for value in tail
        ),
        "unapproved Compose operation",
    )
    owned_services = []
    if tail[0] == "exec":
        index = 1
        while index < len(tail) and tail[index] in ["-T", "-e"]:
            if tail[index] == "-e":
                index += 2
            else:
                index += 1
        if index < len(tail) and tail[index] in SERVICES:
            owned_services = [tail[index]]
    WRAPPER_DISPOSITION.update(
        operation=tail[0], services=owned_services, stage="argv-check"
    )
    try:
        check = subprocess.run(
            [str(A / "helper"), "check-args"],
            input=json.dumps(args).encode(),
            capture_output=True,
            timeout=15,
        )
    except (OSError, subprocess.SubprocessError):
        WRAPPER_DISPOSITION.update(category="runner-helper-error", exit_code=2)
        record("subprocess-" + str(os.getpid()), WRAPPER_DISPOSITION)
        raise RuntimeError("private argument helper failed; details withheld") from None
    WRAPPER_DISPOSITION.update(helper_exit=check.returncode)
    if check.returncode:
        WRAPPER_DISPOSITION.update(
            category="runner-private-argv-guard"
            if check.returncode == 3
            else "runner-helper-error",
            exit_code=2,
        )
        record("subprocess-" + str(os.getpid()), WRAPPER_DISPOSITION)
    require(
        check.returncode == 0, "CLI put a private fixture value in process arguments"
    )
    if tail[0] in ["up", "pull"]:
        require(
            set(value for value in tail[1:] if not value.startswith("-"))
            <= set(SERVICES),
            "unapproved requested service",
        )
        if tail[0] == "up":
            require(
                not (ROOT / "up-attempted.json").exists(),
                "automatic aggregate relaunch prohibited",
            )
            record("up-attempted", {"at": time.time()})
        config = subprocess.run(
            BASE + prefix + ["config", "--format", "json"],
            capture_output=True,
            timeout=30,
        )
        if config.returncode:
            (ROOT / "compose-config.redacted.log").write_bytes(redacted(config.stderr))
        require(
            config.returncode == 0,
            "effective Compose could not be resolved; raw configuration withheld",
        )
        validate_effective(json.loads(config.stdout))
        print(
            "aggregate: validated 51 services / 27 GiB / 15.75 CPU before " + tail[0],
            file=sys.stderr,
            flush=True,
        )
    WRAPPER_DISPOSITION.update(
        stage="docker-operation",
        category="docker-operation-started",
        docker_started=True,
    )
    record("subprocess-" + str(os.getpid()), WRAPPER_DISPOSITION)
    try:
        result = subprocess.run(BASE + args)
    except OSError:
        WRAPPER_DISPOSITION.update(category="docker-client-start-error", exit_code=2)
        record("subprocess-" + str(os.getpid()), WRAPPER_DISPOSITION)
        raise RuntimeError(
            "explicit-endpoint Docker subprocess could not start"
        ) from None
    category = "docker-operation-ok"
    if result.returncode:
        category = "docker-compose-nonzero"
        if tail[0] == "exec":
            category = "docker-exec-or-container-command-nonzero"
    WRAPPER_DISPOSITION.update(
        stage="exit",
        category=category,
        exit_code=result.returncode,
        finished_at=time.time(),
    )
    record("subprocess-" + str(os.getpid()), WRAPPER_DISPOSITION)
    if tail[0] == "up":
        observed = capture()
        print(
            "aggregate: captured "
            + str(len(observed["containers"]))
            + " owned containers after up",
            file=sys.stderr,
            flush=True,
        )
    raise SystemExit(result.returncode)


def stop_active():
    global ACTIVE
    if ACTIVE is not None and ACTIVE.poll() is None:
        try:
            require(
                os.getpgid(ACTIVE.pid) == ACTIVE.pid,
                "child process-group identity changed",
            )
            os.killpg(ACTIVE.pid, signal.SIGTERM)
            ACTIVE.wait(timeout=10)
        except subprocess.TimeoutExpired:
            if ACTIVE.poll() is None and os.getpgid(ACTIVE.pid) == ACTIVE.pid:
                os.killpg(ACTIVE.pid, signal.SIGKILL)
                ACTIVE.wait(timeout=10)


def child(command, name, limit=60, input_data=None, env=None, progress=False):
    global ACTIVE
    disposition = {
        "stage": "start",
        "category": "running",
        "exit_code": None,
        "started_at": time.time(),
    }
    record("command-" + name, disposition)
    try:
        ACTIVE = subprocess.Popen(
            command,
            cwd=HOME,
            env=env or ENV,
            stdin=subprocess.PIPE if input_data is not None else subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    except OSError:
        disposition.update(
            stage="start", category="runner-subprocess-error", finished_at=time.time()
        )
        record("command-" + name, disposition)
        raise
    if input_data is not None:
        ACTIVE.stdin.write(input_data)
        ACTIVE.stdin.close()
    output = bytearray()
    pending = bytearray()
    end = time.monotonic() + min(limit, remaining(150))
    last = time.monotonic()
    try:
        while True:
            if time.monotonic() >= end:
                stop_active()
                raise TimeoutError(name + " reached its bounded deadline")
            ready, _, _ = select.select([ACTIVE.stdout], [], [], 1)
            if ready:
                chunk = os.read(ACTIVE.stdout.fileno(), 65536)
                if not chunk:
                    break
                output.extend(chunk)
                if progress:
                    pending.extend(chunk)
                    while b"\n" in pending:
                        raw, _, pending = pending.partition(b"\n")
                        try:
                            event = json.loads(raw)
                        except (ValueError, TypeError):
                            continue
                        if isinstance(event, dict) and event.get("event") in [
                            "step.start",
                            "step.ok",
                            "step.fail",
                            "step.manual",
                        ]:
                            app = event.get("app", "")
                            step = event.get("step", "")
                            if app in {
                                row["id"] for row in PLAN["apps"]
                            } and re.fullmatch("[a-zA-Z0-9_-]{1,100}", step):
                                print(
                                    "aggregate:", app, step, event["event"], flush=True
                                )
            if time.monotonic() - last >= 60:
                print(
                    "aggregate:",
                    name,
                    "active; elapsed",
                    round(time.monotonic() - START),
                    "s",
                    flush=True,
                )
                last = time.monotonic()
        code = ACTIVE.wait(timeout=10)
        disposition.update(
            stage="exit",
            exit_code=code,
            category="command-ok" if code == 0 else "command-nonzero",
        )
    except (TimeoutError, subprocess.TimeoutExpired):
        disposition.update(stage="deadline", category="runner-deadline")
        raise
    except OSError:
        disposition.update(stage="subprocess", category="runner-subprocess-error")
        raise
    finally:
        stop_active()
        disposition.update(finished_at=time.time())
        record("command-" + name, disposition)
        safe = redacted(bytes(output))
        (ROOT / (name + ".redacted.log")).write_bytes(safe)
        (ROOT / (name + ".redacted.log")).chmod(0o600)
        ACTIVE = None
    return code, safe


def admit():
    global ENV, PASSWORD, START
    require(
        not (ROOT / "admission.json").exists(),
        "this one-attempt admission is already consumed",
    )
    forbidden = [
        key
        for key in os.environ
        if key.startswith(
            (
                "DOCKER_",
                "COMPOSE_",
                "SELF_HOST_",
                "AGENT_BROWSER_",
                "PLAYWRIGHT_",
                "CHROME_",
                "NODE_OPTIONS",
                "LD_PRELOAD",
                "DYLD_",
            )
        )
        or key.upper() in ["HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY"]
    ]
    require(
        not forbidden,
        "inherited connection/configuration override present; values not inspected",
    )
    require(
        digest(A / "self-host") == PLAN["binary_sha256"]
        and digest(A / "candidate.source.patch") == PLAN["source_sha256"]
        and digest(A / "helper") == PLAN["helper_sha256"],
        "source/binary/helper provenance mismatch",
    )
    require(
        digest(PLAN["override"]) == PLAN["override_sha256"],
        "owned caps override mismatch",
    )
    endpoint = pathlib.Path(PLAN["socket"])
    identity = endpoint.stat()
    require(
        stat.S_ISSOCK(identity.st_mode),
        "intended canonical endpoint is not a UNIX socket",
    )
    START = time.monotonic()
    record(
        "admission",
        {
            "started_at": time.time(),
            "started_monotonic": START,
            "deadline_monotonic": START + 5400,
            "work_deadline_monotonic": START + 5100,
            "endpoint": PLAN["endpoint"],
            "resolved_socket": str(endpoint.resolve(strict=True)),
            "socket_identity": [identity.st_dev, identity.st_ino],
            "project": PLAN["project"],
            "binary_sha256": PLAN["binary_sha256"],
            "source_sha256": PLAN["source_sha256"],
            "driver_sha256": digest(__file__),
            "override_sha256": PLAN["override_sha256"],
        },
    )
    ENV = {
        "PATH": str(ROOT / "bin") + ":/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin",
        "HOME": str(ROOT / "home"),
        "XDG_CONFIG_HOME": str(ROOT / "home"),
        "XDG_CACHE_HOME": str(ROOT / "home/cache"),
        "DOCKER_HOST": PLAN["endpoint"],
        "DOCKER_CONFIG": str(ROOT / "docker-config"),
        "SELF_HOST_HOME": str(HOME),
        "SELF_HOST_COMPOSE_PROJECT": PLAN["project"],
        "SELF_HOST_NO_TELEMETRY": "1",
        "SELF_HOST_NO_UPDATE_CHECK": "1",
        "DO_NOT_TRACK": "1",
        "TZ": "UTC",
    }
    info = json.loads(
        docker(
            [
                "info",
                "--format",
                '{"memory":{{.MemTotal}},"cpus":{{.NCPU}},"version":"{{.ServerVersion}}","running":{{.ContainersRunning}}}',
            ]
        )
    )
    counters = (
        docker(
            ["stats", "--no-stream", "--format", "{{.MemUsage}}|{{.CPUPerc}}"],
            timeout=45,
        )
        .decode()
        .splitlines()
    )
    usage = 0
    cpu_usage = 0
    units = {
        "B": 1,
        "KiB": 1024,
        "MiB": 1024**2,
        "GiB": 1024**3,
        "TiB": 1024**4,
        "kB": 1000,
        "MB": 1000**2,
        "GB": 1000**3,
    }
    for line in counters:
        memory, cpu = line.split("|")
        match = re.fullmatch(r"([0-9.]+)\s*([a-zA-Z]+)", memory.split("/")[0].strip())
        require(
            match is not None and match[2] in units,
            "unrecognized counter-only capacity value",
        )
        usage += math.ceil(float(match[1]) * units[match[2]])
        cpu_usage += float(cpu.strip("% "))
    capacity = {
        "engine": info,
        "existing_memory_excluding_inactive_file_cache": usage,
        "existing_cpu_percent_snapshot": cpu_usage,
        "running_counters": len(counters),
        "aggregate_memory_caps": PLAN["memory"],
        "aggregate_cpu_caps": PLAN["cpu"],
        "engine_overhead_reserve": 1024**3,
        "headroom_after_caps_and_snapshot": info["memory"] - usage - PLAN["memory"],
        "snapshot_not_capacity_guarantee": True,
    }
    record("capacity", capacity)
    require(
        info["cpus"] >= 16
        and len(counters) >= info["running"]
        and info["memory"] - usage - PLAN["memory"] >= 1024**3,
        "capacity hold: cannot preserve existing workload plus 1 GiB engine reserve under aggregate caps",
    )
    require(
        not docker(
            [
                "ps",
                "-aq",
                "--filter",
                "label=com.docker.compose.project=" + PLAN["project"],
            ]
        ).strip(),
        "aggregate namespace already has containers",
    )
    require(
        not docker(
            [
                "network",
                "ls",
                "-q",
                "--filter",
                "label=com.docker.compose.project=" + PLAN["project"],
            ]
        ).strip(),
        "aggregate namespace already has networks",
    )
    ports = {
        (port["published"], port["protocol"])
        for item in SERVICES.values()
        for port in item["ports"]
    }
    for port, protocol in ports:
        with socket.socket(
            socket.AF_INET,
            socket.SOCK_DGRAM if protocol == "udp" else socket.SOCK_STREAM,
        ) as probe:
            probe.bind(("127.0.0.1", int(port)))
    PASSWORD = secrets.token_urlsafe(36)
    ENV["SELF_HOST_ADMIN_PASSWORD"] = PASSWORD
    wrapper_file = ROOT / "bin/docker"
    wrapper_file.write_text(
        "#!"
        + sys.executable
        + '\nimport runpy, sys\nsys.argv.insert(1, "--docker-wrapper")\nrunpy.run_path('
        + repr(str(pathlib.Path(__file__).resolve()))
        + ', run_name="__main__")\n'
    )
    wrapper_file.chmod(0o700)
    print(
        "aggregate: ADMITTED",
        PLAN["project"],
        "51 container maximum; 27 GiB; 15.75 CPU; 90-minute absolute deadline",
        flush=True,
    )
    print(
        "aggregate: counter snapshot headroom after caps:",
        round(capacity["headroom_after_caps_and_snapshot"] / 1024**3, 3),
        "GiB; 1 GiB reserved for engine overhead",
        flush=True,
    )


def browser(args, name, data=None):
    command = [
        "<OLD_USER_HOME>/.bun/bin/agent-browser",
        "--session",
        BROWSER_PLAN["session"],
        "--namespace",
        BROWSER_PLAN["namespace"],
        "--allowed-domains",
        "127.0.0.1",
        "--json",
        *args,
    ]
    code, output = child(
        command, "browser-" + name, limit=45, input_data=data, env=BROWSER_ENV
    )
    require(code == 0, "isolated browser operation failed: " + name)
    return json.loads(output)


def render(result):
    global BROWSER_ENV, BROWSER_STARTED
    port = next(row["port"] for row in PLAN["apps"] if row["id"] == "homarr")
    origin = "http://127.0.0.1:" + str(port)
    BROWSER_ENV = {
        "PATH": "/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin",
        "HOME": BROWSER_PLAN["home"],
        "XDG_CONFIG_HOME": BROWSER_PLAN["home"],
        "XDG_CACHE_HOME": str(pathlib.Path(BROWSER_PLAN["home"]) / "cache"),
        "AGENT_BROWSER_CONFIG": str(A / "browser-empty.json"),
        "AGENT_BROWSER_NO_WEBMCP": "1",
        "AGENT_BROWSER_SOCKET_DIR": BROWSER_PLAN["socket_dir"],
    }
    ipc = pathlib.Path(BROWSER_PLAN["socket_dir"])
    identity = ipc.lstat()
    require(
        ipc.parent
        == pathlib.Path(
            "/private/var/folders/kx/hccbvbyd6sb61s6lrr2jyt2m0000gn/T/opencode"
        )
        and stat.S_ISDIR(identity.st_mode)
        and identity.st_uid == os.getuid()
        and stat.S_IMODE(identity.st_mode) == 0o700,
        "browser IPC directory is not private and owned",
    )
    socket_dir = ipc / "namespaces" / BROWSER_PLAN["namespace"] / "run"
    socket_path = socket_dir / (BROWSER_PLAN["session"] + ".sock")
    require(
        len(str(socket_path).encode()) <= 103,
        "browser UNIX socket path exceeds supported length",
    )
    info = browser(["session", "info"], "inactive-preflight")
    require(
        info.get("success")
        and info.get("data", {}).get("active") is False
        and info.get("data", {}).get("pid") is None
        and info.get("data", {}).get("socketDir") == str(socket_dir),
        "browser namespace/socket metadata mismatch or already active",
    )
    script = ROOT / "browser-origin.js"
    script.write_text(
        "(() => { const origin = "
        + json.dumps(origin)
        + '; for (const name of ["Worker", "SharedWorker"]) Object.defineProperty(window, name, {value: function(){throw new DOMException("Disabled in aggregate fixture", "SecurityError")}}); const Original = window.WebSocket; window.WebSocket = function(value, protocols) { const target = new URL(value, location.href); if (target.origin !== origin.replace("http:", "ws:")) throw new DOMException("Outside aggregate origin", "SecurityError"); return new Original(value, protocols); }; window.WebSocket.prototype = Original.prototype; })();\n'
    )
    routes = ["https://127.0.0.1*", "http://127.0.0.1/*"]
    digits = str(port)
    for index, allowed_digit in enumerate(digits):
        for digit in "0123456789":
            if digit != allowed_digit:
                routes.append("http://127.0.0.1:" + digits[:index] + digit + "*")
        if index:
            routes.append("http://127.0.0.1:" + digits[:index] + "/*")
    commands = [json.dumps(["open", "--init-script", str(script)])]
    commands.extend(
        json.dumps(["network", "route", route, "--abort"]) for route in routes
    )
    commands.append(json.dumps(["navigate", origin]))
    BROWSER_STARTED = True
    browser(["batch", *commands], "contained-open")
    login = (
        "(async()=>{ if(location.origin !== "
        + json.dumps(origin)
        + ') throw new Error("Origin mismatch"); const csrf=await fetch("/api/auth/csrf").then(r=>r.json()); const form=new URLSearchParams({name:"admin",password:'
        + json.dumps(PASSWORD)
        + ',csrfToken:csrf.csrfToken,callbackUrl:location.origin}); await fetch("/api/auth/callback/credentials",{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded","X-Auth-Return-Redirect":"1"},body:form});return !!(await fetch("/api/auth/session").then(r=>r.json())).user;})()'
    )
    auth = browser(["eval", "--stdin"], "private-login", login.encode())
    require(
        auth.get("data", {}).get("result") is True,
        "owned Homarr browser login was not authenticated",
    )
    browser(["open", origin + "/boards/Home"], "board")
    snapshot = browser(["snapshot"], "board-snapshot")
    record("browser-board-snapshot", snapshot)
    native_script = '(async()=>{ const read=async(name,input)=>{const q=input===undefined?"":"?input="+encodeURIComponent(JSON.stringify({json:input}));const r=await fetch("/api/trpc/"+name+q);const e=await r.json();if(!r.ok||e.error)return {failure:true,status:r.status};return e.result?.data?.json;};const integrations=await read("integration.all"); if(!Array.isArray(integrations))return {failure:true,integrations};const rows=[];for(const item of integrations){const value=await read("widget.stats.snapshot",{integrationId:item.id});rows.push({id:item.id,name:item.name,kind:item.kind,values:value?.values,error:value?.error,stale:value?.stale,updatedAt:value?.updatedAt,failure:value?.failure,status:value?.status});}const board=await read("board.getBoardByName",{name:"Home"});return {integrations:rows,widgets:(board?.items??[]).map(item=>({id:item.id,kind:item.kind,integrationIds:item.integrationIds,options:item.kind==="stats"?item.options:undefined})),renderedText:document.body.innerText};})()'
    native = browser(["eval", "--stdin"], "native-observations", native_script.encode())
    record("native-observations", native)
    body = native.get("data", {}).get("result", {}).get("renderedText", "")
    check = subprocess.run(
        [str(A / "helper"), "check-args"],
        env=ENV,
        input=body.encode(),
        capture_output=True,
        timeout=15,
    )
    require(
        check.returncode == 0 and PASSWORD not in body,
        "visible fixture credential detected; screenshot withheld",
    )
    browser(["screenshot", "--full", str(ROOT / "homarr-board.png")], "board-capture")
    result["browser"] = {
        "authenticated": True,
        "origin": origin,
        "screenshot": str(ROOT / "homarr-board.png"),
        "external_icons_blocked": True,
        "ports_restricted_by_abort_routes": True,
        "native_and_rendered_observations": str(ROOT / "native-observations.json"),
        "no_native_acceptance_inferred": True,
    }


def summarize(result):
    manifest = json.loads((A / "manifest.source.json").read_text())
    status = {}
    if (ROOT / "status.json").exists():
        status = json.loads((ROOT / "status.json").read_text())
    by_id = {row["id"]: row for row in status.get("apps", [])}
    homarr = by_id.get("homarr", {})
    selected = {row["id"] for row in PLAN["apps"]}
    rows = []
    for peer in manifest["peers"]:
        app_id = peer["descriptor"]["id"]
        own = by_id.get(app_id, {})
        own_steps = [
            step
            for step in own.get("steps", [])
            if not step.get("id", "").startswith(("link-", "unlink-"))
        ]
        link_steps = [
            step
            for step in homarr.get("steps", [])
            if step.get("id") == "link-" + app_id
        ]
        rows.append(
            {
                "name": peer["name"],
                "id": app_id,
                "source_included": True,
                "source_pin": peer["head"],
                "registered": True,
                "selected_for_runtime": app_id in selected,
                "startup_held": peer["name"] in PLAN["startup_excluded"],
                "started": own.get("state") == "running",
                "state": own.get("state", "not-started"),
                "setup": own.get("setup", "unobserved"),
                "own_steps": own_steps,
                "homarr_link_steps": link_steps,
                "native_values": "unobserved; inspect separate authenticated observations if present",
                "rendered_values": "unobserved; inspect board observations if present",
                "recorded_prerequisites": peer.get("runtime", {}),
                "nil_verifier_is_not_native_acceptance": peer["name"]
                in ["adguard", "aria2", "audiobookshelf", "paperless"],
            }
        )
    record(
        "per-app-summary",
        {
            "peers": rows,
            "homarr": homarr,
            "result": result,
            "counts": {
                "source_included": len(rows),
                "selected": sum(row["selected_for_runtime"] for row in rows),
                "startup_held": sum(row["startup_held"] for row in rows),
                "started": sum(row["started"] for row in rows),
                "setup_ok": sum(row["setup"] == "ok" for row in rows),
                "setup_manual": sum(row["setup"] == "manual" for row in rows),
                "setup_incomplete": sum(row["setup"] == "incomplete" for row in rows),
            },
        },
    )


def cleanup():
    stop_active()
    browser_cleanup_error = None
    if BROWSER_STARTED:
        try:
            browser(["close"], "owned-close")
            info = browser(["session", "info"], "cleanup-readback")
            require(
                info.get("data", {}).get("active") is False,
                "owned browser cleanup not confirmed",
            )
        except BaseException as error:
            browser_cleanup_error = type(error).__name__ + ": " + str(error)
    ids = (
        docker(
            [
                "ps",
                "-aq",
                "--filter",
                "label=com.docker.compose.project=" + PLAN["project"],
            ]
        )
        .decode()
        .split()
    )
    nets = (
        docker(
            [
                "network",
                "ls",
                "-q",
                "--filter",
                "label=com.docker.compose.project=" + PLAN["project"],
            ]
        )
        .decode()
        .split()
    )
    record("cleanup-captured-ids", {"containers": ids, "networks": nets})
    if ids:
        actual = json.loads(docker(["inspect", *ids]))
        require(
            all(
                item["Config"].get("Labels", {}).get("com.docker.compose.project")
                == PLAN["project"]
                and item["Config"].get("Labels", {}).get("com.docker.compose.service")
                in SERVICES
                for item in actual
            ),
            "cleanup container ownership mismatch",
        )
        docker(["stop", "--time", "10", *ids], timeout=90)
        docker(["rm", *ids], timeout=60)
    for network_id in nets:
        actual = json.loads(docker(["network", "inspect", network_id]))[0]
        require(
            actual.get("Labels", {}).get("com.docker.compose.project")
            == PLAN["project"]
            and actual["Name"] == PLAN["project"] + "_default"
            and not actual.get("Containers"),
            "cleanup network ownership or attachment mismatch",
        )
        docker(["network", "rm", network_id])
    after_ids = (
        docker(
            [
                "ps",
                "-aq",
                "--filter",
                "label=com.docker.compose.project=" + PLAN["project"],
            ]
        )
        .decode()
        .split()
    )
    after_nets = (
        docker(
            [
                "network",
                "ls",
                "-q",
                "--filter",
                "label=com.docker.compose.project=" + PLAN["project"],
            ]
        )
        .decode()
        .split()
    )
    record(
        "cleanup",
        {
            "removed_container_ids": ids,
            "removed_network_ids": nets,
            "remaining_containers": after_ids,
            "remaining_networks": after_nets,
            "data_preserved": True,
            "volumes_preserved": True,
            "images_preserved": True,
            "elapsed_seconds": round(time.monotonic() - START, 3),
        },
    )
    require(not after_ids and not after_nets, "owned cleanup readback incomplete")
    require(
        browser_cleanup_error is None,
        "owned browser cleanup requires attention: " + str(browser_cleanup_error),
    )
    print(
        "aggregate: CLEANUP verified;",
        len(ids),
        "owned containers and",
        len(nets),
        "owned networks removed; data/images/volumes retained",
        flush=True,
    )


def main():
    result = {
        "project": PLAN["project"],
        "source_included": 39,
        "selected_peer_apps": 34,
        "startup_excluded": PLAN["startup_excluded"],
        "native_acceptance_claim": False,
    }
    admitted = False
    try:
        admit()
        admitted = True
        sets = []
        for row in PLAN["apps"]:
            sets += ["--set", row["id"] + ".port=" + str(row["port"])]
            for key, value in row["inputs"].items():
                if value and key == "dns-port":
                    sets += ["--set", row["id"] + "." + key + "=" + value]
        args = [
            str(A / "self-host"),
            "--json",
            "install",
            "--yes",
            "--exposure",
            "local",
            "--media-root",
            str(ROOT / "media"),
            "--downloads-root",
            str(ROOT / "downloads"),
            *sets,
            *[row["id"] for row in PLAN["apps"]],
        ]
        code, _ = child(args, "install", limit=remaining(900), progress=True)
        result["install_exit"] = code
        result["resources"] = capture()
        for command in [
            ["debug", "home-assistant"],
            ["debug", "immich"],
            ["debug", "nzbget"],
            ["debug", "patchmon"],
            ["debug", "tracearr"],
            ["status"],
            ["debug", "homarr"],
        ]:
            name = "-".join(command)
            if remaining(180) <= 30:
                record(
                    "command-" + name,
                    {
                        "stage": "not-started",
                        "category": "cleanup-reserve",
                        "exit_code": None,
                    },
                )
                continue
            try:
                code, safe = child(
                    [str(A / "self-host"), "--json", *command], name, limit=30
                )
            except (TimeoutError, subprocess.TimeoutExpired, OSError):
                result[name + "_disposition"] = (
                    "bounded diagnostic did not finish; see safe command receipt"
                )
                continue
            result[name + "_exit"] = code
            if name == "status" and code == 0:
                try:
                    record("status", json.loads(safe))
                except ValueError:
                    result["status_json"] = "NDJSON retained in redacted log"
        if remaining(180) > 45 and any(
            row["service"] == "homarr" and row["state"] == "running"
            for row in result["resources"]["containers"]
        ):
            try:
                render(result)
            except BaseException as error:
                result["browser"] = {
                    "failure": type(error).__name__ + ": " + str(error),
                    "native_acceptance_claim": False,
                }
        result["runtime_phase"] = (
            "one install/start/Setup attempt finished; no retry or repair"
        )
    except BaseException as error:
        result["failure"] = type(error).__name__ + ": " + str(error)
        print("aggregate:", result["failure"], flush=True)
    finally:
        if (ROOT / "admission.json").exists():
            try:
                cleanup()
                result["cleanup"] = "verified"
            except BaseException as error:
                result["cleanup"] = type(error).__name__ + ": " + str(error)
                print(
                    "aggregate: cleanup requires attention:",
                    result["cleanup"],
                    flush=True,
                )
            result["elapsed_seconds"] = round(time.monotonic() - START, 3)
        result["admitted"] = admitted
        record("result", result)
        summarize(result)
        print("aggregate: result artifact", str(ROOT / "result.json"), flush=True)


if __name__ == "__main__":
    try:
        if sys.argv[1:] and sys.argv[1] == "--docker-wrapper":
            wrapper()
        else:
            signal.signal(
                signal.SIGTERM,
                lambda *_: (_ for _ in ()).throw(
                    KeyboardInterrupt("supervisor cancelled")
                ),
            )
            main()
    except RuntimeError as error:
        if WRAPPER_DISPOSITION is not None:
            WRAPPER_DISPOSITION.setdefault("exit_code", 2)
            record("subprocess-" + str(os.getpid()), WRAPPER_DISPOSITION)
        print("aggregate guard:", str(error), file=sys.stderr, flush=True)
        raise SystemExit(2)

package main

import (
	"encoding/json"
	"io"
	"os"
	"strings"
)

func main() {
	var secrets map[string]string
	if err := json.Unmarshal([]byte(os.Getenv("SYNTHETIC_PUBLIC_VALUES")), &secrets); err != nil {
		panic("invalid non-secret fixture")
	}
	data, err := io.ReadAll(io.LimitReader(os.Stdin, 32<<20))
	if err != nil {
		panic("invalid non-secret input")
	}
	for key, value := range secrets {
		if value == "self-host-homarr" && (key == "GOTIFY_HOMARR_USERNAME" || key == "NZBGET_HOMARR_USERNAME" || key == "UMAMI_HOMARR_USERNAME") {
			continue
		}
		if key != "ADMIN_USER" && len(value) >= 4 && strings.Contains(string(data), value) {
			os.Exit(3)
		}
	}
}

+package homarr
+
+import (
+	"context"
+	"errors"
+	"math"
+
+	"github.com/ajnart/self-host/internal/apps/linkwarden"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func linkwardenTarget() target {
+	return target{
+		id: "linkwarden", name: "Linkwarden", kind: "linkwarden", internal: fixed("http://linkwarden:3000"),
+		secrets: func(_, to *helpers.H) []secret {
+			return []secret{{Kind: "apiKey", Value: to.Secret(to.Key("homarr_api_key"))}}
+		},
+		widgets: []widget{statWidget("links", "collections", "tags")},
+		preflight: func(ctx context.Context, from, to *helpers.H) error {
+			if err := linkwarden.VerifyHomarr(ctx, to); err != nil {
+				if errors.Is(err, helpers.ErrManual) {
+					from.Info(linkwarden.HomarrRecoveryHint + " No Homarr mutation is permitted while that prerequisite is Manual.")
+				}
+				return err
+			}
+			return nil
+		},
+		verify: verifyLinkwarden,
+	}
+}
+
+func verifyLinkwarden(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	if err := linkwarden.VerifyHomarr(ctx, to); err != nil {
+		return err
+	}
+	accountID, err := linkwarden.HomarrAccountID(to)
+	if err != nil {
+		return err
+	}
+	value, err := apiKeyWrite(ctx, from, "integration.request", map[string]any{
+		"integrationId": integrationID, "method": "GET", "path": "/api/v1/users/me",
+	})
+	if err != nil {
+		return err
+	}
+	result, _ := value.(map[string]any)
+	integration, _ := result["integration"].(map[string]any)
+	data, _ := result["data"].(map[string]any)
+	identity, _ := data["response"].(map[string]any)
+	if result["ok"] != true || result["status"] != float64(200) || integration["id"] != integrationID || integration["kind"] != "linkwarden" || identity["id"] != float64(accountID) {
+		from.Info("Restore the known selected account's token to this owned Linkwarden integration in Homarr Management > Integrations, preserving unrelated integrations, then retry self-host setup homarr. Equal or empty native counts do not establish account identity.")
+		return helpers.ErrManual
+	}
+	statistics, err := freshStatsSnapshot(ctx, from, integrationID)
+	if err != nil {
+		return err
+	}
+	for _, key := range []string{"links", "collections", "tags"} {
+		count, ok := statistics[key].(float64)
+		if !ok || math.IsNaN(count) || math.IsInf(count, 0) || count < 0 || math.Trunc(count) != count {
+			return errors.New("Homarr returned incomplete Linkwarden statistics; retry self-host setup homarr")
+		}
+	}
+	return nil
+}
diff --git a/internal/apps/homarr/target_navidrome.go b/internal/apps/homarr/target_navidrome.go
new file mode 100644
index 0000000000000000000000000000000000000000..3425196740f9d773df0172f1815ae706683b6482
--- /dev/null
+++ b/internal/apps/homarr/target_navidrome.go
@@ -0,0 +1,138 @@
+package homarr
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/ajnart/self-host/internal/apps/navidrome"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func navidromeTarget() target {
+	return target{
+		id: "navidrome", name: "Navidrome", kind: "navidrome", internal: fixed("http://navidrome:4533"),
+		secrets: func(_, to *helpers.H) []secret {
+			return []secret{{Kind: "username", Value: to.AdminUser()}, {Kind: "password", Value: to.AdminPassword()}}
+		},
+		widgets: []widget{
+			{kind: "audioStats", options: map[string]any{"showArtists": true, "showAlbums": true, "showSongs": true, "compactMode": false}},
+			{kind: "mediaServer", options: map[string]any{"showOnlyPlaying": false, "showBitrate": false, "showLocation": false}},
+			statWidget("artistCount", "albumCount", "songCount"),
+		},
+		preflight: func(ctx context.Context, _, to *helpers.H) error {
+			_, err := navidrome.ReadHomarrData(ctx, to)
+			return err
+		},
+		verify: verifyNavidrome,
+	}
+}
+
+func verifyNavidrome(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	ctx, cancel := context.WithTimeout(ctx, time.Minute)
+	defer cancel()
+	value, err := apiKeyProcedure(ctx, from, "integration.byId", map[string]any{"id": integrationID})
+	if err != nil {
+		return errors.New("Homarr could not verify its saved Navidrome account; review access to this Link's owned integration, then run self-host setup homarr")
+	}
+	if !navidromeIdentityMatches(value, integrationID, to.AdminUser()) {
+		from.Info("Open Homarr's Integrations page and restore this Link's owned Navidrome integration to the saved Admin login from self-host credentials, then run self-host setup homarr. Do not change Navidrome accounts or adopt another account.")
+		return helpers.ErrManual
+	}
+	expected, err := navidrome.ReadHomarrData(ctx, to)
+	if err != nil {
+		return err
+	}
+	const failure = "Homarr Navidrome data is incomplete or unavailable; run self-host setup navidrome, then self-host setup homarr"
+	value, err = apiKeyProcedure(ctx, from, "widget.audioStats.getStats", map[string]any{"integrationId": integrationID})
+	if err != nil {
+		return errors.New(failure)
+	}
+	result, ok := value.(map[string]any)
+	if !ok || stringField(result, "kind") != "navidrome" {
+		return errors.New(failure)
+	}
+	statistics, _ := result["data"].(map[string]any)
+	if !navidromeCountsMatch(statistics, expected) {
+		return errors.New(failure)
+	}
+	value, err = apiKeyWrite(ctx, from, "widget.stats.refresh", map[string]any{"integrationId": integrationID, "force": true})
+	if err != nil {
+		return errors.New(failure)
+	}
+	snapshot, ok := value.(map[string]any)
+	if !ok || snapshot["error"] != false || snapshot["stale"] != false {
+		return errors.New(failure)
+	}
+	updatedAt, ok := snapshot["updatedAt"].(float64)
+	statistics, _ = snapshot["values"].(map[string]any)
+	if !ok || updatedAt <= 0 || !navidromeCountsMatch(statistics, expected) {
+		return errors.New(failure)
+	}
+	value, err = apiKeyProcedure(ctx, from, "widget.mediaServer.getCurrentStreams", map[string]any{"integrationIds": []string{integrationID}, "showOnlyPlaying": false})
+	if err != nil {
+		return errors.New(failure)
+	}
+	streams, ok := value.([]any)
+	if !ok || len(streams) != 1 {
+		return errors.New(failure)
+	}
+	stream, ok := streams[0].(map[string]any)
+	if !ok || stringField(stream, "integrationId") != integrationID || stringField(stream, "integrationKind") != "navidrome" || stream["error"] != nil {
+		return errors.New(failure)
+	}
+	sessions, ok := stream["sessions"].([]any)
+	if !ok || len(sessions) != expected.Sessions {
+		return errors.New(failure)
+	}
+	for _, raw := range sessions {
+		session, ok := raw.(map[string]any)
+		if !ok || stringField(session, "sessionId") == "" {
+			return errors.New(failure)
+		}
+		user, _ := session["user"].(map[string]any)
+		playing, _ := session["currentlyPlaying"].(map[string]any)
+		if stringField(user, "username") == "" || stringField(playing, "type") != "audio" || stringField(playing, "name") == "" {
+			return errors.New(failure)
+		}
+	}
+	return nil
+}
+
+func navidromeIdentityMatches(value any, integrationID, username string) bool {
+	integration, ok := value.(map[string]any)
+	if !ok || integrationID == "" || username == "" || stringField(integration, "id") != integrationID || stringField(integration, "kind") != "navidrome" {
+		return false
+	}
+	credentials, ok := integration["secrets"].([]any)
+	if !ok || len(credentials) != 2 {
+		return false
+	}
+	usernameFound, passwordFound := false, false
+	for _, raw := range credentials {
+		credential, ok := raw.(map[string]any)
+		if !ok {
+			return false
+		}
+		value, present := credential["value"]
+		switch stringField(credential, "kind") {
+		case "username":
+			usernameFound = stringField(credential, "value") == username
+		case "password":
+			passwordFound = present && value == nil
+		default:
+			return false
+		}
+	}
+	return usernameFound && passwordFound
+}
+
+func navidromeCountsMatch(statistics map[string]any, expected navidrome.HomarrData) bool {
+	for key, expectedCount := range map[string]int{"artistCount": expected.ArtistCount, "albumCount": expected.AlbumCount, "songCount": expected.SongCount} {
+		count, ok := statistics[key].(float64)
+		if !ok || count != float64(expectedCount) {
+			return false
+		}
+	}
+	return true
+}

+package homarr
+
+import (
+	"context"
+	"errors"
+	"math"
+	"time"
+
+	"github.com/ajnart/self-host/internal/apps/patchmon"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func patchmonTarget() target {
+	return target{
+		id: "patchmon", name: "PatchMon", kind: "patchmon",
+		internal: fixed("http://patchmon:3000"),
+		secrets: func(_, to *helpers.H) []secret {
+			return []secret{
+				{Kind: "patchmonApiKey", Value: to.Secret(to.Key("homarr_api_key"))},
+				{Kind: "patchmonApiSecret", Value: to.Secret(to.Key("homarr_api_secret"))},
+			}
+		},
+		widgets: []widget{
+			{kind: "patchmon", options: map[string]any{
+				"showComplianceHero": false, "enableThresholdColors": false,
+				"showTotalHosts": true, "showHostsNeedingUpdates": true,
+				"showSecurityUpdates": true, "showTotalOutdatedPackages": true,
+			}},
+			statWidget("totalHosts", "hostsNeedingUpdates", "securityUpdates", "totalOutdatedPackages"),
+		},
+		preflight: func(ctx context.Context, from, to *helpers.H) error {
+			err := patchmon.HomarrReadiness(ctx, to)
+			if errors.Is(err, helpers.ErrManual) {
+				from.Info(patchmon.HomarrHint)
+			}
+			return err
+		},
+		verify: verifyPatchmon,
+	}
+}
+
+func verifyPatchmon(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	if _, err := patchmon.HomarrStats(ctx, to); err != nil {
+		return err
+	}
+	value, err := apiKeyProcedure(ctx, from, "widget.patchmon.getStats", map[string]any{"integrationId": integrationID})
+	if err != nil {
+		return err
+	}
+	stats, ok := value.(map[string]any)
+	if !ok {
+		return errors.New("Homarr did not return PatchMon statistics")
+	}
+	for _, key := range []string{
+		"totalHosts", "hostsNeedingUpdates", "securityUpdates", "upToDateHosts",
+		"hostsWithSecurityUpdates", "recentUpdates24h", "totalOutdatedPackages", "totalRepos",
+	} {
+		count, ok := stats[key].(float64)
+		if !ok || count < 0 || math.IsNaN(count) || math.IsInf(count, 0) || math.Trunc(count) != count {
+			return errors.New("Homarr returned incomplete PatchMon statistics; retry self-host setup homarr")
+		}
+	}
+	if _, err := time.Parse(time.RFC3339, stringField(stats, "lastUpdated")); err != nil {
+		return errors.New("Homarr did not return the PatchMon statistics timestamp")
+	}
+	if stats["totalHosts"] == float64(0) {
+		from.Info("PatchMon reports no enrolled computers. These zero counts are not evidence of secure or fully patched computers.")
+	}
+	return nil
+}
diff --git a/internal/apps/homarr/target_peanut.go b/internal/apps/homarr/target_peanut.go
new file mode 100644
index 0000000000000000000000000000000000000000..da1a25b345dab73282ae02a74b6f23e59940108c
--- /dev/null
+++ b/internal/apps/homarr/target_peanut.go
@@ -0,0 +1,106 @@
+package homarr
+
+import (
+	"context"
+	"errors"
+	"math"
+
+	"github.com/ajnart/self-host/internal/apps/peanut"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func peanutTarget() target {
+	return target{
+		id: "peanut", name: "PeaNUT", kind: "peaNut", internal: fixed("http://peanut:8080"),
+		secrets: func(_, to *helpers.H) []secret {
+			return []secret{{Kind: "username", Value: to.AdminUser()}, {Kind: "password", Value: to.AdminPassword()}}
+		},
+		widgets: []widget{{kind: "ups", options: map[string]any{
+			"showBattery": true, "showLoad": true, "showVoltage": true,
+		}}, statWidget("devices", "onBattery", "lowBattery")},
+		preflight: func(ctx context.Context, from, to *helpers.H) error {
+			if err := (peanut.App{}).Check(ctx, to); err != nil {
+				from.Info("PeaNUT needs its verified Project Admin login and actual UPS readings from an owner-selected NUT server. Resolve its Manual steps, then run self-host setup peanut and self-host setup homarr. Do not disable authentication, add hardware access or grant shutdown control. No Homarr resources were changed.")
+				return err
+			}
+			return nil
+		},
+		verify: verifyPeanut,
+	}
+}
+
+func verifyPeanut(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	if err := peanut.VerifyAPI(ctx, to); err != nil {
+		return err
+	}
+	devices, err := peanut.Devices(ctx, to)
+	if err != nil {
+		return err
+	}
+	value, err := apiKeyProcedure(ctx, from, "widget.ups.getSummaries", map[string]any{"integrationIds": []string{integrationID}})
+	if err != nil {
+		return err
+	}
+	instances, ok := value.([]any)
+	if !ok || len(instances) != 1 {
+		return errors.New("Homarr did not return PeaNUT UPS summaries; retry self-host setup homarr")
+	}
+	instance, _ := instances[0].(map[string]any)
+	if stringField(instance, "integrationId") != integrationID || instance["error"] != nil {
+		return errors.New("Homarr could not read the owned PeaNUT integration; verify its credentials and retry Setup")
+	}
+	summaries, ok := instance["summaries"].([]any)
+	if !ok || len(summaries) != len(devices) {
+		return errors.New("Homarr returned incomplete PeaNUT UPS data; check its NUT connection and retry Setup")
+	}
+	expected := map[string]peanut.Device{}
+	for _, device := range devices {
+		expected[device.ID] = device
+	}
+	for _, raw := range summaries {
+		summary, _ := raw.(map[string]any)
+		device, found := expected[stringField(summary, "id")]
+		status := stringField(summary, "status")
+		if !found || (status != "online" && status != "charging" && status != "onBattery" && status != "lowBattery") {
+			return errors.New("Homarr did not return the discovered PeaNUT UPS identifiers and status; retry Setup without guessing device names")
+		}
+		delete(expected, device.ID)
+		for _, field := range []struct{ nut, homarr string }{
+			{"battery.charge", "batteryCharge"}, {"battery.runtime", "batteryRuntime"},
+			{"battery.voltage", "batteryVoltage"}, {"ups.load", "load"},
+			{"input.voltage", "inputVoltage"}, {"output.voltage", "outputVoltage"},
+		} {
+			_, present := device.Readings[field.nut]
+			actual, exists := summary[field.homarr]
+			if !exists || !present && actual != nil {
+				return errors.New("Homarr UPS readings must preserve unavailable values, not replace them with zero; retry Setup")
+			}
+			if present {
+				number, ok := actual.(float64)
+				if !ok || math.IsNaN(number) || math.IsInf(number, 0) || number < 0 || (field.nut == "battery.charge" || field.nut == "ups.load") && number > 100 {
+					return errors.New("Homarr returned invalid PeaNUT UPS readings; check the NUT driver and retry Setup")
+				}
+			}
+		}
+	}
+	value, err = apiKeyWrite(ctx, from, "widget.stats.refresh", map[string]any{"integrationId": integrationID, "force": true})
+	if err != nil {
+		return err
+	}
+	snapshot, _ := value.(map[string]any)
+	values, _ := snapshot["values"].(map[string]any)
+	updated, ok := snapshot["updatedAt"].(float64)
+	if snapshot["error"] != false || snapshot["stale"] != false || !ok || updated <= 0 {
+		return errors.New("Homarr could not refresh PeaNUT native Stats; check its NUT connection and retry Setup")
+	}
+	for _, key := range []string{"devices", "onBattery", "lowBattery"} {
+		count, ok := values[key].(float64)
+		if !ok || count < 0 || math.IsNaN(count) || math.IsInf(count, 0) || math.Trunc(count) != count {
+			return errors.New("Homarr returned incomplete PeaNUT native Stats; retry Setup")
+		}
+	}
+	if values["devices"].(float64) != float64(len(devices)) || values["onBattery"].(float64)+values["lowBattery"].(float64) > values["devices"].(float64) {
+		return errors.New("Homarr PeaNUT native Stats do not match the discovered UPS count; retry Setup")
+	}
+	return nil
+}
diff --git a/internal/apps/homarr/target_pihole.go b/internal/apps/homarr/target_pihole.go
new file mode 100644
index 0000000000000000000000000000000000000000..3497aa3a54cecf4aa3ffeee1d77c93f101af8adb
--- /dev/null
+++ b/internal/apps/homarr/target_pihole.go
@@ -0,0 +1,100 @@
+package homarr
+
+import (
+	"context"
+	"errors"
+	"math"
+
+	"github.com/ajnart/self-host/internal/apps/pihole"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func piholeTarget() target {
+	return target{
+		id: "pihole", name: "Pi-hole", kind: "piHole", internal: fixed("http://pihole:80"),
+		secrets: func(_, to *helpers.H) []secret {
+			return []secret{{Kind: "apiKey", Value: to.Secret(to.Key("homarr_app_password"))}}
+		},
+		widgets: []widget{{kind: "dnsHoleSummary", options: map[string]any{"usePiHoleColors": true, "layout": "grid"}},
+			statWidget("dnsQueriesToday", "adsBlockedToday", "adsBlockedTodayPercentage", "domainsBeingBlocked")},
+		preflight: func(ctx context.Context, from, to *helpers.H) error {
+			err := pihole.VerifyHomarr(ctx, to)
+			if errors.Is(err, helpers.ErrManual) {
+				from.Info("Pi-hole's dedicated application password must have app_sudo disabled. Review Pi-hole's application-password settings, then run self-host setup pihole followed by self-host setup homarr; this Link will not change permissions or blocking rules.")
+			}
+			return err
+		},
+		verify: verifyPihole,
+	}
+}
+
+func piholeStatistics(value any) bool {
+	statistics, ok := value.(map[string]any)
+	if !ok {
+		return false
+	}
+	for _, key := range []string{"dnsQueriesToday", "adsBlockedToday", "adsBlockedTodayPercentage", "domainsBeingBlocked"} {
+		count, ok := statistics[key].(float64)
+		if !ok || math.IsNaN(count) || math.IsInf(count, 0) || count < 0 {
+			return false
+		}
+		if key == "adsBlockedTodayPercentage" {
+			if count > 100 {
+				return false
+			}
+		} else if math.Trunc(count) != count {
+			return false
+		}
+	}
+	return statistics["adsBlockedToday"].(float64) <= statistics["dnsQueriesToday"].(float64)
+}
+
+func verifyPihole(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	if err := pihole.VerifyHomarr(ctx, to); err != nil {
+		return err
+	}
+	value, err := apiKeyProcedure(ctx, from, "widget.stats.catalog", map[string]any{"integrationId": integrationID})
+	if err != nil {
+		return err
+	}
+	catalog, _ := value.(map[string]any)
+	metrics, _ := catalog["metrics"].([]any)
+	for key, unit := range map[string]string{"dnsQueriesToday": "count", "adsBlockedToday": "count", "adsBlockedTodayPercentage": "percent", "domainsBeingBlocked": "count"} {
+		found := false
+		for _, raw := range metrics {
+			metric, _ := raw.(map[string]any)
+			if stringField(metric, "key") == key && stringField(metric, "unit") == unit {
+				found = true
+			}
+		}
+		if !found {
+			return errors.New("Homarr does not expose the supported Pi-hole Stats keys and units; use Homarr 2.4.1, then retry Setup")
+		}
+	}
+	started := from.Now().UnixMilli()
+	value, err = apiKeyWrite(ctx, from, "widget.stats.refresh", map[string]any{"integrationId": integrationID, "force": true})
+	if err != nil {
+		return err
+	}
+	snapshot, _ := value.(map[string]any)
+	failed, hasError := snapshot["error"].(bool)
+	stale, hasStale := snapshot["stale"].(bool)
+	updated, hasUpdated := snapshot["updatedAt"].(float64)
+	if !hasError || failed || !hasStale || stale || !hasUpdated || updated < float64(started) || !piholeStatistics(snapshot["values"]) {
+		return errors.New("Homarr did not return fresh authenticated Pi-hole Stats; explicit zero counts are valid, missing or failed results are not. Retry self-host setup pihole, then self-host setup homarr")
+	}
+	value, err = apiKeyProcedure(ctx, from, "widget.dnsHole.summary", map[string]any{"integrationIds": []string{integrationID}})
+	if err != nil {
+		return err
+	}
+	results, ok := value.([]any)
+	if !ok || len(results) != 1 {
+		return errors.New("Homarr did not return the Pi-hole DNS Hole Summary")
+	}
+	result, _ := results[0].(map[string]any)
+	summary, _ := result["summary"].(map[string]any)
+	if stringField(result, "integrationId") != integrationID || result["error"] != nil || !piholeStatistics(summary) || stringField(summary, "status") != "enabled" && stringField(summary, "status") != "disabled" {
+		return errors.New("Homarr returned incomplete or failed Pi-hole DNS Hole data; retry self-host setup pihole, then self-host setup homarr")
+	}
+	return nil
+}

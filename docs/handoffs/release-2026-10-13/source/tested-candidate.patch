@@ -0,0 +1,82 @@
+package homarr
+
+import (
+	"context"
+	"errors"
+	"math"
+
+	"github.com/ajnart/self-host/internal/apps/technitiumdns"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func technitiumDNSTarget() target {
+	return target{
+		id: "technitium-dns", name: "Technitium DNS Server", kind: "technitiumDns", internal: fixed("http://technitium-dns:5380"),
+		secrets: func(_, to *helpers.H) []secret {
+			return []secret{{Kind: "apiKey", Value: to.Secret(to.Key("homarr_api_key"))}}
+		},
+		widgets: []widget{plain("dnsHoleSummary"), statWidget("dnsQueriesToday", "adsBlockedToday", "adsBlockedTodayPercentage", "domainsBeingBlocked")},
+		preflight: func(ctx context.Context, _, to *helpers.H) error {
+			return technitiumdns.VerifyHomarr(ctx, to)
+		},
+		verify: verifyTechnitiumDNS,
+	}
+}
+
+func verifyTechnitiumDNS(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	if err := technitiumdns.VerifyHomarr(ctx, to); err != nil {
+		return err
+	}
+	value, err := apiKeyProcedure(ctx, from, "widget.stats.catalog", map[string]any{"integrationId": integrationID})
+	if err != nil {
+		return err
+	}
+	catalog, _ := value.(map[string]any)
+	metrics, ok := catalog["metrics"].([]any)
+	if !ok {
+		return errors.New("Homarr did not return its Technitium DNS statistics capabilities")
+	}
+	units := map[string]string{
+		"dnsQueriesToday": "count", "adsBlockedToday": "count",
+		"adsBlockedTodayPercentage": "percent", "domainsBeingBlocked": "count",
+	}
+	for key, unit := range units {
+		found := false
+		for _, raw := range metrics {
+			metric, _ := raw.(map[string]any)
+			if stringField(metric, "key") == key && stringField(metric, "unit") == unit {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return errors.New("Homarr Technitium DNS statistic or unit is unsupported; use Homarr 2.4.1 and retry Setup")
+		}
+	}
+	started := from.Now().UnixMilli()
+	value, err = apiKeyWrite(ctx, from, "widget.stats.refresh", map[string]any{"integrationId": integrationID, "force": true})
+	if err != nil {
+		return err
+	}
+	snapshot, _ := value.(map[string]any)
+	failed, hasError := snapshot["error"].(bool)
+	stale, hasStale := snapshot["stale"].(bool)
+	updated, hasUpdate := snapshot["updatedAt"].(float64)
+	if !hasError || failed || !hasStale || stale || !hasUpdate || updated < float64(started) {
+		return errors.New("Homarr did not freshly read Technitium DNS statistics; check its connection and retry self-host setup homarr")
+	}
+	values, ok := snapshot["values"].(map[string]any)
+	if !ok {
+		return errors.New("Homarr returned incomplete Technitium DNS statistics")
+	}
+	for key, unit := range units {
+		count, ok := values[key].(float64)
+		if !ok || math.IsNaN(count) || math.IsInf(count, 0) || count < 0 || unit == "percent" && count > 100 || unit == "count" && math.Trunc(count) != count {
+			return errors.New("Homarr returned incomplete Technitium DNS statistics; explicit zeros are valid but missing values are not")
+		}
+	}
+	if values["adsBlockedToday"].(float64) > values["dnsQueriesToday"].(float64) {
+		return errors.New("Homarr returned inconsistent Technitium DNS statistics")
+	}
+	return nil
+}
diff --git a/internal/apps/homarr/target_tracearr.go b/internal/apps/homarr/target_tracearr.go
new file mode 100644
index 0000000000000000000000000000000000000000..2149f23b22873be1ea3fbbdc1e7a41119509eeca
--- /dev/null
+++ b/internal/apps/homarr/target_tracearr.go
@@ -0,0 +1,163 @@
+package homarr
+
+import (
+	"context"
+	"errors"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/ajnart/self-host/internal/apps/tracearr"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func tracearrMetrics() []string {
+	return []string{"activeStreams", "totalUsers", "totalSessions", "recentViolations"}
+}
+
+func tracearrTarget() target {
+	return target{
+		id: "tracearr", name: "Tracearr", kind: "tracearr", internal: fixed("http://tracearr:3000"),
+		secrets: func(_, to *helpers.H) []secret {
+			return []secret{{Kind: "apiKey", Value: to.Secret(to.Key("homarr_api_key"))}}
+		},
+		widgets: []widget{{kind: "tracearr", options: map[string]any{
+			"showStreams": true, "showStats": true, "showRecentActivity": false, "showViolations": false,
+		}}, statWidget(tracearrMetrics()...)},
+		preflight: func(ctx context.Context, from, to *helpers.H) error {
+			err := tracearr.VerifyHomarr(ctx, to)
+			if errors.Is(err, helpers.ErrManual) {
+				from.Info(err.Error())
+			}
+			return err
+		},
+		verify: verifyTracearr,
+	}
+}
+
+func verifyTracearr(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	if err := tracearr.VerifyHomarr(ctx, to); err != nil {
+		return err
+	}
+	value, err := apiKeyProcedure(ctx, from, "widget.stats.catalog", map[string]any{"integrationId": integrationID})
+	if err != nil {
+		return err
+	}
+	catalog, _ := value.(map[string]any)
+	metrics, _ := catalog["metrics"].([]any)
+	for _, key := range tracearrMetrics() {
+		found := false
+		for _, raw := range metrics {
+			metric, _ := raw.(map[string]any)
+			if stringField(metric, "key") == key && stringField(metric, "unit") == "count" {
+				found = true
+			}
+		}
+		if !found {
+			return errors.New("Homarr lacks the supported Tracearr count metrics; use Homarr 2.4.1 and retry Setup")
+		}
+	}
+	value, err = apiKeyProcedure(ctx, from, "widget.tracearr.getDashboard", map[string]any{"integrationIds": []string{integrationID}})
+	if err != nil {
+		return err
+	}
+	results, ok := value.([]any)
+	if !ok || len(results) != 1 {
+		return errors.New("Homarr did not return the owned Tracearr dashboard")
+	}
+	result, _ := results[0].(map[string]any)
+	if stringField(result, "integrationId") != integrationID || result["error"] != nil {
+		return errors.New("Homarr could not read the owned Tracearr integration; retry self-host setup tracearr and self-host setup homarr")
+	}
+	if !tracearrFresh(from, stringField(result, "updatedAt")) {
+		return errors.New("Homarr returned a stale Tracearr dashboard; check the Host clock and retry Setup")
+	}
+	dashboard, _ := result["dashboard"].(map[string]any)
+	statistics, _ := dashboard["stats"].(map[string]any)
+	if !tracearrFresh(from, stringField(statistics, "timestamp")) {
+		return errors.New("Homarr returned stale or incomplete Tracearr statistics")
+	}
+	for _, key := range tracearrMetrics() {
+		if !tracearrCount(statistics, key) {
+			return errors.New("Homarr returned incomplete Tracearr statistics; missing counts are not zero")
+		}
+	}
+	streams, _ := dashboard["streams"].(map[string]any)
+	data, ok := streams["data"].([]any)
+	summary, _ := streams["summary"].(map[string]any)
+	if !ok {
+		return errors.New("Homarr did not return Tracearr's stream dataset; missing data is not an idle server")
+	}
+	for _, key := range []string{"total", "transcodes", "directStreams", "directPlays"} {
+		if !tracearrCount(summary, key) {
+			return errors.New("Homarr returned incomplete Tracearr stream counts")
+		}
+	}
+	if summary["total"] != float64(len(data)) || summary["transcodes"].(float64)+summary["directStreams"].(float64)+summary["directPlays"].(float64) != summary["total"] {
+		return errors.New("Homarr returned inconsistent Tracearr stream counts; retry Setup")
+	}
+	if !tracearrBitrate(stringField(summary, "totalBitrate")) {
+		return errors.New("Homarr did not return Tracearr's supported formatted bitrate; unavailable bandwidth is not zero")
+	}
+	for _, raw := range data {
+		stream, _ := raw.(map[string]any)
+		if stringField(stream, "id") == "" || stringField(stream, "serverId") == "" || stringField(stream, "username") == "" || stringField(stream, "mediaTitle") == "" || !tracearrCount(stream, "progressMs") {
+			return errors.New("Homarr returned incomplete Tracearr stream data")
+		}
+		switch stringField(stream, "state") {
+		case "playing", "paused", "stopped":
+		default:
+			return errors.New("Homarr returned an unsupported Tracearr playback state")
+		}
+	}
+	value, err = apiKeyWrite(ctx, from, "widget.stats.refresh", map[string]any{"integrationId": integrationID, "force": true})
+	if err != nil {
+		return err
+	}
+	snapshot, _ := value.(map[string]any)
+	if snapshot["error"] != false || snapshot["stale"] != false || !tracearrCount(snapshot, "updatedAt") {
+		return errors.New("Homarr returned failed, stale or incomplete Tracearr Stats; retry self-host setup homarr")
+	}
+	updatedAt := snapshot["updatedAt"].(float64)
+	age := float64(from.Now().UnixMilli()) - updatedAt
+	if updatedAt <= 0 || age < -5000 || age > 30000 {
+		return errors.New("Homarr did not freshly refresh Tracearr Stats; retry Setup after the refresh queue clears")
+	}
+	values, _ := snapshot["values"].(map[string]any)
+	for _, key := range tracearrMetrics() {
+		if !tracearrCount(values, key) {
+			return errors.New("Homarr returned incomplete Tracearr Stats; missing values are not zero")
+		}
+	}
+	return nil
+}
+
+func tracearrBitrate(value string) bool {
+	if value == "—" {
+		return true
+	}
+	parts := strings.Fields(value)
+	if len(parts) != 2 {
+		return false
+	}
+	rate, err := strconv.ParseFloat(parts[0], 64)
+	if err != nil || rate < 0 || math.IsInf(rate, 0) || math.IsNaN(rate) {
+		return false
+	}
+	return parts[1] == "kbps" || parts[1] == "Mbps" || parts[1] == "Gbps"
+}
+
+func tracearrCount(record map[string]any, key string) bool {
+	count, ok := record[key].(float64)
+	return ok && count >= 0 && !math.IsInf(count, 0) && !math.IsNaN(count) && math.Trunc(count) == count
+}
+
+func tracearrFresh(h *helpers.H, timestamp string) bool {
+	at, err := time.Parse(time.RFC3339Nano, timestamp)
+	if err != nil {
+		return false
+	}
+	age := h.Now().Sub(at)
+	return age >= -5*time.Second && age <= 30*time.Second
+}
diff --git a/internal/apps/homarr/target_traefik.go b/internal/apps/homarr/target_traefik.go
new file mode 100644
index 0000000000000000000000000000000000000000..1fb9b4392b4a278266fd00ff02e77e20763be7ba
--- /dev/null
+++ b/internal/apps/homarr/target_traefik.go
@@ -0,0 +1,236 @@
+package homarr
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"math"
+	"net/http"
+	"slices"
+	"strconv"
+	"strings"
+
+	"github.com/ajnart/self-host/internal/apps/traefik"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func traefikTarget() target {
+	return target{
+		id: "traefik", name: "Traefik", kind: "traefik", internal: fixed("http://traefik:8080"),
+		secrets: func(_, to *helpers.H) []secret {
+			return []secret{{Kind: "username", Value: to.AdminUser()}, {Kind: "password", Value: to.AdminPassword()}}
+		},
+		widgets: []widget{{kind: "traefik", options: map[string]any{
+			"showTcp": true, "showUdp": true, "showEntryPoints": true,
+		}}, statWidget("routers", "services", "middlewares")},
+		preflight: func(ctx context.Context, from, to *helpers.H) error {
+			_, err := readTraefikAPI(ctx, from, to)
+			return err
+		},
+		verify: verifyTraefik,
+	}
+}
+
+func readTraefikAPI(ctx context.Context, from, to *helpers.H) (map[string]float64, error) {
+	if to.AdminUser() == "" || to.AdminPassword() == "" {
+		return nil, errors.New("Traefik saved control-interface login is missing; restore it through self-host credentials, then retry self-host setup traefik and self-host setup homarr")
+	}
+	anonymous, err := to.HTTP(ctx, helpers.Request{Path: "/api/version", NoRedirect: true})
+	if err != nil {
+		return nil, traefikRequestError(ctx)
+	}
+	if anonymous.OK() || traefikUnsupportedAuth(anonymous) {
+		return nil, traefikManualAuth(from)
+	}
+	if anonymous.Status != http.StatusUnauthorized {
+		return nil, fmt.Errorf("Traefik protected API probe returned HTTP %d; HTTP 404 means the API route is missing or disabled; retry self-host setup traefik before self-host setup homarr", anonymous.Status)
+	}
+	metrics := map[string]float64{"routers": 0, "services": 0, "middlewares": 0}
+	for _, endpoint := range []string{
+		"entrypoints", "http/routers", "http/services", "http/middlewares",
+		"tcp/routers", "tcp/services", "tcp/middlewares", "udp/routers", "udp/services",
+	} {
+		response, err := to.HTTP(ctx, helpers.Request{
+			Path: "/api/" + endpoint, User: to.AdminUser(), Password: to.AdminPassword(), NoRedirect: true,
+		})
+		if err != nil {
+			return nil, traefikRequestError(ctx)
+		}
+		if traefikUnsupportedAuth(response) {
+			return nil, traefikManualAuth(from)
+		}
+		if response.Status != http.StatusOK {
+			return nil, fmt.Errorf("Traefik %s returned HTTP %d; repair the existing protected API and retry self-host setup traefik before self-host setup homarr", endpoint, response.Status)
+		}
+		nextPage, err := strconv.Atoi(response.Header.Get("X-Next-Page"))
+		if err != nil || nextPage < 1 {
+			return nil, fmt.Errorf("Traefik %s returned invalid pagination metadata; complete resource counts cannot be verified", endpoint)
+		}
+		if nextPage != 1 {
+			from.Info("Homarr 2.4.1 reads only the first 100 Traefik resources per endpoint. This API has another page, so complete counts cannot be verified. Keep routing unchanged and use a manually configured dashboard that supports the existing resource set.")
+			return nil, helpers.ErrManual
+		}
+		var resources []struct {
+			Name        string   `json:"name"`
+			Provider    string   `json:"provider"`
+			Status      string   `json:"status"`
+			Type        string   `json:"type"`
+			Service     string   `json:"service"`
+			Middlewares []string `json:"middlewares"`
+		}
+		if response.Decode(&resources) != nil || resources == nil {
+			return nil, fmt.Errorf("Traefik %s returned malformed data, not an explicit resource list; retry self-host setup traefik", endpoint)
+		}
+		owned := false
+		for _, resource := range resources {
+			if resource.Name == "" || endpoint != "entrypoints" && (resource.Provider == "" || !slices.Contains([]string{"enabled", "disabled", "warning", "error"}, resource.Status)) {
+				return nil, fmt.Errorf("Traefik %s returned incomplete resource data; retry self-host setup traefik", endpoint)
+			}
+			switch endpoint {
+			case "entrypoints":
+				owned = owned || resource.Name == "health"
+			case "http/routers":
+				if resource.Name == "selfhost-api@file" && resource.Provider == "file" && resource.Status == "enabled" && resource.Service == "api@internal" && (slices.Contains(resource.Middlewares, "selfhost-auth@file") || slices.Contains(resource.Middlewares, "selfhost-auth")) {
+					owned = true
+				}
+			case "http/services":
+				owned = owned || resource.Name == "api@internal" && resource.Provider == "internal" && resource.Status == "enabled"
+			case "http/middlewares":
+				owned = owned || resource.Name == "selfhost-auth@file" && resource.Provider == "file" && resource.Status == "enabled" && resource.Type == "basicauth"
+			}
+		}
+		if (endpoint == "entrypoints" || strings.HasPrefix(endpoint, "http/")) && !owned {
+			return nil, fmt.Errorf("Traefik %s has no enabled owned management resource; restore the existing protected file-provider configuration and retry self-host setup traefik", endpoint)
+		}
+		if endpoint != "entrypoints" {
+			_, metric, _ := strings.Cut(endpoint, "/")
+			metrics[metric] += float64(len(resources))
+		}
+	}
+	if err := (traefik.App{}).Check(ctx, to); err != nil {
+		return nil, err
+	}
+	return metrics, nil
+}
+
+func traefikUnsupportedAuth(response helpers.Response) bool {
+	if response.Status >= 300 && response.Status < 400 || response.Status == http.StatusForbidden {
+		return true
+	}
+	return response.Status == http.StatusUnauthorized && !strings.HasPrefix(strings.ToLower(strings.TrimSpace(response.Header.Get("WWW-Authenticate"))), "basic ")
+}
+
+func traefikManualAuth(from *helpers.H) error {
+	from.Info("Traefik's existing API protection is not the supported saved BasicAuth login. Keep its authentication and routing unchanged; review the existing protected API with its owner before retrying self-host setup traefik and self-host setup homarr. No unauthenticated or bearer fallback will be attempted.")
+	return helpers.ErrManual
+}
+
+func traefikRequestError(ctx context.Context) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	return errors.New("Traefik protected API request failed before an HTTP response; retry self-host setup traefik")
+}
+
+func verifyTraefik(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	metrics, err := readTraefikAPI(ctx, from, to)
+	if err != nil {
+		return err
+	}
+	value, err := apiKeyProcedure(ctx, from, "widget.traefik.getDashboard", map[string]any{"integrationIds": []string{integrationID}})
+	if err != nil {
+		return errors.New("Homarr could not read the Traefik dashboard; check the protected API and saved login, then retry self-host setup homarr")
+	}
+	sources, ok := value.([]any)
+	if !ok || len(sources) != 1 {
+		return errors.New("Homarr did not return the requested Traefik dashboard")
+	}
+	source, ok := sources[0].(map[string]any)
+	if !ok || stringField(source, "integrationId") != integrationID || source["error"] != nil {
+		return errors.New("Homarr returned a failed or mismatched Traefik dashboard")
+	}
+	dashboard, ok := source["dashboard"].(map[string]any)
+	if !ok || stringField(dashboard, "version") != "3.6.22" {
+		return errors.New("Homarr did not return the pinned Traefik 3.6.22 dashboard")
+	}
+	failed, ok := dashboard["failedEndpoints"].([]any)
+	if !ok || len(failed) != 0 {
+		return errors.New("Homarr returned incomplete Traefik API data; failed endpoints are not empty datasets; repair the protected API and retry self-host setup homarr")
+	}
+	entryPoints, ok := dashboard["entryPoints"].([]any)
+	if !ok || !slices.Contains(entryPoints, any("health")) {
+		return errors.New("Homarr did not return Traefik's management entry point")
+	}
+	for _, entryPoint := range entryPoints {
+		if name, ok := entryPoint.(string); !ok || name == "" {
+			return errors.New("Homarr returned malformed Traefik entry points")
+		}
+	}
+	for _, protocol := range []string{"http", "tcp", "udp"} {
+		group, ok := dashboard[protocol].(map[string]any)
+		if !ok {
+			return errors.New("Homarr returned incomplete Traefik protocol summaries")
+		}
+		for _, kind := range []string{"routers", "services", "middlewares"} {
+			if protocol == "udp" && kind == "middlewares" {
+				continue
+			}
+			summary, ok := group[kind].(map[string]any)
+			if !ok || !traefikSummaryValid(summary) {
+				return errors.New("Homarr returned malformed Traefik resource summaries")
+			}
+			if protocol == "http" && summary["total"].(float64) == 0 {
+				return errors.New("Homarr returned an empty Traefik management resource summary; retry self-host setup homarr")
+			}
+		}
+	}
+	resources, ok := dashboard["resources"].([]any)
+	if !ok || len(resources) == 0 || len(resources) > 200 {
+		return errors.New("Homarr did not return bounded Traefik resource details")
+	}
+	for _, raw := range resources {
+		resource, ok := raw.(map[string]any)
+		if !ok || stringField(resource, "name") == "" || !slices.Contains([]string{"http", "tcp", "udp"}, stringField(resource, "protocol")) || !slices.Contains([]string{"router", "service", "middleware"}, stringField(resource, "type")) || !slices.Contains([]string{"enabled", "disabled", "warning", "error", "unknown"}, stringField(resource, "status")) {
+			return errors.New("Homarr returned malformed Traefik resource details")
+		}
+	}
+	value, err = apiKeyWrite(ctx, from, "widget.stats.refresh", map[string]any{"integrationId": integrationID, "force": true})
+	if err != nil {
+		return errors.New("Homarr could not refresh Traefik statistics; retry self-host setup homarr")
+	}
+	snapshot, ok := value.(map[string]any)
+	if !ok {
+		return errors.New("Homarr did not return Traefik statistics")
+	}
+	failedRefresh, hasError := snapshot["error"].(bool)
+	stale, hasStale := snapshot["stale"].(bool)
+	updated, hasUpdated := snapshot["updatedAt"].(float64)
+	if !hasError || failedRefresh || !hasStale || stale || !hasUpdated || updated <= 0 || math.IsNaN(updated) || math.IsInf(updated, 0) {
+		return errors.New("Homarr Traefik statistics are unavailable or stale; retry self-host setup homarr")
+	}
+	values, ok := snapshot["values"].(map[string]any)
+	if !ok {
+		return errors.New("Homarr did not return Traefik statistic values")
+	}
+	for _, key := range []string{"routers", "services", "middlewares"} {
+		count, ok := traefikCount(values[key])
+		if !ok || count != metrics[key] {
+			return errors.New("Homarr Traefik counts are incomplete or changed during verification; retry self-host setup homarr after the protected API is ready")
+		}
+	}
+	return nil
+}
+
+func traefikCount(value any) (float64, bool) {
+	count, ok := value.(float64)
+	return count, ok && count >= 0 && !math.IsNaN(count) && !math.IsInf(count, 0) && math.Trunc(count) == count
+}
+
+func traefikSummaryValid(summary map[string]any) bool {
+	for _, key := range []string{"total", "enabled", "warnings", "errors"} {
+		if _, ok := traefikCount(summary[key]); !ok {
+			return false
+		}
+	}
+	return summary["enabled"].(float64)+summary["warnings"].(float64)+summary["errors"].(float64) <= summary["total"].(float64)
+}
diff --git a/internal/apps/homarr/target_transmission.go b/internal/apps/homarr/target_transmission.go
new file mode 100644
index 0000000000000000000000000000000000000000..162c0a17efce8ca6277bfa35585d0f4894d90461
--- /dev/null
+++ b/internal/apps/homarr/target_transmission.go
@@ -0,0 +1,92 @@
+package homarr
+
+import (
+	"context"
+	"errors"
+	"math"
+	"slices"
+
+	"github.com/ajnart/self-host/internal/apps/transmission"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func transmissionTarget() target {
+	return target{
+		id: "transmission", name: "Transmission", kind: "transmission", internal: fixed("http://transmission:9091"),
+		secrets: func(_, to *helpers.H) []secret {
+			return []secret{{Kind: "username", Value: to.AdminUser()}, {Kind: "password", Value: to.AdminPassword()}}
+		},
+		widgets: []widget{{kind: "downloads", options: map[string]any{
+			"columns":             []string{"name", "progress", "downSpeed", "upSpeed", "state"},
+			"limitPerIntegration": 50, "showCompletedTorrent": true,
+		}}, statWidget("download", "upload", "paused")},
+		preflight: func(ctx context.Context, _, to *helpers.H) error {
+			return transmission.VerifyHomarr(ctx, to)
+		},
+		verify: verifyTransmission,
+	}
+}
+
+func transmissionNumbers(value map[string]any, keys ...string) bool {
+	for _, key := range keys {
+		number, ok := value[key].(float64)
+		if !ok || number < 0 || math.IsNaN(number) || math.IsInf(number, 0) {
+			return false
+		}
+	}
+	return true
+}
+
+func verifyTransmission(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	if err := transmission.VerifyHomarr(ctx, to); err != nil {
+		return err
+	}
+	value, err := apiKeyProcedure(ctx, from, "widget.downloads.getJobsAndStatuses", map[string]any{
+		"integrationIds": []string{integrationID}, "limitPerIntegration": 50,
+	})
+	if err != nil {
+		return err
+	}
+	results, ok := value.([]any)
+	if !ok || len(results) != 1 {
+		return errors.New("Homarr did not return Transmission's download data; retry self-host setup homarr")
+	}
+	result, _ := results[0].(map[string]any)
+	integration, _ := result["integration"].(map[string]any)
+	data, _ := result["data"].(map[string]any)
+	if result["error"] != nil || stringField(result, "integrationId") != integrationID || stringField(integration, "id") != integrationID || stringField(integration, "kind") != "transmission" || data == nil {
+		return errors.New("Homarr could not read the owned Transmission integration; verify its RPC login and access policy, then retry self-host setup homarr")
+	}
+	status, _ := data["status"].(map[string]any)
+	rates, _ := status["rates"].(map[string]any)
+	types, _ := status["types"].([]any)
+	_, pausedOK := status["paused"].(bool)
+	items, itemsOK := data["items"].([]any)
+	if !pausedOK || !itemsOK || !slices.Contains(types, any("torrent")) || !transmissionNumbers(rates, "down", "up") {
+		return errors.New("Homarr returned incomplete Transmission queue status or rates; an explicit empty items array and valid rates are required for an empty queue")
+	}
+	for _, raw := range items {
+		item, _ := raw.(map[string]any)
+		itemTime, timeOK := item["time"].(float64)
+		if !timeOK || math.IsNaN(itemTime) || math.IsInf(itemTime, 0) || stringField(item, "id") == "" || stringField(item, "name") == "" || stringField(item, "type") != "torrent" || !transmissionNumbers(item, "index", "size", "sent", "received", "upSpeed", "progress") {
+			return errors.New("Homarr returned incomplete Transmission download items; retry self-host setup homarr")
+		}
+		progress := item["progress"].(float64)
+		index := item["index"].(float64)
+		if progress > 1 || math.Trunc(index) != index || progress < 1 && !transmissionNumbers(item, "downSpeed") || !slices.Contains([]string{"paused", "stalled", "leeching", "seeding"}, stringField(item, "state")) {
+			return errors.New("Homarr returned unsupported Transmission download items; retry self-host setup homarr")
+		}
+	}
+	value, err = apiKeyWrite(ctx, from, "widget.stats.refresh", map[string]any{"integrationId": integrationID, "force": true})
+	if err != nil {
+		return err
+	}
+	snapshot, _ := value.(map[string]any)
+	statistics, _ := snapshot["values"].(map[string]any)
+	updatedAt, updatedOK := snapshot["updatedAt"].(float64)
+	_, pausedOK = statistics["paused"].(bool)
+	if snapshot["error"] != false || snapshot["stale"] != false || !updatedOK || updatedAt <= 0 || !pausedOK || !transmissionNumbers(statistics, "download", "upload") {
+		return errors.New("Homarr did not return fresh Transmission Stats; verify its RPC login and retry self-host setup homarr")
+	}
+	return nil
+}
diff --git a/internal/apps/homarr/target_umami.go b/internal/apps/homarr/target_umami.go
new file mode 100644
index 0000000000000000000000000000000000000000..290ca9d2d71e2b472f3d26567ecefa5e225fda09
--- /dev/null
+++ b/internal/apps/homarr/target_umami.go
@@ -0,0 +1,109 @@
+package homarr
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/ajnart/self-host/internal/apps/umami"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func umamiTarget() target {
+	return target{
+		id: "umami", name: "Umami", kind: "umami", internal: fixed("http://umami:3000/api"),
+		secrets: func(_, to *helpers.H) []secret {
+			return []secret{
+				{Kind: "username", Value: to.Secret(to.Key("homarr_username"))},
+				{Kind: "password", Value: to.Secret(to.Key("homarr_password"))},
+			}
+		},
+		widgets: []widget{{kind: "umami", bind: func(ctx context.Context, to *helpers.H, _ string) (map[string]any, error) {
+			id, err := umami.HomarrWebsiteID(ctx, to)
+			if err != nil {
+				return nil, err
+			}
+			return map[string]any{
+				"websiteId": id, "timeFrame": "24h", "viewMode": "chart",
+				"chartType": "bar", "chartStyle": "grouped", "eventName": "", "eventNames": []string{}, "topCount": 5,
+			}, nil
+		}}},
+		preflight: func(ctx context.Context, from, to *helpers.H) error {
+			if err := umami.VerifyHomarr(ctx, to); err != nil {
+				if errors.Is(err, helpers.ErrManual) {
+					from.Info("Run self-host setup umami to repair its recorded Homarr account and fixture website, then retry self-host setup homarr; no manual website or account is adopted")
+				}
+				return err
+			}
+			return nil
+		},
+		verify: verifyUmami,
+	}
+}
+
+func verifyUmami(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	if err := umami.VerifyHomarr(ctx, to); err != nil {
+		return err
+	}
+	websiteID := to.Secret(to.Key("homarr_website_id"))
+	value, err := apiKeyProcedure(ctx, from, "widget.umami.getWebsites", map[string]any{"integrationId": integrationID})
+	if err != nil {
+		return err
+	}
+	websites, ok := value.([]any)
+	if !ok || len(websites) != 1 {
+		return errors.New("Homarr did not return the isolated Umami fixture website; retry self-host setup umami and self-host setup homarr")
+	}
+	website, _ := websites[0].(map[string]any)
+	if stringField(website, "id") != websiteID || stringField(website, "name") == "" || stringField(website, "domain") == "" {
+		return errors.New("Homarr returned a different or incomplete Umami website")
+	}
+	value, err = apiKeyProcedure(ctx, from, "widget.umami.getVisitorStats", map[string]any{
+		"integrationIds": []string{integrationID}, "websiteId": websiteID, "timeFrame": "24h",
+	})
+	if err != nil {
+		return err
+	}
+	results, ok := value.([]any)
+	if !ok || len(results) != 1 {
+		return errors.New("Homarr did not return Umami visitor statistics")
+	}
+	result, _ := results[0].(map[string]any)
+	stats, _ := result["visitorStats"].(map[string]any)
+	if stringField(result, "integrationId") != integrationID || stringField(stats, "websiteId") != websiteID || stringField(stats, "timeFrame") != "24h" {
+		return errors.New("Homarr returned Umami statistics for a different website or time window")
+	}
+	updatedAt, err := time.Parse(time.RFC3339Nano, stringField(result, "updatedAt"))
+	now := from.Now()
+	if err != nil || now.Sub(updatedAt) > time.Minute || updatedAt.After(now.Add(time.Minute)) {
+		return errors.New("Homarr returned missing or stale Umami statistics; check the Host clock and retry self-host setup homarr")
+	}
+	for _, metric := range []string{"totalVisitors", "totalPageviews", "totalVisits", "bounceRate", "avgDuration"} {
+		count, ok := stats[metric].(float64)
+		if !ok || count < 0 {
+			return errors.New("Homarr returned incomplete Umami statistics; missing values are not zero")
+		}
+	}
+	points, ok := stats["dataPoints"].([]any)
+	if !ok {
+		return errors.New("Homarr did not return the Umami visitor series")
+	}
+	for _, raw := range points {
+		point, _ := raw.(map[string]any)
+		visitors, ok := point["visitors"].(float64)
+		if !ok || visitors < 0 || stringField(point, "timestamp") == "" {
+			return errors.New("Homarr returned an invalid Umami visitor data point")
+		}
+	}
+	value, err = apiKeyProcedure(ctx, from, "widget.umami.getActiveVisitors", map[string]any{
+		"integrationId": integrationID, "websiteId": websiteID,
+	})
+	if err != nil {
+		return err
+	}
+	active, ok := value.(float64)
+	if !ok || active < 0 {
+		return errors.New("Homarr did not explicitly return Umami active visitors")
+	}
+	return nil
+}
diff --git a/internal/apps/homarr/target_uptime_kuma.go b/internal/apps/homarr/target_uptime_kuma.go
new file mode 100644
index 0000000000000000000000000000000000000000..35dcc69cfa1b35aa7a300c39c4426e174d1c3c00
--- /dev/null
+++ b/internal/apps/homarr/target_uptime_kuma.go
@@ -0,0 +1,117 @@
+package homarr
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"math"
+	"slices"
+
+	"github.com/ajnart/self-host/internal/apps/uptimekuma"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func uptimeKumaTarget() target {
+	return target{
+		id: "uptime-kuma", name: "Uptime Kuma", kind: "uptimeKuma", internal: fixed("http://uptime-kuma:3001"),
+		secrets: func(_, to *helpers.H) []secret {
+			return []secret{{Kind: "slug", Value: uptimekuma.HomarrSlug(to)}}
+		},
+		widgets: []widget{{kind: "uptimeKuma", options: map[string]any{
+			"showAverageUptime": true, "showUptimeRing": true, "showTotalMonitors": true,
+			"showUpCount": true, "showDownCount": true, "showPausedCount": true,
+		}}, statWidget("totalMonitors", "upCount", "downCount", "averageUptimePercent")},
+		preflight: func(ctx context.Context, from, to *helpers.H) error {
+			_, err := uptimekuma.HomarrMonitors(ctx, to)
+			if errors.Is(err, helpers.ErrManual) {
+				from.Info("Run self-host setup uptime-kuma to review its administrator and explicitly selected status page, then retry self-host setup homarr. No page or monitor will be created or published by this Link.")
+			}
+			return err
+		},
+		verify: verifyUptimeKuma,
+	}
+}
+
+func verifyUptimeKuma(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	monitors, err := uptimekuma.HomarrMonitors(ctx, to)
+	if err != nil {
+		return err
+	}
+	value, err := apiKeyProcedure(ctx, from, "widget.uptimeKuma.getDashboard", map[string]any{"integrationIds": []string{integrationID}})
+	if err != nil {
+		return err
+	}
+	var results []struct {
+		IntegrationID string `json:"integrationId"`
+		Error         any    `json:"error"`
+		Dashboard     *struct {
+			Total    *int64   `json:"totalMonitors"`
+			Up       *int64   `json:"upCount"`
+			Down     *int64   `json:"downCount"`
+			Paused   *int64   `json:"pausedCount"`
+			Average  *float64 `json:"averageUptimePercent"`
+			Monitors *[]struct {
+				ID     *int64          `json:"id"`
+				Name   *string         `json:"name"`
+				Status *string         `json:"status"`
+				Uptime json.RawMessage `json:"uptimePercent24h"`
+			} `json:"monitors"`
+		} `json:"dashboard"`
+	}
+	raw, err := json.Marshal(value)
+	if err != nil || json.Unmarshal(raw, &results) != nil || len(results) != 1 || results[0].IntegrationID != integrationID || results[0].Error != nil {
+		return errors.New("Homarr did not return the owned Uptime Kuma dashboard; retry self-host setup homarr")
+	}
+	dashboard := results[0].Dashboard
+	if dashboard == nil || dashboard.Total == nil || dashboard.Up == nil || dashboard.Down == nil || dashboard.Paused == nil || dashboard.Average == nil || dashboard.Monitors == nil || *dashboard.Total != int64(len(monitors)) || len(*dashboard.Monitors) != len(monitors) {
+		return errors.New("Homarr returned incomplete Uptime Kuma statistics; retry self-host setup homarr")
+	}
+	counts := map[string]int64{}
+	remaining := map[int64]int{}
+	for _, monitor := range monitors {
+		remaining[monitor.ID]++
+	}
+	uptimeSum := 0.0
+	uptimeCount := 0.0
+	for _, monitor := range *dashboard.Monitors {
+		if monitor.ID == nil || monitor.Name == nil || monitor.Status == nil || !slices.Contains([]string{"up", "down", "paused"}, *monitor.Status) || len(monitor.Uptime) == 0 {
+			return errors.New("Homarr returned invalid Uptime Kuma monitor statuses")
+		}
+		if remaining[*monitor.ID] == 0 || !slices.ContainsFunc(monitors, func(expected uptimekuma.HomarrMonitor) bool {
+			return expected.ID == *monitor.ID && expected.Name == *monitor.Name
+		}) {
+			return errors.New("Homarr did not return the explicitly selected Uptime Kuma monitors; retry Setup")
+		}
+		var uptime *float64
+		if json.Unmarshal(monitor.Uptime, &uptime) != nil || uptime != nil && (*uptime < 0 || *uptime > 100) {
+			return errors.New("Homarr returned an invalid Uptime Kuma uptime percentage")
+		}
+		if uptime != nil {
+			uptimeSum += *uptime
+			uptimeCount++
+		}
+		remaining[*monitor.ID]--
+		counts[*monitor.Status]++
+	}
+	if *dashboard.Up != counts["up"] || *dashboard.Down != counts["down"] || *dashboard.Paused != counts["paused"] || math.Abs(*dashboard.Average-uptimeSum/math.Max(uptimeCount, 1)) > 0.000001 {
+		return errors.New("Homarr returned inconsistent Uptime Kuma status counts or uptime")
+	}
+	value, err = apiKeyProcedure(ctx, from, "widget.stats.catalog", map[string]any{"integrationId": integrationID})
+	if err != nil {
+		return err
+	}
+	catalog, _ := value.(map[string]any)
+	metrics, _ := catalog["metrics"].([]any)
+	for _, key := range []string{"totalMonitors", "upCount", "downCount", "averageUptimePercent"} {
+		if !slices.ContainsFunc(metrics, func(raw any) bool {
+			metric, _ := raw.(map[string]any)
+			return stringField(metric, "key") == key
+		}) {
+			return errors.New("Homarr is missing a supported Uptime Kuma Stats field; retry Setup with Homarr 2.4.1")
+		}
+	}
+	if len(monitors) == 0 {
+		from.Info("The selected Uptime Kuma status page is valid but empty; no monitor health or rendered widget result has been verified.")
+	}
+	return nil
+}
diff --git a/internal/apps/homarr/target_wud.go b/internal/apps/homarr/target_wud.go
new file mode 100644
index 0000000000000000000000000000000000000000..e2d3015be11583f9b7b970ae4dda41954f18da20
--- /dev/null
+++ b/internal/apps/homarr/target_wud.go
@@ -0,0 +1,126 @@
+package homarr
+
+import (
+	"context"
+	"errors"
+	"math"
+	"time"
+
+	"github.com/ajnart/self-host/internal/apps/wud"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func wudTarget() target {
+	return target{
+		id: "wud", name: "What's Up Docker", kind: "wud", internal: fixed("http://wud:3000"),
+		secrets: func(_, to *helpers.H) []secret {
+			return []secret{{Kind: "username", Value: to.AdminUser()}, {Kind: "password", Value: to.AdminPassword()}}
+		},
+		widgets: []widget{{kind: "wud", options: map[string]any{
+			"showTitle": true, "showRing": true, "layout": "horizontal", "showUpdateList": true,
+		}}, statWidget("totalContainers", "updatesAvailable")},
+		preflight: preflightWUD,
+		verify:    verifyWUD,
+	}
+}
+
+func preflightWUD(ctx context.Context, from, to *helpers.H) error {
+	statistics, err := wud.ReadHomarrStats(ctx, to)
+	if err != nil {
+		return err
+	}
+	if statistics.TotalContainers == 0 {
+		from.Info("WUD authenticated successfully but returned an empty inventory. Approve a Project-only read-only Docker endpoint and an owned watched image, then retry self-host setup wud and self-host setup homarr. This Link does not configure discovery or mount a Docker socket.")
+		return helpers.ErrManual
+	}
+	return nil
+}
+
+func verifyWUD(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	expected, err := wud.ReadHomarrStats(ctx, to)
+	if err != nil {
+		return err
+	}
+	started := from.Now()
+	value, err := apiKeyWrite(ctx, from, "widget.stats.refresh", map[string]any{"integrationId": integrationID, "force": true})
+	if err != nil {
+		return err
+	}
+	snapshot, ok := value.(map[string]any)
+	if !ok {
+		return errors.New("Homarr did not return WUD statistics; retry self-host setup homarr")
+	}
+	failed, hasError := snapshot["error"].(bool)
+	stale, hasStale := snapshot["stale"].(bool)
+	updatedAt, hasTime := snapshot["updatedAt"].(float64)
+	if !hasError || failed || !hasStale || stale || !hasTime || math.IsNaN(updatedAt) || math.IsInf(updatedAt, 0) || updatedAt < float64(started.UnixMilli()) || updatedAt > float64(from.Now().Add(time.Second).UnixMilli()) {
+		return errors.New("Homarr could not refresh authenticated WUD statistics; check its saved connection and retry self-host setup homarr")
+	}
+	statistics, ok := snapshot["values"].(map[string]any)
+	if !ok || !wudCountsMatch(statistics, expected) {
+		return errors.New("Homarr WUD statistics are incomplete or differ from its current inventory; retry self-host setup homarr")
+	}
+	value, err = apiKeyProcedure(ctx, from, "widget.wud.getStats", map[string]any{"integrationId": integrationID})
+	if err != nil {
+		return err
+	}
+	result, ok := value.(map[string]any)
+	if !ok {
+		return errors.New("Homarr did not return WUD container updates; retry self-host setup homarr")
+	}
+	stamp, ok := result["updatedAt"].(string)
+	fetchedAt, err := time.Parse(time.RFC3339Nano, stamp)
+	if !ok || err != nil || fetchedAt.Before(from.Now().Add(-10*time.Second)) || fetchedAt.After(from.Now().Add(time.Second)) {
+		return errors.New("Homarr WUD widget returned missing or stale data; retry self-host setup homarr")
+	}
+	statistics, ok = result["stats"].(map[string]any)
+	if !ok || !wudCountsMatch(statistics, expected) {
+		return errors.New("Homarr WUD widget counts differ from its current inventory; retry self-host setup homarr")
+	}
+	updates, ok := statistics["updates"].([]any)
+	if !ok || len(updates) != expected.UpdatesAvailable {
+		return errors.New("Homarr returned incomplete WUD container updates; retry self-host setup homarr")
+	}
+	for index, raw := range updates {
+		update, ok := raw.(map[string]any)
+		if !ok {
+			return errors.New("Homarr returned malformed WUD container updates; retry self-host setup homarr")
+		}
+		if !wudUpdateMatches(update, expected.Updates[index]) {
+			return errors.New("Homarr WUD container updates differ from its current inventory; retry self-host setup homarr")
+		}
+	}
+	return nil
+}
+
+func wudUpdateMatches(actual map[string]any, expected wud.HomarrUpdate) bool {
+	id, hasID := actual["id"].(string)
+	name, hasName := actual["name"].(string)
+	if !hasID || !hasName || id != expected.ID || name != expected.Name {
+		return false
+	}
+	for key, expected := range map[string]*string{
+		"currentVersion": expected.CurrentVersion, "newVersion": expected.NewVersion, "link": expected.Link,
+	} {
+		value, exists := actual[key]
+		if !exists {
+			return false
+		}
+		if expected == nil {
+			if value != nil {
+				return false
+			}
+			continue
+		}
+		if value != *expected {
+			return false
+		}
+	}
+	return true
+}
+
+func wudCountsMatch(statistics map[string]any, expected wud.HomarrStatistics) bool {
+	total, hasTotal := statistics["totalContainers"].(float64)
+	updates, hasUpdates := statistics["updatesAvailable"].(float64)
+	return hasTotal && hasUpdates && total == float64(expected.TotalContainers) && updates == float64(expected.UpdatesAvailable)
+}

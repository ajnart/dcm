new file mode 100644
index 0000000000000000000000000000000000000000..93f51120fc30d6d682bfe4e75d75021fd521e278
--- /dev/null
+++ b/internal/apps/homarr/target_speedtest_tracker.go
@@ -0,0 +1,93 @@
+package homarr
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"reflect"
+	"time"
+
+	"github.com/ajnart/self-host/internal/apps/speedtesttracker"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func speedtestTrackerTarget() target {
+	return target{
+		id: "speedtest-tracker", name: "Speedtest Tracker", kind: "speedtestTracker",
+		internal: fixed("http://speedtest-tracker:80"),
+		secrets: func(_, to *helpers.H) []secret {
+			return []secret{{Kind: "apiKey", Value: to.Secret(to.Key("homarr_api_key"))}}
+		},
+		widgets: []widget{{kind: "speedtestTracker", options: map[string]any{
+			"showLatestResult": true, "showStats": true, "showRecentResults": true, "showPingGraph": true,
+		}}},
+		preflight: func(ctx context.Context, from, to *helpers.H) error {
+			_, err := speedtesttracker.ReadHomarr(ctx, to)
+			if errors.Is(err, helpers.ErrManual) {
+				from.Info(err.Error())
+			}
+			return err
+		},
+		verify: verifySpeedtestTracker,
+	}
+}
+
+func verifySpeedtestTracker(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	actual, err := speedtesttracker.ReadHomarr(ctx, to)
+	if err != nil {
+		return err
+	}
+	value, err := apiKeyProcedure(ctx, from, "widget.speedtestTracker.getDashboard", map[string]any{"integrationIds": []string{integrationID}})
+	if err != nil {
+		return err
+	}
+	raw, err := json.Marshal(value)
+	if err != nil {
+		return err
+	}
+	var dashboards []struct {
+		IntegrationID string                       `json:"integrationId"`
+		Dashboard     *speedtesttracker.HomarrData `json:"dashboard"`
+		UpdatedAt     string                       `json:"updatedAt"`
+		Error         json.RawMessage              `json:"error"`
+	}
+	if json.Unmarshal(raw, &dashboards) != nil || len(dashboards) != 1 {
+		return errors.New("Homarr did not return the Speedtest Tracker dashboard; retry self-host setup homarr")
+	}
+	current := dashboards[0]
+	data := current.Dashboard
+	updated, err := time.Parse(time.RFC3339Nano, current.UpdatedAt)
+	if err != nil || updated.IsZero() || updated.Unix() <= 0 || current.IntegrationID != integrationID || len(current.Error) > 0 && string(current.Error) != "null" || data == nil || data.LatestResult == nil || data.Stats == nil || data.RecentResults == nil {
+		return errors.New("Homarr returned an unavailable Speedtest Tracker dashboard; retry its connection and Setup")
+	}
+	if data.LatestResult.Validate() != nil || !data.LatestResult.SameMeasurement(*actual.LatestResult) || data.Stats.Validate() != nil || !reflect.DeepEqual(data.Stats, actual.Stats) {
+		return errors.New("Homarr Speedtest Tracker values do not match fresh measured results; wait for its cache to refresh and retry Setup")
+	}
+	location := time.UTC
+	if zone := from.Settings["TZ"]; zone != "" {
+		location, err = time.LoadLocation(zone)
+		if err != nil {
+			return errors.New("Homarr time zone is unsupported; review Host settings and retry Setup")
+		}
+	}
+	expected, err := actual.LatestResult.Timestamp(location)
+	created, nativeErr := time.Parse(time.RFC3339Nano, data.LatestResult.CreatedAt)
+	if err != nil || nativeErr != nil || !created.Equal(expected) {
+		return errors.New("Homarr did not preserve the latest Speedtest Tracker timestamp; review time zones and retry Setup")
+	}
+	if len(data.RecentResults) != len(actual.RecentResults) {
+		return errors.New("Homarr Speedtest Tracker history differs from its fresh source; wait for its cache to refresh and retry Setup")
+	}
+	for index, result := range data.RecentResults {
+		if result.Validate() != nil || !speedtestHistoryCurrent(result, actual.RecentResults[index], location) {
+			return errors.New("Homarr returned incomplete Speedtest Tracker history; retry Setup")
+		}
+	}
+	return nil
+}
+
+func speedtestHistoryCurrent(native, actual speedtesttracker.Result, location *time.Location) bool {
+	expected, err := actual.Timestamp(location)
+	created, nativeErr := time.Parse(time.RFC3339Nano, native.CreatedAt)
+	return err == nil && nativeErr == nil && created.Equal(expected) && reflect.DeepEqual(native.ID, actual.ID) && reflect.DeepEqual(native.Ping, actual.Ping) && reflect.DeepEqual(native.DownloadBits, actual.DownloadBits) && reflect.DeepEqual(native.UploadBits, actual.UploadBits) && string(native.Healthy) == string(actual.Healthy)
+}
diff --git a/internal/apps/homarr/target_tdarr.go b/internal/apps/homarr/target_tdarr.go
new file mode 100644
index 0000000000000000000000000000000000000000..a8dc738504065f2d133d9d0e68b2bf17bd830539
--- /dev/null
+++ b/internal/apps/homarr/target_tdarr.go
@@ -0,0 +1,164 @@
+package homarr
+
+import (
+	"context"
+	"errors"
+	"math"
+
+	"github.com/ajnart/self-host/internal/apps/tdarr"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func tdarrTarget() target {
+	return target{
+		id: "tdarr", name: "Tdarr", kind: "tdarr", internal: fixed("http://tdarr:8266"),
+		secrets: func(_, to *helpers.H) []secret {
+			return []secret{{Kind: "apiKey", Value: to.Secret(to.Key("homarr_api_key"))}}
+		},
+		widgets: []widget{{kind: "mediaTranscoding", options: map[string]any{
+			"defaultView": "statistics", "queuePageSize": 10,
+		}}, statWidget("totalFileCount", "totalTranscodeCount", "failedTranscodeCount")},
+		preflight: preflightTdarr,
+		verify:    verifyTdarr,
+	}
+}
+
+func preflightTdarr(ctx context.Context, from, to *helpers.H) error {
+	data, err := tdarr.ReadHomarr(ctx, to)
+	if err != nil {
+		return err
+	}
+	if data.NodeCount == 0 {
+		from.Info("Tdarr's server API answers, but no nodes are connected. Restore the existing internal node's saved API key and retry self-host setup tdarr, then self-host setup homarr. Connecting another node or enabling workers needs separate approval.")
+		return helpers.ErrManual
+	}
+	if data.UnpausedNodes == 0 {
+		from.Info("Tdarr's connected nodes are all paused. Review the node and media permissions before approving processing, then retry self-host setup homarr; Setup will not unpause nodes or enable workers.")
+		return helpers.ErrManual
+	}
+	if data.WorkerCount == 0 {
+		from.Info("Tdarr has a connected node but no running workers. Homarr can show empty queues and server statistics; this does not verify processing or hardware. Workers remain disabled until separately approved.")
+	}
+	return nil
+}
+
+func tdarrNumber(record map[string]any, key string, count bool) bool {
+	value, ok := record[key].(float64)
+	if !ok || math.IsNaN(value) || math.IsInf(value, 0) {
+		return false
+	}
+	return !count || value >= 0 && math.Trunc(value) == value
+}
+
+func tdarrText(record map[string]any, key string) bool {
+	_, ok := record[key].(string)
+	return ok
+}
+
+func verifyTdarr(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	if err := preflightTdarr(ctx, from, to); err != nil {
+		return err
+	}
+	value, err := apiKeyProcedure(ctx, from, "widget.mediaTranscoding.getDataAsync", map[string]any{
+		"integrationId": integrationID, "page": 1, "pageSize": 10,
+	})
+	if err != nil {
+		return err
+	}
+	response, ok := value.(map[string]any)
+	if !ok || response["integrationId"] != integrationID {
+		return errors.New("Homarr did not return the owned Tdarr integration's native data")
+	}
+	data, ok := response["data"].(map[string]any)
+	if !ok {
+		return errors.New("Homarr returned malformed Tdarr data")
+	}
+	statistics, ok := data["statistics"].(map[string]any)
+	if !ok || statistics["libraryName"] != "All" || !tdarrNumber(statistics, "totalSavedSpace", false) {
+		return errors.New("Homarr returned incomplete Tdarr media statistics")
+	}
+	for _, key := range []string{"totalFileCount", "totalTranscodeCount", "totalHealthCheckCount", "failedTranscodeCount", "failedHealthCheckCount", "stagedTranscodeCount", "stagedHealthCheckCount"} {
+		if !tdarrNumber(statistics, key, true) {
+			return errors.New("Homarr returned incomplete Tdarr counts; explicit zeros are valid")
+		}
+	}
+	for _, key := range []string{"transcodeStatus", "healthCheckStatus", "videoCodecs", "videoContainers", "videoResolutions", "audioCodecs", "audioContainers"} {
+		segments, ok := statistics[key].([]any)
+		if !ok {
+			return errors.New("Homarr returned incomplete Tdarr chart data")
+		}
+		for _, raw := range segments {
+			segment, ok := raw.(map[string]any)
+			if !ok || !tdarrText(segment, "name") || !tdarrNumber(segment, "value", true) {
+				return errors.New("Homarr returned malformed Tdarr chart data")
+			}
+		}
+	}
+	queue, ok := data["queue"].(map[string]any)
+	if !ok || !tdarrNumber(queue, "totalCount", true) || queue["startIndex"] != float64(0) {
+		return errors.New("Homarr returned incomplete Tdarr queue data")
+	}
+	items, ok := queue["array"].([]any)
+	if !ok || len(items) > 10 || queue["totalCount"].(float64) < float64(len(items)) || queue["endIndex"] != float64(len(items)-1) {
+		return errors.New("Homarr returned malformed Tdarr queue pagination")
+	}
+	for _, raw := range items {
+		item, ok := raw.(map[string]any)
+		if !ok || !tdarrNumber(item, "fileSize", false) || item["type"] != "transcode" && item["type"] != "health-check" {
+			return errors.New("Homarr returned malformed Tdarr queue entries")
+		}
+		for _, key := range []string{"id", "healthCheck", "transcode", "filePath", "container", "codec", "resolution"} {
+			if !tdarrText(item, key) {
+				return errors.New("Homarr returned incomplete Tdarr queue entries")
+			}
+		}
+	}
+	workers, ok := data["workers"].([]any)
+	if !ok {
+		return errors.New("Homarr returned incomplete Tdarr worker data")
+	}
+	for _, raw := range workers {
+		worker, ok := raw.(map[string]any)
+		if !ok {
+			return errors.New("Homarr returned malformed Tdarr worker data")
+		}
+		for _, key := range []string{"id", "filePath", "ETA", "jobType", "status", "step"} {
+			if !tdarrText(worker, key) {
+				return errors.New("Homarr returned incomplete Tdarr worker data")
+			}
+		}
+		for _, key := range []string{"fps", "percentage", "originalSize"} {
+			if !tdarrNumber(worker, key, false) {
+				return errors.New("Homarr returned incomplete Tdarr worker measurements")
+			}
+		}
+		for _, key := range []string{"estimatedSize", "outputSize"} {
+			value, found := worker[key]
+			if !found || value != nil && !tdarrNumber(worker, key, false) {
+				return errors.New("Homarr returned incomplete optional Tdarr worker measurements")
+			}
+		}
+	}
+	value, err = apiKeyWrite(ctx, from, "widget.stats.refresh", map[string]any{"integrationId": integrationID, "force": true})
+	if err != nil {
+		return err
+	}
+	snapshot, ok := value.(map[string]any)
+	if !ok || snapshot["error"] != false || snapshot["stale"] != false || !tdarrNumber(snapshot, "updatedAt", true) {
+		return errors.New("Homarr's Tdarr Stats refresh is unavailable; retry self-host setup homarr")
+	}
+	updated := snapshot["updatedAt"].(float64)
+	if age := float64(from.Now().UnixMilli()) - updated; updated <= 0 || age < -60_000 || age > 300_000 {
+		return errors.New("Homarr returned stale Tdarr Stats; retry self-host setup homarr")
+	}
+	metrics, ok := snapshot["values"].(map[string]any)
+	if !ok {
+		return errors.New("Homarr returned malformed Tdarr Stats")
+	}
+	for _, key := range []string{"totalFileCount", "totalTranscodeCount", "failedTranscodeCount"} {
+		if !tdarrNumber(metrics, key, true) {
+			return errors.New("Homarr returned incomplete Tdarr Stats; explicit zeros are valid")
+		}
+	}
+	return nil
+}
diff --git a/internal/apps/homarr/target_technitium_dns.go b/internal/apps/homarr/target_technitium_dns.go
new file mode 100644
index 0000000000000000000000000000000000000000..e17379c0935afad33650ecbc6e3d5e189b716edc
--- /dev/null

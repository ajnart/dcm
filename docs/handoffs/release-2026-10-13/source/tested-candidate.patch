+		"Private-input ingestion requires reinstall, which replaces apps/nextcloud/compose.yml and generated credential files. Preserve and review existing authentication, mounts and ports, and obtain separate approval for replacement first. If existing custom configuration cannot survive replacement, stop: there is no credentials-only ingestion command. " +
+		"Only after approval, run: self-host install nextcloud --yes --set-file nextcloud.homarr_app_password=/owned/private/app-password --set-file nextcloud.homarr_app_password_id=/owned/private/token-id. " +
+		"To discard obsolete credentials, explicitly revoke only self-host Homarr first, then use that command with both files containing c-l-e-a-r (without hyphens); empty files do not erase saved values. " +
+		"If the matching credential or ID is unknown, recovery remains Manual; do not infer an ID from the token name or a working login. If two-factor authentication rejects account-password API login, headless reissuance remains Manual; restore an explicitly matched app password and ID instead. Never disable two-factor authentication. Retry self-host setup nextcloud, then self-host setup homarr. " +
+		"The default app password retains administrator and file-write authority; it is not read-only."
+}
+
+type authToken struct {
+	ID    int             `json:"id"`
+	Name  string          `json:"name"`
+	Type  *int            `json:"type"`
+	Scope map[string]bool `json:"scope"`
+}
+
+func homarrToken(ctx context.Context, h *helpers.H) (*authToken, error) {
+	if h.Config.Exec == nil {
+		return nil, errors.New("Nextcloud needs its Project container to discover app passwords; run self-host setup nextcloud")
+	}
+	result, err := h.Exec(ctx, map[string]string{"SELF_HOST_NEXTCLOUD_USER": h.AdminUser()},
+		"su", "-m", "-s", "/bin/sh", "www-data", "-c", `php occ user:auth-tokens:list --output=json -- "$SELF_HOST_NEXTCLOUD_USER"`)
+	if err != nil {
+		return nil, errors.New("Nextcloud app-password discovery failed; run self-host setup nextcloud")
+	}
+	var tokens []authToken
+	if json.Unmarshal(result.Stdout, &tokens) != nil || tokens == nil {
+		return nil, errors.New("Nextcloud returned incomplete app-password metadata")
+	}
+	var found *authToken
+	for _, token := range tokens {
+		if token.Name != homarrPasswordName && strconv.Itoa(token.ID) != h.Secret(h.Key("homarr_app_password_id")) {
+			continue
+		}
+		_, filesystemScope := token.Scope["filesystem"]
+		if found != nil || token.ID <= 0 || token.Name != homarrPasswordName || token.Type == nil || *token.Type != 1 || len(token.Scope) != 1 || !filesystemScope {
+			h.Info(HomarrRecoveryHint(h))
+			return nil, helpers.ErrManual
+		}
+		found = &token
+	}
+	return found, nil
+}
+
+func homarrPasswordWorks(ctx context.Context, h *helpers.H) (bool, error) {
+	if h.Secret(h.Key("homarr_app_password")) == "" {
+		return false, nil
+	}
+	if h.Secret(h.Key("homarr_app_password_id")) == "" {
+		return false, nil
+	}
+	err := VerifyHomarr(ctx, h)
+	return err == nil, err
+}
+
+func prepareHomarrPassword(ctx context.Context, h *helpers.H) error {
+	token, err := homarrToken(ctx, h)
+	if err != nil {
+		return err
+	}
+	password := h.Secret(h.Key("homarr_app_password"))
+	id := h.Secret(h.Key("homarr_app_password_id"))
+	if password == "clear" || id == "clear" {
+		if password != "clear" || id != "clear" || token != nil {
+			h.Info(HomarrRecoveryHint(h))
+			return helpers.ErrManual
+		}
+		if err := h.SetSecret(h.Key("homarr_app_password"), ""); err != nil {
+			return err
+		}
+		if err := h.SetSecret(h.Key("homarr_app_password_id"), ""); err != nil {
+			return err
+		}
+		password, id = "", ""
+	}
+	if token != nil {
+		if password == "" || id == "" {
+			h.Info(HomarrRecoveryHint(h))
+			return helpers.ErrManual
+		}
+		return VerifyHomarr(ctx, h)
+	}
+	if password != "" || id != "" {
+		h.Info(HomarrRecoveryHint(h))
+		return helpers.ErrManual
+	}
+	h.Info("Nextcloud's Homarr app password retains administrator and file-write authority; Nextcloud's headless app-password command does not offer read-only scopes.")
+	result, err := h.Exec(ctx, map[string]string{"SELF_HOST_NEXTCLOUD_USER": h.AdminUser(), "NC_PASS": h.AdminPassword()},
+		"su", "-m", "-s", "/bin/sh", "www-data", "-c", `php occ user:auth-tokens:add --no-interaction --password-from-env --name 'self-host Homarr' -- "$SELF_HOST_NEXTCLOUD_USER"`)
+	if err != nil {
+		return errors.New("Nextcloud could not create its Homarr app password; inspect Personal settings > Security before retrying")
+	}
+	_, password, ok := strings.Cut(string(result.Stdout), "app password:\n")
+	password = strings.TrimSpace(password)
+	if !ok || len(password) != 72 || strings.ContainsAny(password, " \t\r\n") {
+		return errors.New("Nextcloud did not return its app password; inspect Personal settings > Security before retrying")
+	}
+	if err := h.SetSecret(h.Key("homarr_app_password"), password); err != nil {
+		return err
+	}
+	token, err = homarrToken(ctx, h)
+	if err != nil {
+		return err
+	}
+	if token == nil {
+		return errors.New("Nextcloud did not return its created app-password metadata")
+	}
+	return h.SetSecret(h.Key("homarr_app_password_id"), strconv.Itoa(token.ID))
+}
+
+var errAuthentication = errors.New("Nextcloud rejected the saved credential; run self-host setup nextcloud")
+
+func readOCS(ctx context.Context, h *helpers.H, path, password string, data any) error {
+	resp, err := h.HTTP(ctx, helpers.Request{
+		Path: path, NoRedirect: true, User: h.AdminUser(), Password: password,
+		Header: map[string]string{"OCS-APIRequest": "true"},
+	})
+	if err != nil {
+		return err
+	}
+	if resp.Status == 401 || resp.Status == 403 {
+		return errAuthentication
+	}
+	if resp.Status != 200 {
+		return fmt.Errorf("Nextcloud API returned HTTP %d; run self-host setup nextcloud", resp.Status)
+	}
+	var body struct {
+		OCS struct {
+			Meta struct {
+				Status     string
+				StatusCode int
+			}
+			Data json.RawMessage
+		}
+	}
+	if resp.Decode(&body) != nil || body.OCS.Meta.Status != "ok" || body.OCS.Meta.StatusCode != 200 || len(body.OCS.Data) == 0 || string(body.OCS.Data) == "null" {
+		return errors.New("Nextcloud returned an OCS error or incomplete API data; run self-host setup nextcloud")
+	}
+	if json.Unmarshal(body.OCS.Data, data) != nil {
+		return errors.New("Nextcloud returned invalid API data; run self-host setup nextcloud")
+	}
+	return nil
+}
+
+func VerifyHomarr(ctx context.Context, h *helpers.H) error {
+	if ok, err := installed(ctx, h); err != nil {
+		return err
+	} else if !ok {
+		return errors.New("Nextcloud installation is incomplete; run self-host setup nextcloud")
+	}
+	if ok, err := projectHostsWork(ctx, h); err != nil {
+		return err
+	} else if !ok {
+		return errors.New("Nextcloud does not trust its Project addresses; run self-host setup nextcloud")
+	}
+	password := h.Secret(h.Key("homarr_app_password"))
+	id := h.Secret(h.Key("homarr_app_password_id"))
+	if password == "" || id == "" || password == "clear" || id == "clear" {
+		h.Info(HomarrRecoveryHint(h))
+		return helpers.ErrManual
+	}
+	token, err := homarrToken(ctx, h)
+	if err != nil {
+		return err
+	}
+	if token == nil || id != strconv.Itoa(token.ID) {
+		h.Info(HomarrRecoveryHint(h))
+		return helpers.ErrManual
+	}
+	var account struct {
+		ID     string
+		Groups []string
+	}
+	if err := readOCS(ctx, h, "/ocs/v2.php/cloud/user?format=json", password, &account); err != nil {
+		return err
+	}
+	if account.ID != h.AdminUser() || !slices.Contains(account.Groups, "admin") {
+		return errors.New("Nextcloud Homarr app password does not belong to the Project administrator")
+	}
+	var notifications []struct {
+		ID                         *int `json:"notification_id"`
+		Datetime, Subject, Message *string
+	}
+	if err := readOCS(ctx, h, "/ocs/v2.php/apps/notifications/api/v2/notifications?format=json", password, &notifications); err != nil {
+		return err
+	}
+	if notifications == nil {
+		return errors.New("Nextcloud did not return a notification list")
+	}
+	for _, notification := range notifications {
+		if notification.ID == nil || *notification.ID <= 0 || notification.Datetime == nil || notification.Subject == nil || notification.Message == nil {
+			return errors.New("Nextcloud returned incomplete notifications")
+		}
+		if _, err := time.Parse(time.RFC3339, *notification.Datetime); err != nil {
+			return errors.New("Nextcloud returned an invalid notification time")
+		}
+	}
+	resp, err := h.HTTP(ctx, helpers.Request{
+		Method: "PROPFIND", Path: "/remote.php/dav/principals/users/" + url.PathEscape(account.ID) + "/", NoRedirect: true,
+		User: h.AdminUser(), Password: password,
+		Header: map[string]string{"Depth": "0", "Content-Type": "application/xml"},
+		Body:   []byte(`<d:propfind xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav"><d:prop><c:calendar-home-set/></d:prop></d:propfind>`),
+	})
+	if err != nil {
+		return err
+	}
+	if resp.Status != 207 {
+		return fmt.Errorf("Nextcloud calendar discovery returned HTTP %d; run self-host setup nextcloud", resp.Status)
+	}
+	var dav struct {
+		XMLName   xml.Name `xml:"DAV: multistatus"`
+		Responses []struct {
+			Properties []struct {
+				Status string `xml:"DAV: status"`
+				Prop   struct {
+					CalendarHome struct {
+						Href string `xml:"DAV: href"`
+					} `xml:"urn:ietf:params:xml:ns:caldav calendar-home-set"`
+				} `xml:"DAV: prop"`
+			} `xml:"DAV: propstat"`
+		} `xml:"DAV: response"`
+	}
+	if xml.Unmarshal(resp.Body, &dav) != nil {
+		return errors.New("Nextcloud returned invalid calendar discovery data")
+	}
+	for _, response := range dav.Responses {
+		for _, property := range response.Properties {
+			if property.Status == "HTTP/1.1 200 OK" && property.Prop.CalendarHome.Href != "" {
+				return nil
+			}
+		}
+	}
+	return errors.New("Nextcloud calendar discovery did not return the account's calendar home; run self-host setup nextcloud")
+}
diff --git a/internal/apps/nzbget/homarr.go b/internal/apps/nzbget/homarr.go
new file mode 100644
index 0000000000000000000000000000000000000000..a3b71ff882f6dc496402a8682e3baaa54e96060d
--- /dev/null
+++ b/internal/apps/nzbget/homarr.go
@@ -0,0 +1,240 @@
+package nzbget
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+const homarrUsername = "self-host-homarr"
+
+func callRPC(ctx context.Context, h *helpers.H, username, password, method string, result any) error {
+	id := "selfhost-" + method
+	response, err := h.HTTP(ctx, helpers.Request{
+		Method: http.MethodPost, Path: "/jsonrpc", NoRedirect: true,
+		User: username, Password: password,
+		JSON: map[string]any{"version": "1.1", "method": method, "params": []any{}, "id": id},
+	})
+	if err != nil {
+		return fmt.Errorf("NZBGet %s could not be reached; retry self-host setup nzbget", method)
+	}
+	if response.Status != http.StatusOK {
+		return fmt.Errorf("NZBGet %s returned HTTP %d; retry self-host setup nzbget", method, response.Status)
+	}
+	var body struct {
+		ID     string          `json:"id"`
+		Error  json.RawMessage `json:"error"`
+		Result json.RawMessage `json:"result"`
+	}
+	if response.Decode(&body) != nil || body.ID != id || len(body.Error) > 0 && string(body.Error) != "null" || len(body.Result) == 0 || string(body.Result) == "null" || json.Unmarshal(body.Result, result) != nil {
+		return fmt.Errorf("NZBGet returned an invalid %s response; retry self-host setup nzbget", method)
+	}
+	return nil
+}
+
+type restrictedAccount struct {
+	username string
+	password string
+}
+
+func restrictedLogin(ctx context.Context, h *helpers.H, method string) (restrictedAccount, error) {
+	var entries []struct {
+		Name  string
+		Value *string
+	}
+	if err := callRPC(ctx, h, h.AdminUser(), h.AdminPassword(), method, &entries); err != nil {
+		return restrictedAccount{}, err
+	}
+	account := restrictedAccount{}
+	found := map[string]bool{}
+	for _, entry := range entries {
+		if entry.Name != "RestrictedUsername" && entry.Name != "RestrictedPassword" {
+			continue
+		}
+		if entry.Value == nil || found[entry.Name] {
+			return account, errors.New("NZBGet returned incomplete restricted-user settings")
+		}
+		found[entry.Name] = true
+		if entry.Name == "RestrictedUsername" {
+			account.username = *entry.Value
+		} else {
+			account.password = *entry.Value
+		}
+	}
+	if len(found) != 2 {
+		return account, errors.New("NZBGet did not return its restricted-user settings")
+	}
+	return account, nil
+}
+
+func VerifyHomarr(ctx context.Context, h *helpers.H) error {
+	username, password := h.Secret(h.Key("homarr_username")), h.Secret(h.Key("homarr_password"))
+	if username != homarrUsername || password == "" {
+		return errors.New("NZBGet Homarr login is missing; run self-host setup nzbget")
+	}
+	if username == h.AdminUser() || password == h.AdminPassword() || strings.ContainsAny(password, "\r\n") {
+		return errors.New("NZBGet Homarr access must use a separate restricted login; review its saved credential through the Project secret boundary")
+	}
+	if ok, err := adminWorks(ctx, h); err != nil || !ok {
+		return errors.New("NZBGet must reject anonymous RPC and accept the Admin login on version 26.3; run self-host setup nzbget")
+	}
+	for _, method := range []string{"config", "loadconfig"} {
+		account, err := restrictedLogin(ctx, h, method)
+		if err != nil {
+			return err
+		}
+		if account.username != username || account.password != password {
+			return errors.New("NZBGet Homarr login does not match its active and saved restricted user; run self-host setup nzbget")
+		}
+	}
+	var currentVersion string
+	if err := callRPC(ctx, h, username, password, "version", &currentVersion); err != nil {
+		return err
+	}
+	if currentVersion != version {
+		return errors.New("NZBGet Homarr access requires version 26.3; back up NZBGet before changing its version, then retry Setup")
+	}
+	var status struct {
+		DownloadPaused *bool
+		DownloadRate   *int64
+	}
+	if err := callRPC(ctx, h, username, password, "status", &status); err != nil {
+		return err
+	}
+	if status.DownloadPaused == nil || status.DownloadRate == nil || *status.DownloadRate < 0 {
+		return errors.New("NZBGet did not return its download rate and queue state")
+	}
+	for _, method := range []string{"listgroups", "history"} {
+		var items []map[string]any
+		if err := callRPC(ctx, h, username, password, method, &items); err != nil {
+			return err
+		}
+		if items == nil {
+			return errors.New("NZBGet did not return its queue and history lists")
+		}
+		for _, item := range items {
+			nameKey := "NZBName"
+			stateKey := "Status"
+			numericKeys := []string{"FileSizeLo", "FileSizeHi", "MaxPriority", "ActiveDownloads", "RemainingSizeLo", "RemainingSizeHi", "DownloadTimeSec", "DownloadedSizeMB", "FileSizeMB"}
+			if method == "history" {
+				nameKey = "Name"
+				stateKey = "ScriptStatus"
+				numericKeys = []string{"FileSizeLo", "FileSizeHi", "HistoryTime", "DownloadTimeSec"}
+			}
+			id, ok := item["NZBID"].(float64)
+			name, _ := item[nameKey].(string)
+			if !ok || id <= 0 || name == "" {
+				return errors.New("NZBGet returned incomplete queue or history items")
+			}
+			state, _ := item[stateKey].(string)
+			if _, ok := item["Category"].(string); !ok || state == "" {
+				return errors.New("NZBGet returned incomplete queue or history items")
+			}
+			for _, key := range numericKeys {
+				value, ok := item[key].(float64)
+				if !ok || key != "MaxPriority" && value < 0 {
+					return errors.New("NZBGet returned incomplete queue or history items")
+				}
+			}
+		}
+	}
+	return nil
+}
+
+func prepareHomarr(ctx context.Context, h *helpers.H) error {
+	if err := VerifyHomarr(ctx, h); err == nil {
+		return nil
+	}
+	if ok, err := adminWorks(ctx, h); err != nil || !ok {
+		return errors.New("cannot verify the NZBGet Admin login before preparing restricted access")
+	}
+	active, err := restrictedLogin(ctx, h, "config")
+	if err != nil {
+		return err
+	}
+	saved, err := restrictedLogin(ctx, h, "loadconfig")
+	if err != nil {
+		return err
+	}
+	expected := restrictedAccount{h.Secret(h.Key("homarr_username")), h.Secret(h.Key("homarr_password"))}
+	for _, account := range []restrictedAccount{active, saved} {
+		if account == (restrictedAccount{}) {
+			continue
+		}
+		if expected.username != homarrUsername || expected.password == "" || account != expected {
+			h.Info("NZBGet restricted access already exists. Restore the managed login through the Project secret boundary, or explicitly clear only the restricted-user slot in NZBGet settings, then run self-host setup nzbget. No existing account was changed.")
+			return helpers.ErrManual
+		}
+	}
+	if expected.username != "" && expected.username != homarrUsername {
+		return errors.New("NZBGet saved Homarr username needs review through the Project secret boundary")
+	}
+	if homarrUsername == h.AdminUser() || expected.password != "" && (expected.password == h.AdminPassword() || strings.ContainsAny(expected.password, "\r\n")) {
+		return errors.New("NZBGet Homarr access must use a separate restricted login; review its saved credential through the Project secret boundary")
+	}
+	if expected.password == "" {
+		expected.password = rand.Text()
+		if err := h.SetSecret(h.Key("homarr_password"), expected.password); err != nil {
+			return err
+		}
+	}
+	if expected.username == "" {
+		expected.username = homarrUsername
+		if err := h.SetSecret(h.Key("homarr_username"), expected.username); err != nil {
+			return err
+		}
+	}
+	if saved != expected {
+		if _, err := h.ExecSecret(ctx, map[string]string{"HOMARR_USERNAME": expected.username, "HOMARR_PASSWORD": expected.password}, `set -eu
+file=/config/nzbget.conf
+test -f "$file"
+test ! -L "$file"
+temp=$(mktemp /config/.self-host-homarr.XXXXXX)
+trap 'rm -f "$temp"' EXIT
+awk '
+BEGIN { username = ENVIRON["HOMARR_USERNAME"]; password = ENVIRON["HOMARR_PASSWORD"] }
+/^[[:space:]]*RestrictedUsername[[:space:]]*=/ {
+  value = $0; sub(/^[^=]*=/, "", value); sub(/\r$/, "", value)
+  if (++users != 1 || (value != "" && value != username)) exit 1
+  print "RestrictedUsername=" username; next
+}
+/^[[:space:]]*RestrictedPassword[[:space:]]*=/ {
+  value = $0; sub(/^[^=]*=/, "", value); sub(/\r$/, "", value)
+  if (++passwords != 1 || (value != "" && value != password)) exit 1
+  print "RestrictedPassword=" password; next
+}
+{ print }
+END { if (users != 1 || passwords != 1) exit 1 }
+' "$file" > "$temp"
+python3 - "$file" "$temp" <<'PY'
+import os
+import stat
+import sys
+
+original = os.stat(sys.argv[1], follow_symlinks=False)
+if not stat.S_ISREG(original.st_mode):
+    raise RuntimeError("NZBGet configuration must be a regular file")
+os.chown(sys.argv[2], original.st_uid, original.st_gid)
+PY
+chmod 600 "$temp"
+mv "$temp" "$file"`); err != nil {
+			return errors.New("NZBGet restricted-user settings could not be confirmed saved with preserved ownership; review the configuration permissions and restricted-user slot, then retry self-host setup nzbget with the same managed login")
+		}
+	}
+	if active != expected {
+		if err := h.Restart(ctx); err != nil {
+			return errors.New("NZBGet restricted-user settings are saved, but its scoped restart failed; retry self-host setup nzbget to apply the same managed login")
+		}
+	}
+	return h.Poll(ctx, 2*time.Minute, func(ctx context.Context) (bool, error) {
+		err := VerifyHomarr(ctx, h)
+		return err == nil, err
+	})
+}

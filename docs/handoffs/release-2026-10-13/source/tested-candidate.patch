+package homarr
+
+import (
+	"context"
+	"errors"
+
+	"github.com/ajnart/self-host/internal/apps/prometheus"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func prometheusTarget() target {
+	return target{
+		id: "prometheus", name: "Prometheus", kind: "prometheus", internal: fixed("http://prometheus:9090"),
+		secrets: func(_, to *helpers.H) []secret {
+			user, password := to.Secret(to.Key("username")), to.Secret(to.Key("password"))
+			if user == "" && password == "" {
+				return []secret{}
+			}
+			return []secret{{Kind: "username", Value: user}, {Kind: "password", Value: password}}
+		},
+		widgets: []widget{statWidget("total", "up", "down")},
+		preflight: func(ctx context.Context, from, to *helpers.H) error {
+			_, err := prometheus.VerifyHomarr(ctx, to)
+			if errors.Is(err, helpers.ErrManual) {
+				from.Info("Preserve Prometheus authentication and its scrape configuration. Run self-host setup prometheus for the private credential or self-scrape recovery instructions, then retry self-host setup homarr.")
+			}
+			return err
+		},
+		verify: verifyPrometheus,
+	}
+}
+
+func verifyPrometheus(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	counts, err := prometheus.VerifyHomarr(ctx, to)
+	if err != nil {
+		return err
+	}
+	value, err := apiKeyProcedure(ctx, from, "widget.stats.catalog", map[string]any{"integrationId": integrationID})
+	if err != nil {
+		return err
+	}
+	catalog, ok := value.(map[string]any)
+	if !ok {
+		return errors.New("Homarr did not return the Prometheus metric catalog")
+	}
+	metrics, _ := catalog["metrics"].([]any)
+	for _, key := range []string{"total", "up", "down"} {
+		found := false
+		for _, raw := range metrics {
+			metric, _ := raw.(map[string]any)
+			if stringField(metric, "key") == key && stringField(metric, "unit") == "count" {
+				found = true
+			}
+		}
+		if !found {
+			return errors.New("Homarr does not expose the supported Prometheus target-count metrics; retry self-host setup homarr with Homarr 2.4.1")
+		}
+	}
+	values, err := freshStatsSnapshot(ctx, from, integrationID)
+	if err != nil {
+		return err
+	}
+	for key, expected := range map[string]int{"total": counts.Total, "up": counts.Up, "down": counts.Down} {
+		actual, ok := values[key].(float64)
+		if !ok || actual != float64(expected) {
+			return errors.New("Homarr returned incomplete or changed Prometheus target counts; retry self-host setup homarr")
+		}
+	}
+	return nil
+}
diff --git a/internal/apps/homarr/target_sabnzbd.go b/internal/apps/homarr/target_sabnzbd.go
new file mode 100644
index 0000000000000000000000000000000000000000..5d047a545dcd7f1deea03e9b1d34a505d1cf1756
--- /dev/null
+++ b/internal/apps/homarr/target_sabnzbd.go
@@ -0,0 +1,148 @@
+package homarr
+
+import (
+	"context"
+	"errors"
+	"math"
+
+	"github.com/ajnart/self-host/internal/apps/sabnzbd"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func sabnzbdTarget() target {
+	return target{
+		id: "sabnzbd", name: "SABnzbd", kind: "sabNzbd", internal: fixed("http://sabnzbd:8080"),
+		secrets: apiKeySecret,
+		widgets: []widget{plain("downloads"), statWidget("download", "paused")},
+		preflight: func(ctx context.Context, from, to *helpers.H) error {
+			err := (sabnzbd.App{}).Check(ctx, to)
+			if errors.Is(err, helpers.ErrManual) {
+				from.Info("SABnzbd needs your existing authorized provider in Config > Servers; run self-host setup sabnzbd, then self-host setup homarr. No provider account is created or tested.")
+			}
+			if err != nil {
+				return err
+			}
+			return sabnzbd.VerifyHomarr(ctx, to)
+		},
+		verify: verifySABnzbd,
+	}
+}
+
+func verifySABnzbd(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	if err := sabnzbd.VerifyHomarr(ctx, to); err != nil {
+		return err
+	}
+	value, err := apiKeyProcedure(ctx, from, "widget.downloads.getJobsAndStatuses", map[string]any{
+		"integrationIds": []string{integrationID}, "limitPerIntegration": 50,
+		"includeArchivedHistory": false, "historyWindowDays": 7,
+	})
+	if err != nil {
+		return err
+	}
+	results, ok := value.([]any)
+	if !ok || len(results) != 1 {
+		return errors.New("Homarr did not return SABnzbd download data")
+	}
+	result, ok := results[0].(map[string]any)
+	if !ok || stringField(result, "integrationId") != integrationID || result["error"] != nil {
+		return errors.New("Homarr could not read SABnzbd downloads; repair its full API key and private connection, then retry self-host setup homarr")
+	}
+	data, _ := result["data"].(map[string]any)
+	status, _ := data["status"].(map[string]any)
+	rates, _ := status["rates"].(map[string]any)
+	rate, numeric := rates["down"].(float64)
+	_, paused := status["paused"].(bool)
+	items, hasItems := data["items"].([]any)
+	if !numeric || math.IsNaN(rate) || math.IsInf(rate, 0) || rate < 0 || !paused || !hasItems {
+		return errors.New("Homarr returned incomplete SABnzbd downloads; an empty queue must explicitly contain items and a nonnegative download rate")
+	}
+	for _, item := range items {
+		if !validSABnzbdItem(item) {
+			return errors.New("Homarr returned incomplete SABnzbd download items; check the queue/history data and retry self-host setup homarr")
+		}
+	}
+	catalog, err := apiKeyProcedure(ctx, from, "widget.stats.catalog", map[string]any{"integrationId": integrationID})
+	if err != nil {
+		return err
+	}
+	record, _ := catalog.(map[string]any)
+	metrics, _ := record["metrics"].([]any)
+	for _, expected := range []string{"download", "paused"} {
+		found := false
+		for _, raw := range metrics {
+			metric, _ := raw.(map[string]any)
+			if stringField(metric, "key") == expected {
+				found = true
+			}
+		}
+		if !found {
+			return errors.New("Homarr does not expose the supported SABnzbd Stats fields; use Homarr 2.4.1 and retry Setup")
+		}
+	}
+	snapshot, err := apiKeyWrite(ctx, from, "widget.stats.refresh", map[string]any{"integrationId": integrationID, "force": false})
+	if err != nil {
+		return err
+	}
+	record, _ = snapshot.(map[string]any)
+	values, _ := record["values"].(map[string]any)
+	failed, hasError := record["error"].(bool)
+	stale, hasStale := record["stale"].(bool)
+	updatedAt, hasTimestamp := record["updatedAt"].(float64)
+	rate, numeric = values["download"].(float64)
+	_, paused = values["paused"].(bool)
+	if !hasError || failed || !hasStale || stale || !hasTimestamp || updatedAt <= 0 || !numeric || math.IsNaN(rate) || math.IsInf(rate, 0) || rate < 0 || !paused {
+		return errors.New("Homarr SABnzbd Stats are unavailable or incomplete; retry self-host setup homarr after checking its private connection and full API key")
+	}
+	return nil
+}
+
+func validSABnzbdItem(raw any) bool {
+	item, ok := raw.(map[string]any)
+	if !ok || item["type"] != "usenet" {
+		return false
+	}
+	for _, key := range []string{"id", "name"} {
+		value, ok := item[key].(string)
+		if !ok || value == "" {
+			return false
+		}
+	}
+	switch item["state"] {
+	case "downloading", "queued", "paused", "completed", "failed", "processing":
+	default:
+		return false
+	}
+	for _, key := range []string{"index", "size", "time", "progress"} {
+		value, ok := item[key].(float64)
+		if !ok || math.IsNaN(value) || math.IsInf(value, 0) {
+			return false
+		}
+		if key == "size" && value < 0 || key == "progress" && (value < 0 || value > 1) {
+			return false
+		}
+	}
+	for _, key := range []string{"sent", "received", "downSpeed", "upSpeed", "added"} {
+		raw, present := item[key]
+		if !present {
+			continue
+		}
+		value, ok := raw.(float64)
+		if !ok || math.IsNaN(value) || math.IsInf(value, 0) || key != "added" && value < 0 {
+			return false
+		}
+	}
+	if category, present := item["category"]; present {
+		switch value := category.(type) {
+		case string:
+		case []any:
+			for _, raw := range value {
+				if _, ok := raw.(string); !ok {
+					return false
+				}
+			}
+		default:
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/apps/homarr/target_slskd.go b/internal/apps/homarr/target_slskd.go
new file mode 100644
index 0000000000000000000000000000000000000000..633fa9a3e9a80b95c04071a2eea771992fa83888
--- /dev/null
+++ b/internal/apps/homarr/target_slskd.go
@@ -0,0 +1,153 @@
+package homarr
+
+import (
+	"context"
+	"errors"
+	"math"
+	"time"
+
+	"github.com/ajnart/self-host/internal/apps/slskd"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func slskdTarget() target {
+	return target{
+		id: "slskd", name: "Slskd", kind: "slskd", internal: fixed("http://slskd:5030"), secrets: apiKeySecret,
+		widgets: []widget{{kind: "downloads", options: map[string]any{
+			"columns": []string{"name", "progress", "size", "time", "state"}, "limitPerIntegration": 50,
+		}}, statWidget("download")},
+		preflight: func(ctx context.Context, from, to *helpers.H) error {
+			if err := slskd.VerifyHomarr(ctx, to); err != nil {
+				return err
+			}
+			if err := slskd.VerifySoulseek(ctx, to); err != nil {
+				if errors.Is(err, helpers.ErrManual) {
+					from.Info("Slskd needs your Soulseek account and an approved connection before this Link can be verified. Configure it privately in Slskd, then run self-host setup slskd and self-host setup homarr; an empty queue is not proof of provider readiness.")
+				}
+				return err
+			}
+			return nil
+		},
+		verify: verifySlskd,
+	}
+}
+
+func verifySlskd(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	if err := slskd.VerifyHomarr(ctx, to); err != nil {
+		return err
+	}
+	if err := slskd.VerifySoulseek(ctx, to); err != nil {
+		return err
+	}
+	const failure = "Homarr returned incomplete Slskd downloads; check Slskd's connection and retry self-host setup homarr"
+	value, err := apiKeyProcedure(ctx, from, "widget.downloads.getJobsAndStatuses", map[string]any{
+		"integrationIds": []string{integrationID}, "limitPerIntegration": 50,
+	})
+	if err != nil {
+		return err
+	}
+	results, ok := value.([]any)
+	if !ok || len(results) != 1 {
+		return errors.New(failure)
+	}
+	result, ok := results[0].(map[string]any)
+	if !ok || stringField(result, "integrationId") != integrationID || result["error"] != nil {
+		return errors.New(failure)
+	}
+	integration, ok := result["integration"].(map[string]any)
+	if !ok || stringField(integration, "id") != integrationID || stringField(integration, "kind") != "slskd" {
+		return errors.New(failure)
+	}
+	updatedAt, err := time.Parse(time.RFC3339Nano, stringField(integration, "updatedAt"))
+	if err != nil || !slskdFresh(from.Now(), updatedAt) {
+		return errors.New("Homarr's Slskd download data is missing or stale; retry self-host setup homarr")
+	}
+	data, ok := result["data"].(map[string]any)
+	if !ok {
+		return errors.New(failure)
+	}
+	status, ok := data["status"].(map[string]any)
+	if !ok {
+		return errors.New(failure)
+	}
+	rates, ok := status["rates"].(map[string]any)
+	if !ok || !slskdNumber(rates["down"]) || rates["up"] != float64(0) || status["paused"] != false {
+		return errors.New(failure)
+	}
+	types, ok := status["types"].([]any)
+	if !ok || len(types) != 1 || types[0] != "miscellaneous" {
+		return errors.New(failure)
+	}
+	items, ok := data["items"].([]any)
+	if !ok || len(items) > 50 {
+		return errors.New(failure)
+	}
+	for _, raw := range items {
+		item, ok := raw.(map[string]any)
+		if !ok || stringField(item, "id") == "" || stringField(item, "name") == "" || stringField(item, "state") == "" || stringField(item, "type") != "miscellaneous" {
+			return errors.New(failure)
+		}
+		for _, key := range []string{"size", "time", "progress", "added", "index"} {
+			if !slskdNumber(item[key]) {
+				return errors.New(failure)
+			}
+		}
+		if item["progress"].(float64) > 1 {
+			return errors.New(failure)
+		}
+	}
+	return verifySlskdStats(ctx, from, integrationID)
+}
+
+func verifySlskdStats(ctx context.Context, h *helpers.H, integrationID string) error {
+	const failure = "Homarr did not return fresh Slskd download statistics; retry self-host setup homarr"
+	value, err := apiKeyProcedure(ctx, h, "widget.stats.catalog", map[string]any{"integrationId": integrationID})
+	if err != nil {
+		return err
+	}
+	catalog, ok := value.(map[string]any)
+	if !ok {
+		return errors.New(failure)
+	}
+	metrics, ok := catalog["metrics"].([]any)
+	if !ok {
+		return errors.New(failure)
+	}
+	found := false
+	for _, raw := range metrics {
+		metric, ok := raw.(map[string]any)
+		if ok && stringField(metric, "key") == "download" && stringField(metric, "unit") == "bytesPerSecond" {
+			found = true
+		}
+	}
+	if !found {
+		return errors.New("Homarr lacks Slskd's supported download statistic in bytes/s; use Homarr 2.4.1 and retry Setup")
+	}
+	value, err = apiKeyWrite(ctx, h, "widget.stats.refresh", map[string]any{"integrationId": integrationID, "force": true})
+	if err != nil {
+		return err
+	}
+	snapshot, ok := value.(map[string]any)
+	if !ok || snapshot["error"] != false || snapshot["stale"] != false || snapshot["retryAt"] != float64(0) {
+		return errors.New(failure)
+	}
+	updatedAt, ok := snapshot["updatedAt"].(float64)
+	if !ok || !slskdNumber(updatedAt) || !slskdFresh(h.Now(), time.UnixMilli(int64(updatedAt))) {
+		return errors.New(failure)
+	}
+	values, ok := snapshot["values"].(map[string]any)
+	if !ok || !slskdNumber(values["download"]) {
+		return errors.New(failure)
+	}
+	return nil
+}
+
+func slskdNumber(value any) bool {
+	number, ok := value.(float64)
+	return ok && number >= 0 && !math.IsNaN(number) && !math.IsInf(number, 0)
+}
+
+func slskdFresh(now, updatedAt time.Time) bool {
+	age := now.Sub(updatedAt)
+	return age >= -time.Minute && age <= time.Minute
+}

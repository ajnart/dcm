+		verify:    verifyNetdata,
+	}
+}
+
+func preflightNetdata(ctx context.Context, from, to *helpers.H) error {
+	err := netdata.VerifyHomarr(ctx, to)
+	if errors.Is(err, helpers.ErrManual) {
+		from.Info("Netdata local API access is denied. Preserve its authentication; Homarr 2.4.1 cannot supply a Netdata credential. Review compatible local access, then retry self-host setup netdata and self-host setup homarr.")
+	}
+	return err
+}
+
+func verifyNetdata(ctx context.Context, from, _ *helpers.H, integrationID string) error {
+	started := from.Now().UnixMilli()
+	value, err := apiKeyWrite(ctx, from, "widget.stats.refresh", map[string]any{"integrationId": integrationID, "force": true})
+	if err != nil {
+		return err
+	}
+	snapshot, ok := value.(map[string]any)
+	if !ok || snapshot["error"] != false || snapshot["stale"] != false {
+		return errors.New("Homarr could not refresh Netdata alarm counts; check local API access and retry self-host setup homarr")
+	}
+	updatedAt, ok := snapshot["updatedAt"].(float64)
+	if !ok || math.IsNaN(updatedAt) || math.IsInf(updatedAt, 0) || updatedAt < float64(started) || updatedAt > float64(from.Now().UnixMilli()+30_000) {
+		return errors.New("Homarr did not return freshly collected Netdata statistics; check its refresh queue and clock, then retry self-host setup homarr")
+	}
+	counts, ok := snapshot["values"].(map[string]any)
+	if !ok {
+		return errors.New("Homarr did not return Netdata alarm counts")
+	}
+	for _, key := range []string{"warnings", "criticals"} {
+		count, ok := counts[key].(float64)
+		if !ok || math.IsNaN(count) || math.IsInf(count, 0) || count < 0 || math.Trunc(count) != count {
+			return errors.New("Homarr returned incomplete Netdata alarm counts; retry self-host setup homarr")
+		}
+	}
+	return nil
+}
diff --git a/internal/apps/homarr/target_nextcloud.go b/internal/apps/homarr/target_nextcloud.go
new file mode 100644
index 0000000000000000000000000000000000000000..f69093a3c0083698f8def9daf85ef684374547d0
--- /dev/null
+++ b/internal/apps/homarr/target_nextcloud.go
@@ -0,0 +1,145 @@
+package homarr
+
+import (
+	"context"
+	"errors"
+
+	"github.com/ajnart/self-host/internal/apps/nextcloud"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func nextcloudTarget() target {
+	return target{
+		id: "nextcloud", name: "Nextcloud", kind: "nextcloud", internal: fixed("http://nextcloud:80"),
+		secrets: func(_, to *helpers.H) []secret {
+			return []secret{
+				{Kind: "username", Value: to.AdminUser()},
+				{Kind: "password", Value: to.Secret(to.Key("homarr_app_password"))},
+			}
+		},
+		widgets: []widget{plain("calendar"), plain("notifications"), statWidget("messages")},
+		preflight: func(ctx context.Context, from, to *helpers.H) error {
+			err := nextcloud.VerifyHomarr(ctx, to)
+			if errors.Is(err, helpers.ErrManual) {
+				from.Info(nextcloud.HomarrRecoveryHint(to))
+			}
+			return err
+		},
+		verify: verifyNextcloud,
+	}
+}
+
+func verifyNextcloud(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	if err := nextcloud.VerifyHomarr(ctx, to); err != nil {
+		return err
+	}
+	value, err := apiKeyProcedure(ctx, from, "integration.byId", map[string]any{"id": integrationID})
+	if err != nil {
+		return err
+	}
+	saved, ok := value.(map[string]any)
+	if !ok || stringField(saved, "id") != integrationID || stringField(saved, "kind") != "nextcloud" {
+		return errors.New("Homarr did not return the saved Nextcloud integration")
+	}
+	credentials, ok := saved["secrets"].([]any)
+	if !ok || len(credentials) != 2 {
+		return errors.New("Homarr returned incomplete saved Nextcloud credential metadata; retry self-host setup homarr")
+	}
+	username, password := false, false
+	for _, raw := range credentials {
+		credential, _ := raw.(map[string]any)
+		switch stringField(credential, "kind") {
+		case "username":
+			if username || to.AdminUser() == "" || stringField(credential, "value") != to.AdminUser() {
+				return errors.New("Homarr's saved Nextcloud account does not match the Project administrator; retry self-host setup homarr")
+			}
+			username = true
+		case "password":
+			redacted, present := credential["value"]
+			if password || !present || redacted != nil {
+				return errors.New("Homarr returned invalid saved Nextcloud password metadata")
+			}
+			password = true
+		}
+	}
+	if !username || !password {
+		return errors.New("Homarr did not return the saved Nextcloud username and password metadata")
+	}
+	value, err = apiKeyProcedure(ctx, from, "widget.notifications.getNotifications", map[string]any{"integrationIds": []string{integrationID}})
+	if err != nil {
+		return err
+	}
+	results, ok := value.([]any)
+	if !ok || len(results) != 1 {
+		return errors.New("Homarr did not return Nextcloud notifications")
+	}
+	result, ok := results[0].(map[string]any)
+	if !ok || result["error"] != nil {
+		return errors.New("Homarr could not read Nextcloud notifications; run self-host setup nextcloud, then self-host setup homarr")
+	}
+	integration, _ := result["integration"].(map[string]any)
+	if stringField(integration, "id") != integrationID || stringField(integration, "kind") != "nextcloud" {
+		return errors.New("Homarr returned notifications for another integration")
+	}
+	if _, ok := result["data"].([]any); !ok {
+		return errors.New("Homarr returned an incomplete Nextcloud notification list")
+	}
+	now := from.Now()
+	value, err = apiKeyProcedure(ctx, from, "widget.calendar.findAllEvents", map[string]any{
+		"integrationIds": []string{integrationID}, "year": now.Year(), "month": int(now.Month()),
+		"releaseType": []string{}, "showUnmonitored": false,
+	})
+	if err != nil {
+		return err
+	}
+	results, ok = value.([]any)
+	if !ok || len(results) != 1 {
+		return errors.New("Homarr did not return Nextcloud calendar events")
+	}
+	result, ok = results[0].(map[string]any)
+	if !ok || result["error"] != nil {
+		return errors.New("Homarr could not read Nextcloud calendars; run self-host setup nextcloud, then self-host setup homarr")
+	}
+	integration, _ = result["integration"].(map[string]any)
+	if stringField(integration, "id") != integrationID || stringField(integration, "kind") != "nextcloud" {
+		return errors.New("Homarr returned calendar events for another integration")
+	}
+	if _, ok := result["events"].([]any); !ok {
+		return errors.New("Homarr returned an incomplete Nextcloud calendar event list")
+	}
+	value, err = apiKeyProcedure(ctx, from, "widget.stats.catalog", map[string]any{"integrationId": integrationID})
+	if err != nil {
+		return err
+	}
+	catalog, _ := value.(map[string]any)
+	metrics, _ := catalog["metrics"].([]any)
+	supported := false
+	for _, raw := range metrics {
+		metric, _ := raw.(map[string]any)
+		if stringField(metric, "key") == "messages" && stringField(metric, "unit") == "count" {
+			supported = true
+		}
+	}
+	if !supported {
+		return errors.New("Homarr does not expose Nextcloud's notification-count statistic; use supported Homarr 2.4.1 and retry Setup")
+	}
+	started := from.Now().UnixMilli()
+	value, err = apiKeyWrite(ctx, from, "widget.stats.refresh", map[string]any{"integrationId": integrationID, "force": true})
+	if err != nil {
+		return err
+	}
+	snapshot, ok := value.(map[string]any)
+	if !ok || snapshot["error"] != false || snapshot["stale"] != false {
+		return errors.New("Homarr could not refresh Nextcloud notification statistics; retry self-host setup homarr")
+	}
+	updated, ok := snapshot["updatedAt"].(float64)
+	if !ok || updated <= 0 || updated < float64(started) {
+		return errors.New("Homarr did not return newly refreshed Nextcloud statistics; retry self-host setup homarr")
+	}
+	values, _ := snapshot["values"].(map[string]any)
+	count, ok := values["messages"].(float64)
+	if !ok || count < 0 || count != float64(int64(count)) {
+		return errors.New("Homarr returned incomplete Nextcloud notification statistics")
+	}
+	return nil
+}
diff --git a/internal/apps/homarr/target_nzbget.go b/internal/apps/homarr/target_nzbget.go
new file mode 100644
index 0000000000000000000000000000000000000000..9e625518741b4a30ab0fb0a5e7d95e3b8df7791e
--- /dev/null
+++ b/internal/apps/homarr/target_nzbget.go
@@ -0,0 +1,136 @@
+package homarr
+
+import (
+	"context"
+	"errors"
+	"math"
+	"slices"
+
+	"github.com/ajnart/self-host/internal/apps/nzbget"
+	"github.com/ajnart/self-host/internal/helpers"
+)
+
+func nzbgetTarget() target {
+	return target{
+		id: "nzbget", name: "NZBGet", kind: "nzbGet", internal: fixed("http://nzbget:6789"),
+		secrets: func(_, to *helpers.H) []secret {
+			return []secret{
+				{Kind: "username", Value: to.Secret(to.Key("homarr_username"))},
+				{Kind: "password", Value: to.Secret(to.Key("homarr_password"))},
+			}
+		},
+		widgets: []widget{{kind: "downloads", options: map[string]any{
+			"columns":             []string{"name", "progress", "downSpeed", "time", "state"},
+			"showCompletedUsenet": true, "limitPerIntegration": 50,
+		}}, statWidget("download", "paused")},
+		preflight: func(_ context.Context, from, _ *helpers.H) error {
+			from.Info("NZBGet native activation is blocked by #354: Homarr 2.4.1 can log a credential-bearing RPC Address after a rejected request. Keep this Link inactive until supported HTTP Basic transport or complete downstream redaction is resolved, the exact Homarr version/source contract is reviewed, and activation is authorized; then retry self-host setup homarr. Standalone NZBGet Setup and owned Link removal remain separate.")
+			return helpers.ErrManual
+		},
+		verify: verifyNZBGet,
+	}
+}
+
+func verifyNZBGet(ctx context.Context, from, to *helpers.H, integrationID string) error {
+	if err := verifyNZBGetIdentity(ctx, from, integrationID); err != nil {
+		return err
+	}
+	if err := nzbget.VerifyHomarr(ctx, to); err != nil {
+		return err
+	}
+	value, err := apiKeyProcedure(ctx, from, "widget.downloads.getJobsAndStatuses", map[string]any{
+		"integrationIds": []string{integrationID}, "limitPerIntegration": 50,
+	})
+	if err != nil {
+		return errors.New("Homarr could not read NZBGet Downloads; run self-host setup nzbget, then self-host setup homarr")
+	}
+	results, ok := value.([]any)
+	if !ok || len(results) != 1 {
+		return errors.New("Homarr did not return the NZBGet download queue; retry self-host setup homarr")
+	}
+	result, _ := results[0].(map[string]any)
+	integration, _ := result["integration"].(map[string]any)
+	data, _ := result["data"].(map[string]any)
+	if result["error"] != nil || stringField(result, "integrationId") != integrationID || stringField(integration, "id") != integrationID || stringField(integration, "kind") != "nzbGet" || data == nil {
+		return errors.New("Homarr could not read the authenticated NZBGet queue; retry self-host setup homarr")
+	}
+	status, _ := data["status"].(map[string]any)
+	rates, _ := status["rates"].(map[string]any)
+	rate, ok := rates["down"].(float64)
+	if !ok || rate < 0 || math.IsNaN(rate) || math.IsInf(rate, 0) {
+		return errors.New("Homarr did not return the NZBGet download rate; retry self-host setup homarr")
+	}
+	if _, ok := status["paused"].(bool); !ok {
+		return errors.New("Homarr did not return the NZBGet queue state; retry self-host setup homarr")
+	}
+	types, ok := status["types"].([]any)
+	if !ok || !slices.Contains(types, any("usenet")) {
+		return errors.New("Homarr did not identify the NZBGet Usenet queue; retry self-host setup homarr")
+	}
+	items, ok := data["items"].([]any)
+	if !ok || len(items) > 50 {
+		return errors.New("Homarr did not return the bounded NZBGet download list; retry self-host setup homarr")
+	}
+	for _, raw := range items {
+		item, _ := raw.(map[string]any)
+		progress, ok := item["progress"].(float64)
+		if stringField(item, "id") == "" || stringField(item, "name") == "" || stringField(item, "type") != "usenet" || !slices.Contains([]string{"downloading", "queued", "paused", "completed", "failed", "processing"}, stringField(item, "state")) || !ok || progress < 0 || progress > 1 || math.IsNaN(progress) || math.IsInf(progress, 0) {
+			return errors.New("Homarr returned incomplete NZBGet download data; retry self-host setup homarr")
+		}
+		for _, key := range []string{"size", "index", "time"} {
+			value, ok := item[key].(float64)
+			if !ok || math.IsNaN(value) || math.IsInf(value, 0) || key == "size" && value < 0 {
+				return errors.New("Homarr returned incomplete NZBGet download data; retry self-host setup homarr")
+			}
+		}
+	}
+	catalog, err := apiKeyProcedure(ctx, from, "widget.stats.catalog", map[string]any{"integrationId": integrationID})
+	if err != nil {
+		return errors.New("Homarr could not read the NZBGet Stats catalog; retry self-host setup homarr")
+	}
+	statistics, _ := catalog.(map[string]any)
+	metrics, _ := statistics["metrics"].([]any)
+	for _, key := range []string{"download", "paused"} {
+		found := false
+		for _, raw := range metrics {
+			metric, _ := raw.(map[string]any)
+			if stringField(metric, "key") == key {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return errors.New("Homarr does not expose the required NZBGet Stats fields; use Homarr 2.4.1, then retry Setup")
+		}
+	}
+	return nil
+}
+
+func verifyNZBGetIdentity(ctx context.Context, from *helpers.H, integrationID string) error {
+	if integrationID == "" {
+		from.Info("Homarr's NZBGet Link has no saved integration identifier; review its owned record before retrying self-host setup homarr. No integration was adopted or changed.")
+		return helpers.ErrManual
+	}
+	value, err := apiKeyProcedure(ctx, from, "integration.byId", map[string]any{"id": integrationID})
+	if err != nil {
+		return errors.New("Homarr could not read the saved NZBGet credential metadata; review its owned integration and retry self-host setup homarr")
+	}
+	integration, _ := value.(map[string]any)
+	credentials, ok := integration["secrets"].([]any)
+	valid := ok && len(credentials) == 2 && stringField(integration, "id") == integrationID && stringField(integration, "kind") == "nzbGet" && stringField(integration, "url") == "http://nzbget:6789"
+	seen := map[string]bool{}
+	for _, raw := range credentials {
+		credential, _ := raw.(map[string]any)
+		kind := stringField(credential, "kind")
+		value, present := credential["value"]
+		if seen[kind] || !present || kind != "username" && kind != "password" || kind == "username" && value != "self-host-homarr" || kind == "password" && value != nil {
+			valid = false
+		}
+		seen[kind] = true
+	}
+	if !valid || !seen["username"] || !seen["password"] {
+		from.Info("Homarr's saved NZBGet integration must use exactly the managed restricted username and a redacted password credential. Review and explicitly repair only the owned record; do not adopt an Admin or foreign account. Then retry self-host setup homarr. No credential was changed.")
+		return helpers.ErrManual
+	}
+	return nil
+}

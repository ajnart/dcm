[2.007614, "o", "\u001b[2;68H \u001b[38;5;238m\u2500\u2500\u2500\u2500\u2500\u001b[m\u001b[3;61H\u001b[38;5;245m logs \u001b[m \u001b[38;5;230;48;5;57;1m setup \u001b[m\u001b[5;61H\u001b[38;5;42m\u2713\u001b[m \u001b[38;5;252mrender\u001b[38;5;245m  wrote apps/homarr/compose.yml (ghcr.io/homarr-l\u2026\u001b[m\u001b[6;61H\u001b[38;5;42m\u2713\u001b[m \u001b[38;5;252mpull\u001b[38;5;245m  pulled homarr\u001b[m\u001b[7;61H\u001b[38;5;42m\u2713\u001b[m \u001b[38;5;252mstart\u001b[38;5;245m  started homarr\u001b[m\u001b[8;61H\u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mready\u001b[38;5;245m  wait for homarr to answer on /api/health/live\u001b[m\u001b[9;61H\u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252madmin\u001b[38;5;245m  sign in as the administrator admin\u001b[m\u001b[10;61H\u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252monboarding\u001b[38;5;245m  finish the Homarr board setup\u001b[m\u001b[11;61H\u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mapi-key\u001b[38;5;245m  create and store a Homarr API key\u001b[m\u001b[12;61H\u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mapp-tiles\u001b[38;5;245m  reconcile installed App tiles\u001b[m\u001b[13;61H\u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mnotebook\u001b[38;5;245m  place the Homarr notebook\u001b[m\u001b[14;61H\u001b[38;5;42m\u2713\u001b[m \u001b[38;5;252mcheck\u001b[38;5;245m  verify Homarr works\u001b[m\u001b[15;61H\u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mlink-sonarr\u001b[38;5;245m  waiting for sonarr (install it, or finish \u2026\u001b[m\u001b[16;61H\u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mlink-radarr\u001b[38;5;245m  waiting for radarr (install it, or finish \u2026\u001b[m\u001b[17;61H\u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mlink-prowlarr\u001b[38;5;245m  waiting for prowlarr (install it, or fin\u2026\u001b[m\u001b[18;61H\u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mlink-jellyfin\u001b[38;5;245m  add Jellyfin to Homarr\u001b[m\u001b[19;61H\u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mlink-se
[15.857357, "o", "\u001b[38;5;245m  waiting for radarr (install it, or finish \u2026\u001b[m \u001b[38;5;238m\u2502\u001b[m\r\n\u001b[K\u001b[38;5;238m\u2502\u001b[m                                                        \u001b[38;5;238m\u2502\u2502\u001b[m \u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mlink-prowlarr\u001b[38;5;245m  waiting for prowlarr (install it, or fin\u2026\u001b[m \u001b[38;5;238m\u2502\u001b[m\r\n\u001b[K\u001b[38;5;238m\u2502\u001b[m                                                        \u001b[38;5;238m\u2502\u2502\u001b[m \u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mlink-jellyfin\u001b[38;5;245m  add Jellyfin to Homarr\u001b[m                    \u001b[38;5;238m\u2502\u001b[m\r\n\u001b[K\u001b[38;5;238m\u2502\u001b[m                                                        \u001b[38;5;238m\u2502\u2502\u001b[m \u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mlink-seerr\u001b[38;5;245m  waiting for seerr (install it, or finish it\u2026\u001b[m \u001b[38;5;238m\u2502\u001b[m\r\n\u001b[K\u001b[38;5;238m\u2502\u001b[m                                                        \u001b[38;5;238m\u2502\u2502\u001b[m \u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mlink-qbittorrent\u001b[38;5;245m  waiting for qbittorrent (install it, \u2026\u001b[m \u001b[38;5;238m\u2502\u001b[m\r\n\u001b[K\u001b[38;5;238m\u2502\u001b[m                                                        \u001b[38;5;238m\u2502\u2502\u001b[m \u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mlink-ntfy\u001b[38;5;245m  add ntfy to Homarr\u001b[m                            \u001b[38;5;238m\u2502\u001b[m\r\n\u001b[K\u001b[38;5;238m\u2502\u001b[m                                                        \u001b[38;5;238m\u2502\u2502\u001b[m \u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mlink-vaultwarden\u001b[38;5;245m  waiting for vaultwarden (install it, \u2026\u001b[m \u001b[38;5;238m\u2502\u001b[m\r\n\u001b[3G\u001b[55X\u001b[23;58H\u001b[38;5;238m\u2502\u2502\u001b[m\u001b[60X\u001b[60C\u001b[
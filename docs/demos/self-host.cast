502\u001b[m \u001b[38;5;245m  \u2192 To reach Apps from other devices run: self-host c\u2026\u001b[m \u001b[38;5;238m\u2502\u2502\u001b[m \u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252madmin\u001b[38;5;245m  sign in as the administrator admin\u001b[m                \u001b[38;5;238m\u2502\u001b[m\r\n\u001b[K\u001b[38;5;238m\u2502\u001b[m                                                        \u001b[38;5;238m\u2502\u2502\u001b[m \u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252monboarding\u001b[38;5;245m  finish the Homarr board setup\u001b[m                \u001b[38;5;238m\u2502\u001b[m\r\n\u001b[K\u001b[38;5;238m\u2502\u001b[m                                                        \u001b[38;5;238m\u2502\u2502\u001b[m \u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mapi-key\u001b[38;5;245m  create and store a Homarr API key\u001b[m               \u001b[38;5;238m\u2502\u001b[m\r\n\u001b[K\u001b[38;5;238m\u2502\u001b[m                                                        \u001b[38;5;238m\u2502\u2502\u001b[m \u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mapp-tiles\u001b[38;5;245m  reconcile installed App tiles\u001b[m                 \u001b[38;5;238m\u2502\u001b[m\r\n\u001b[K\u001b[38;5;238m\u2502\u001b[m                                                        \u001b[38;5;238m\u2502\u2502\u001b[m \u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mnotebook\u001b[38;5;245m  place the Homarr notebook\u001b[m                      \u001b[38;5;238m\u2502\u001b[m\r\n\u001b[K\u001b[38;5;238m\u2502\u001b[m                                                        \u001b[38;5;238m\u2502\u2502\u001b[m \u001b[38;5;42m\u2713\u001b[m \u001b[38;5;252mcheck\u001b[38;5;245m  verify Homarr works\u001b[m                               \u001b[38;5;238m\u2502\u001b[m\r\n\u001b[K\u001b[38;5;238m\u2502\u001b[m                                                        \u001b[38;5;238m\u2502\u2502\u001b[m \u001b[38;5;245m\u21b7\u001b[m \u001b[38;5;252mlink-sonarr\u001b[38;5;245m  waiting for sonarr (install i
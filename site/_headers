/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self'; media-src 'self'; manifest-src 'self'; style-src 'self'; img-src 'self' https://cdn.jsdelivr.net; base-uri 'none'; frame-ancestors 'none'; form-action 'none'

/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

/install.sh.sha256
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

/catalog.json
  Access-Control-Allow-Origin: *
  Cache-Control: max-age=3600

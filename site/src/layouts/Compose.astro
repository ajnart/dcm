---
import { SPECULATION_RULES } from "../lib/speculation.mjs";
import "@/styles/global.css";
import "../styles/shared.css";
import "../styles/transitions.css";
import { buttonVariants } from "@/components/ui/button";
import { routes } from "@/lib/routes";
import { PlusCircle } from "lucide-react";
import og from "../assets/og.png";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { VERSION } from "../lib/site";

interface Props {
  title: string;
  description: string;
  jsonld?: Record<string, unknown>;
  editor?: boolean;
}

const { title, description, jsonld, editor = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ""), Astro.site);
const image = new URL(og.src, Astro.site);

type CspDirective = Parameters<NonNullable<typeof Astro.csp>["insertDirective"]>[0];
const insertDirective = (directive: string) => Astro.csp?.insertDirective(directive as CspDirective);

insertDirective("style-src-attr 'unsafe-inline'");
if (editor) {
  insertDirective("style-src-elem 'self' 'unsafe-inline'");
  insertDirective("font-src 'self'");
  insertDirective("worker-src 'self'");
}
---

<!doctype html>
<html lang="en" class="dark" data-version={VERSION}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e1d2a" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="self-host" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <script is:inline type="speculationrules" set:html={SPECULATION_RULES} />
    {jsonld && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <script>
      import "../scripts/legacy-mode";
      import "../scripts/analytics";
      import "../scripts/compose-analytics";
    </script>
  </head>
  <body>
    <SiteHeader>
      <a href={routes.suggest} class={buttonVariants({ variant: "outline", size: "sm" })} aria-label="Suggest container">
        <PlusCircle size={16} />
        <span class="max-sm:sr-only">Suggest container</span>
      </a>
    </SiteHeader>
    <main class="container pt-6 pb-12">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

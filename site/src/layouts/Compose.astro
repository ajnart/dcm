---
import { SPECULATION_RULES } from "../lib/speculation.mjs";
import "@/styles/global.css";
import "../styles/shared.css";
import "../styles/transitions.css";
import { buttonVariants } from "@/components/ui/button";
import { routes } from "@/lib/routes";
import { PlusCircle } from "lucide-react";
import SeoHead from "../components/SeoHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { VERSION } from "../lib/site";

interface Props {
  title: string;
  description: string;
  jsonld?: Record<string, unknown>;
}

const { title, description, jsonld } = Astro.props;

---

<!doctype html>
<html lang="en" class="dark" data-version={VERSION}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={title} description={description} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <script is:inline type="speculationrules" set:html={SPECULATION_RULES} />
    {jsonld && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <script>
      import "../scripts/legacy-mode";
      import "../scripts/analytics";
      import "../scripts/compose-analytics";
    </script>
  </head>
  <body>
    <SiteHeader>
      <a href={routes.suggest} class={buttonVariants({ variant: "outline", size: "sm" })} aria-label="Suggest container">
        <PlusCircle size={16} />
        <span class="max-sm:sr-only">Suggest container</span>
      </a>
    </SiteHeader>
    <main class="container pt-6 pb-12">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

---
import { SPECULATION_RULES } from "../lib/speculation.mjs";
import "../styles/theme.css";
import "../styles/shared.css";
import "../styles/site.css";
import "../styles/transitions.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SeoHead from "../components/SeoHead.astro";
import { VERSION } from "../lib/site";

interface Props {
  title: string;
  description: string;
  video?: boolean;
  jsonld?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description, video = false, jsonld, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-version={VERSION}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={title} description={description} video={video} noindex={noindex} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <script is:inline type="speculationrules" set:html={SPECULATION_RULES} />
    {jsonld && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <script>
      import "../scripts/analytics";
    </script>
  </head>
  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
  </body>
</html>

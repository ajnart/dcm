---
import ExtLinks from "./ExtLinks.astro";
import PageLinks from "./PageLinks.astro";
import "../styles/header.css";

interface Props {
  as?: "header" | "div";
}

const Tag = Astro.props.as ?? "header";
---

<Tag class="site-header">
  <a class="tag" href="/" aria-label="self-host home">◆ self-host</a>
  <PageLinks />
  <div class="site-header-tools"><slot /></div>
  <ExtLinks />
</Tag>

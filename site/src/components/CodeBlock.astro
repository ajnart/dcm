---
import { highlightLines } from "../lib/codeblock.mjs";

type Variant = { label: string; code: string; lang?: string };

interface Props {
  code?: string;
  lang?: string;
  label?: string;
  id?: string;
  variants?: Variant[];
}

const { code = "", lang = "bash", label, id } = Astro.props;
const variants = Astro.props.variants ?? [{ label: label ?? lang, code }];
---

<figure class="codeblock" id={id}>
  <figcaption>
    {
      variants.length > 1 ? (
        <select class="variant" aria-label={label ?? "Variant"}>
          {variants.map((v, i) => (
            <option value={i}>{v.label}</option>
          ))}
        </select>
      ) : (
        <span>{variants[0].label}</span>
      )
    }
    <button class="copybtn" type="button" data-copy={variants[0].code}>copy</button>
  </figcaption>
  {variants.map((v, i) => {
    const l = v.lang ?? lang;
    return <pre class={`language-${l}`} data-code={v.code} hidden={i > 0}><code class={`language-${l}`} set:html={highlightLines(v.code, l)} /></pre>;
  })}
</figure>

<script>
  import "../scripts/codeblock.js";
</script>

---
import DockerToolsClient from "@/components/DockerToolsClient";
import { routes } from "@/lib/routes";
import { buildCatalog } from "@/lib/catalog";
import { withStars } from "@/lib/stars";
import { tools } from "@/tools";
import { getCollection } from "astro:content";
import Compose from "../../layouts/Compose.astro";
import { linkCount } from "../../lib/catalog";
import { breadcrumbs, schema } from "../../lib/meta";

const count = (await getCollection("apps")).length;
const catalog = withStars(buildCatalog(tools));
const jsonld = schema(breadcrumbs(["self-host", "/"], ["Apps", routes.apps]));
---

<Compose
  editor
  title={`${count} self-hosted Apps · self-host`}
  description={`Every App self-host installs, signs in and wires together: ${count} Apps and ${linkCount} Links, each one command away.`}
  jsonld={jsonld}
>
  <DockerToolsClient client:load catalog={catalog} mode="self-host" />
</Compose>

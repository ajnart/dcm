---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import AppIcon from "../../components/AppIcon.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Base from "../../layouts/Base.astro";
import { appById, linksInto, recipesWith } from "../../lib/catalog";

export const getStaticPaths = (async () => (await getCollection("apps")).map((app) => ({ params: { id: app.id }, props: { app } }))) satisfies GetStaticPaths;

const { app } = Astro.props;
const { name, description, category, image, port, icon, links } = app.data;
const into = linksInto(app.id);
const recipes = recipesWith(app.id);
const nameOf = (id: string) => appById.get(id)?.name ?? id;
const jsonld = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "self-host", item: "https://self-host.fyi/" },
    { "@type": "ListItem", position: 2, name: "Apps", item: "https://self-host.fyi/apps" },
    { "@type": "ListItem", position: 3, name, item: `https://self-host.fyi/apps/${app.id}` },
  ],
};
---

<Base title={`${name}: self-host it in one command · self-host`} description={`${description}. Install ${name} with one command; self-host signs it in and wires it to ${links.length + into.length} other Apps.`} jsonld={jsonld}>
  <main class="page apppage">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">self-host</a> / <a href="/apps">apps</a> / <span>{app.id}</span></nav>
    <header class="apphead">
      <AppIcon name={name} icon={icon} size={44} id={`app-${app.id}`} />
      <div>
        <h1>{name}</h1>
        <p class="lede">{description}.</p>
      </div>
    </header>

    <dl class="facts">
      <dt>group</dt><dd>{category}</dd>
      <dt>port</dt><dd>{port || "none, it has no web page"}</dd>
      <dt>image</dt><dd><code>{image}</code></dd>
      {recipes.length > 0 && (<><dt>recipe</dt><dd>{recipes.map((r) => r.id).join(", ")}</dd></>)}
    </dl>

    <CodeBlock lang="bash" label="install" code={`self-host install ${app.id}`} track="app" trackId={app.id} />
    <p class="aside"><a class="btn primary" href={`/?apps=${app.id}#play`}>▶ try it in the playground</a></p>

    {
      (links.length > 0 || into.length > 0) && (
        <section aria-labelledby="links-title">
          <h2 id="links-title">Links</h2>
          <p class="muted">Install these together and self-host connects them for you.</p>
          <ul class="linklist">
            {links.map((l) => (
              <li><span class="accent">⇄</span> <a href={`/apps/${l.to}`}>{nameOf(l.to)}</a> <span class="muted">{l.title}</span></li>
            ))}
            {into.map((l) => (
              <li><span class="accent">⇄</span> <a href={`/apps/${l.from}`}>{nameOf(l.from)}</a> <span class="muted">{l.title}</span></li>
            ))}
          </ul>
        </section>
      )
    }

    {
      recipes.map((r) => (
        <section aria-label={`Recipe ${r.name}`}>
          <h2>In the <code>{r.id}</code> Recipe</h2>
          <p class="muted">{r.description}.</p>
          <CodeBlock lang="bash" label={r.name} code={`self-host install ${r.id}`} track="recipe" trackId={r.id} />
        </section>
      ))
    }
  </main>
</Base>

---
import TemplateClient from "@/components/TemplateClient"
import { allTemplates, buildCatalog } from "@/lib/catalog"
import { routes } from "@/lib/routes"
import { withStars } from "@/lib/stars"
import { getToolsFromTemplate, templates } from "@/lib/templates"
import { tools } from "@/tools"
import Compose from "../../../layouts/Compose.astro"
import { breadcrumbs, DESCRIPTION_MAX, fit, schema } from "../../../lib/meta"

export async function getStaticPaths() {
  const catalog = withStars(buildCatalog(tools))
  return allTemplates(catalog, templates).map((template) => ({
    params: { id: template.id },
    props: { template, entries: catalog.entries },
  }))
}

const { template, entries } = Astro.props
const templateEntries = getToolsFromTemplate(template, entries)
const pitch = template.description.replace(/\.$/, "")
const description = fit(
  DESCRIPTION_MAX,
  `${pitch}. A Docker Compose stack of ${templateEntries.length} apps you can edit, download or install with self-host.`,
  `${pitch}. A ready-made Docker Compose stack.`,
  `${pitch}.`,
)
const jsonld = schema(
  breadcrumbs(["self-host", "/"], ["Docker Compose Maker", routes.compose], ["Templates", routes.templates], [template.name, routes.template(template.id)]),
)
---

<Compose
  title={`${template.name} · Docker Compose Maker`}
  description={description}
  jsonld={jsonld}
>
  <TemplateClient
    client:load
    template={template}
    templateEntries={templateEntries}
  />
</Compose>

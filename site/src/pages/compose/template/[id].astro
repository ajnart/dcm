---
import TemplateClient from "@/components/TemplateClient"
import { allTemplates, buildCatalog } from "@/lib/catalog"
import { withStars } from "@/lib/stars"
import { getToolsFromTemplate, templates } from "@/lib/templates"
import { tools } from "@/tools"
import Compose from "../../../layouts/Compose.astro"

export async function getStaticPaths() {
  const catalog = withStars(buildCatalog(tools))
  const counts = {
    "self-host": allTemplates(catalog, templates, "self-host").length,
    all: allTemplates(catalog, templates, "all").length,
  }
  return [...catalog.recipes, ...templates].map((template) => ({
    params: { id: template.id },
    props: { template, entries: catalog.entries, counts },
  }))
}

const { template, entries, counts } = Astro.props
const templateEntries = getToolsFromTemplate(template, entries)
---

<Compose
  title={`${template.name} · Docker Compose Maker`}
  description={template.description}
>
  <TemplateClient
    client:load
    template={template}
    templateEntries={templateEntries}
    counts={counts}
  />
</Compose>

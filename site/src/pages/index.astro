---
import Base from "../layouts/Base.astro";
import CodeBlock from "../components/CodeBlock.astro";
import HeroLogo from "../components/HeroLogo.astro";
import SectionHead from "../components/SectionHead.astro";
import { apps, linkCount, linkingApps } from "../lib/catalog";
import { AGENT_PROMPT, INSTALL, LINKS, VERSION } from "../lib/site";

const AGENT_RUNS = `self-host skill
self-host status --json
self-host install media --yes --json
self-host debug sonarr`;
const description = `One Go binary that installs, signs in and wires together ${apps.length} self-hosted Apps with Docker Compose. Try it in your browser.`;
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "self-host",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Linux, macOS, Windows (WSL)",
      softwareVersion: VERSION,
      description,
      url: "https://self-host.fyi/",
      downloadUrl: LINKS.releases,
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    },
    {
      "@type": "VideoObject",
      name: "self-host in 34 seconds",
      description,
      thumbnailUrl: "https://self-host.fyi/reel.jpg",
      contentUrl: "https://self-host.fyi/reel.mp4",
      uploadDate: "2026-10-13",
      duration: "PT34S",
    },
  ],
};
---

<Base title="self-host · run your own Apps" description={description} video jsonld={jsonld}>

      <main>
        <section class="hero">
          <div>
            <p class="eyebrow">// one Go binary · docker compose · {apps.length} Apps</p>
            <h1>Your Apps.<br>Your home.<br><span class="pink">One binary.</span></h1>
            <p class="lede">Installs self-hosted Apps, signs them in, and wires them to each other. A terminal Dashboard for you, <code>--json</code> for your agent.</p>
            <div class="cta">
              <a class="btn primary" href="#play">▶ try it</a>
              <a class="btn" href="#reel">watch · 34 s</a>
              <a class="btn" href="#apps">apps</a>
            </div>
          </div>
          <HeroLogo />
        </section>

        <section id="reel" class="reel" aria-label="Showreel">
          <video controls preload="none" playsinline poster="/reel.jpg" width="1920" height="1080">
            <source src="/reel.mp4" type="video/mp4">
            <a href="/reel.mp4">Watch the 34-second showreel</a>
          </video>
        </section>

        <section id="play" class="play" aria-labelledby="play-title">
          <SectionHead id="play" num="01" title="Play">A simulation in your browser. Real catalog, nothing installed. <kbd>self-host</kbd> opens the Dashboard.</SectionHead>
          <div class="term" id="term">
            <div class="term-bar">
              <span class="dots"><i></i><i></i><i></i></span>
              <span class="term-title" id="term-title">you@home: ~</span>
              <button class="reset" id="reset" type="button">reset</button>
            </div>
            <div class="screen" id="screen" tabindex="-1">
              <div class="shell" id="shell">
                <div id="out" aria-live="polite"></div>
                <label class="prompt" id="prompt">
                  <span class="ps"><span class="green">you@home</span> <span class="cyan">~</span> $</span>
                  <input id="cmd" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Command">
                </label>
              </div>
              <div class="tui" id="tui" hidden></div>
            </div>
            <div class="keys" id="keys" hidden>
              <button type="button" data-key="Tab">tab</button>
              <button type="button" data-key="ArrowUp">↑</button>
              <button type="button" data-key="ArrowDown">↓</button>
              <button type="button" data-key=" ">space</button>
              <button type="button" data-key="Enter">enter</button>
              <button type="button" data-key="i">i</button>
              <button type="button" data-key="y">y</button>
              <button type="button" data-key="Escape">esc</button>
              <button type="button" data-key="q">q</button>
            </div>
          </div>
          <div class="chips" id="chips" aria-label="Try a command">
            <button type="button" class="demo" id="demo">▶ autoplay</button>
            <span class="muted">or try →</span>
            <button type="button" data-cmd="self-host install media">self-host install media</button>
            <button type="button" data-cmd="self-host">self-host</button>
            <button type="button" data-cmd="self-host status">self-host status</button>
            <button type="button" data-cmd="self-host doctor">self-host doctor</button>
            <button type="button" data-cmd="help">help</button>
          </div>
        </section>

        <section id="apps" aria-labelledby="apps-title">
          <SectionHead id="apps" num="02" title="Apps">{apps.length} Apps. Pick some, then install them in the playground or share the link.</SectionHead>
          <div class="selbar" id="selbar">
            <div class="sel-info">
              <span id="selcount">0 Apps selected</span>
              <div class="stack" id="stack"></div>
            </div>
            <div class="sel-actions">
              <button class="btn" id="open-palette" type="button">search <kbd id="mod">⌘K</kbd></button>
              <button class="btn" id="share" type="button" disabled>share</button>
              <button class="btn" id="unselect" type="button" disabled>unselect</button>
              <button class="btn primary" id="install-sel" type="button" disabled>▶ install</button>
            </div>
            <code class="sel-cmd" id="selcmd">self-host install …</code>
            <div class="wires" id="wires" hidden></div>
          </div>
          <input id="q" class="filter" type="search" placeholder="/ filter apps" aria-label="Filter Apps" autocomplete="off" spellcheck="false">
          <div class="apps" id="catalog"></div>
          <p class="more-row"><button class="btn more" id="more" type="button">show all {apps.length} apps ↓</button> <a class="btn" href="/apps">browse every App →</a></p>
        </section>

        <section id="links" aria-labelledby="links-title">
          <SectionHead id="links" num="03" title="Links">Install two Apps that know each other and they get connected: download clients, indexers, requests, dashboard tiles. {linkCount} Links across {linkingApps} Apps.</SectionHead>
          <div class="linkcards" id="linkcards"></div>
        </section>

        <section id="how" aria-labelledby="how-title">
          <SectionHead id="how" num="04" title="How">Nothing changes until you say yes.</SectionHead>
          <ol class="steps">
            <li><b>inspect</b><span>Docker, ports, folders, LAN.</span></li>
            <li><b>plan</b><span>Apps, ports, folders.</span></li>
            <li><b>approve</b><span>You say yes.</span></li>
            <li><b>apply</b><span>One Compose Project in <code>~/.self-host</code>.</span></li>
            <li><b>verify</b><span>Sign in, API keys, Links, check.</span></li>
          </ol>
        </section>

        <section id="agents" aria-labelledby="agents-title">
          <SectionHead id="agents" num="05" title="Agents">The binary ships its own agent guide. One sentence is enough.</SectionHead>
          <div class="split">
            <CodeBlock lang="text" label="you, to Claude Code / Codex / OpenCode" code={AGENT_PROMPT} id="prompt-block" />
    <CodeBlock lang="bash" label="what the agent runs" code={AGENT_RUNS} />
          </div>
        </section>

        <section id="install" aria-labelledby="install-title">
          <SectionHead id="install" num="06" title="Install">Linux, macOS, WSL. Needs Docker with Compose v2.</SectionHead>
          <CodeBlock lang="bash" label="install" code={INSTALL} id="oneliner" />
          <p class="aside">Read it first: <a href="/install">installer</a> · <a href="/install.sh.sha256">sha256</a> · <a href={LINKS.releases}>releases</a></p>
          <p class="aside">Want the YAML instead? <a href={LINKS.dcm}>DCM</a> builds a <code>docker-compose.yaml</code> for you to run yourself.</p>
        </section>

        <section id="support" aria-labelledby="support-title">
          <SectionHead id="support" num="07" title="Support">Free and open source. Built by one person.</SectionHead>
          <div class="links">
            <a class="btn primary" href={LINKS.sponsor}>♥ sponsor on GitHub</a>
            <a class="btn" href={LINKS.kofi}>☕ Ko-fi</a>
            <a class="btn" href={LINKS.github}>★ GitHub</a>
            <a class="btn" href={LINKS.discord}>💬 Discord</a>
            <a class="btn" href={LINKS.issues}>report a bug</a>
          </div>
        </section>
      </main>

      <dialog class="palette" id="palette" aria-label="Search Apps and actions">
        <div class="phead">
          <span class="pink">›</span>
          <input id="pq" placeholder="search apps and actions" autocomplete="off" spellcheck="false" aria-label="Search">
          <span class="pcount" id="pcount"></span>
        </div>
        <div class="plist" id="plist" role="listbox" aria-multiselectable="true"></div>
        <div class="phint" id="phint"></div>
      </dialog>
      <div class="toast" id="toast" role="status" hidden></div>

</Base>

<script>
  import "../scripts/main.js";
</script>

{
  "schemaVersion": 2,
  "kind": "multi-service-compose",
  "appId": "sonarr",
  "source": "https://docs.linuxserver.io/images/docker-sonarr/",
  "services": [
    {
      "id": "sonarr",
      "purpose": "Manages television-series monitoring and library imports; it does not select releases or indexers.",
      "imageTag": "lscr.io/linuxserver/sonarr:version-4.0.19.2979",
      "imageSource": "https://github.com/linuxserver/docker-sonarr/pkgs/container/sonarr/versions",
      "user": "image-default",
      "imageUserEvidence": {
        "officialUrl": "https://docs.linuxserver.io/images/docker-sonarr/",
        "reason": "official-image-runtime-contract"
      },
      "restart": "unless-stopped",
      "readOnly": false,
      "environment": [],
      "hostEnvironment": [
        { "name": "PUID", "source": "uid" },
        { "name": "PGID", "source": "gid" },
        { "name": "TZ", "source": "timezone" }
      ],
      "fileEnvironment": [],
      "mounts": [
        { "name": "config", "target": "/config", "kind": "volume" },
        { "name": "media-data", "target": "/data", "kind": "bind", "hostPath": true, "readOnly": false, "shareGroup": "media-data" }
      ],
      "dependsOn": [],
      "publishTargetPort": 8989
    }
  ],
  "privateFiles": [
    { "id": "admin-password", "bytes": 48, "format": "alphanumeric" }
  ],
  "onboarding": {
    "kind": "manual-first-admin",
    "officialUrl": "https://wiki.servarr.com/sonarr/settings/general#security",
    "username": "admin",
    "fileId": "admin-password"
  },
  "defaults": {
    "hostIp": "127.0.0.1",
    "publishedPort": 8989,
    "dataDirectoryName": "sonarr"
  },
  "storage": {
    "filesystem": "local-posix-locks",
    "minimumFreeBytes": 1073741824
  },
  "acceptance": [
    { "id": "api-auth-policy", "method": "api", "description": "Read back required Forms authentication and verify the generated administrator password through the pinned private login route." },
    { "id": "library-and-download-paths", "method": "browser", "description": "Configure and verify the television root folder and downloader paths against the selected shared /data mount before importing media." },
    { "id": "restart-persistence", "method": "persisted", "description": "Restart this exact project and independently verify administrator login, library paths, and any configured downloader connection." }
  ]
}
